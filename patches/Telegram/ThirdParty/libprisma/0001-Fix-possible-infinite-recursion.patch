From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: John Preston <johnprestonmail@gmail.com>
Date: Tue, 29 Sep 2026 16:26:33 +0400
Subject: [PATCH] Fix possible infinite recursion.

---
 libprisma/SyntaxHighlighter.cpp | 15 +++++++++++++++
 libprisma/SyntaxHighlighter.h   |  1 +
 2 files changed, 16 insertions(+)

diff --git a/libprisma/SyntaxHighlighter.cpp b/libprisma/SyntaxHighlighter.cpp
index b79fde18dab812573c50878df2ea388bd9a9c1b5..69c158bdf7cf6b50678e7fbccd7e448bd352f826 100644
--- a/libprisma/SyntaxHighlighter.cpp
+++ b/libprisma/SyntaxHighlighter.cpp
@@ -26,6 +26,21 @@ std::map<std::string, std::string> SyntaxHighlighter::languages() const
 
 TokenList SyntaxHighlighter::tokenize(std::string_view text, const Grammar* grammar)
 {
+    // Grammars may include themselves through "inside" (for example
+    // brightscript directive-statement -> expression -> brightscript),
+    // which can recurse on the same text forever and overflow the stack.
+    constexpr auto kMaxDepth = 32;
+    if (m_depth >= kMaxDepth)
+    {
+        return TokenList(text);
+    }
+    struct DepthGuard
+    {
+        int& depth;
+        DepthGuard(int& depth) : depth(++depth) {}
+        ~DepthGuard() { --depth; }
+    } guard(m_depth);
+
     TokenList tokenList(text);
     try {
         matchGrammar(text, tokenList, grammar, tokenList.head, 0, nullptr);
diff --git a/libprisma/SyntaxHighlighter.h b/libprisma/SyntaxHighlighter.h
index 2510d4cd669eefbe51dd9be08000f41f5c6a7c2c..a4c981f88be180b3a68f522e8da1fe645a95a47e 100644
--- a/libprisma/SyntaxHighlighter.h
+++ b/libprisma/SyntaxHighlighter.h
@@ -30,4 +30,5 @@ private:
     void matchGrammar(std::string_view text, TokenList& tokenList, const Grammar* grammar, TokenListPtr startNode, size_t startPos, RematchOptions* rematch);
 
     std::shared_ptr<LanguageTree> m_tree;
+    int m_depth = 0;
 };
\ No newline at end of file
