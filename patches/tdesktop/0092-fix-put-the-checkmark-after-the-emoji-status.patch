From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: nitreojs <hello@starkow.dev>
Date: Sun, 27 Sep 2026 22:30:21 +0300
Subject: [PATCH] fix: put the checkmark after the emoji status

---
 .../history/view/history_view_message.cpp     | 27 +++++-
 .../info/profile/info_profile_badge.cpp       |  5 +-
 .../SourceFiles/tele/tele_bubble_badges.cpp   | 94 ++++++-------------
 .../SourceFiles/tele/tele_bubble_badges.h     |  2 +
 4 files changed, 59 insertions(+), 69 deletions(-)

diff --git a/Telegram/SourceFiles/history/view/history_view_message.cpp b/Telegram/SourceFiles/history/view/history_view_message.cpp
index 868c8c57e38207fc658c0cf49a31ba56bbdf4126..6906f5ae46e83440da29370934d7911f98757439 100644
--- a/Telegram/SourceFiles/history/view/history_view_message.cpp
+++ b/Telegram/SourceFiles/history/view/history_view_message.cpp
@@ -1532,6 +1532,7 @@ QSize Message::performCountOptimalSize() {
 					+ (_fromNameStatus
 						? st::dialogsPremiumIcon.icon.width()
 						: 0)
+					+ (from ? Tele::BubbleCheckWidth(_fromNameBadges) : 0)
 					+ st::msgPadding.right();
 				if (via && !displayForwardedFrom()) {
 					namew += st::msgServiceFont->spacew + via->maxWidth
@@ -2531,6 +2532,9 @@ void Message::paintFromName(
 	const auto statusWidth = _fromNameStatus
 		? st::dialogsPremiumIcon.icon.width()
 		: 0;
+	const auto checkWidth = from
+		? Tele::BubbleCheckWidth(_fromNameBadges)
+		: 0;
 	const auto via = item->Get<HistoryMessageVia>();
 	const auto viaShown = via && !displayForwardedFrom() && via->width;
 	const auto viaSkipWidth = viaShown
@@ -2539,7 +2543,7 @@ void Message::paintFromName(
 	const auto nameAvailableWidth = std::max(
 		((statusWidth && availableWidth > statusWidth)
 			? (availableWidth - statusWidth)
-			: availableWidth) - viaSkipWidth,
+			: availableWidth) - viaSkipWidth - checkWidth,
 		0);
 	if (statusWidth && availableWidth > statusWidth) {
 		const auto x = availableLeft
@@ -2578,6 +2582,17 @@ void Message::paintFromName(
 			st::dialogsPremiumIcon.icon.paint(p, x, y, width(), color);
 		}
 	}
+	if (checkWidth) {
+		Tele::PaintBubbleCheck(
+			p,
+			(availableLeft
+				+ std::min(nameAvailableWidth, nameText->maxWidth())
+				+ ((statusWidth && availableWidth > statusWidth)
+					? statusWidth
+					: 0)),
+			trect.top(),
+			nameFg);
+	}
 	p.setFont(st::msgNameFont);
 	p.setPen(nameFg);
 	const auto nameLinkHandler = fromLink();
@@ -2611,6 +2626,7 @@ void Message::paintFromName(
 			? (st::dialogsPremiumIcon.icon.width()
 				+ st::msgServiceFont->spacew)
 			: 0)
+		+ checkWidth
 		+ st::msgServiceFont->spacew;
 	availableLeft += skipWidth;
 	availableWidth -= skipWidth;
@@ -4247,6 +4263,9 @@ bool Message::getStateFromName(
 		const auto statusWidth = (from && _fromNameStatus)
 			? st::dialogsPremiumIcon.icon.width()
 			: 0;
+		const auto checkWidth = from
+			? Tele::BubbleCheckWidth(_fromNameBadges)
+			: 0;
 		const auto via = item->Get<HistoryMessageVia>();
 		const auto viaShown = via && !displayForwardedFrom() && via->width;
 		const auto viaSkipWidth = viaShown
@@ -4255,7 +4274,7 @@ bool Message::getStateFromName(
 		const auto nameAvailableWidth = std::max(
 			((statusWidth && availableWidth > statusWidth)
 				? (availableWidth - statusWidth)
-				: availableWidth) - viaSkipWidth,
+				: availableWidth) - viaSkipWidth - checkWidth,
 			0);
 		const auto nameWidth = std::min(
 			nameText->maxWidth(),
@@ -4287,6 +4306,7 @@ bool Message::getStateFromName(
 				? (st::dialogsPremiumIcon.icon.width()
 					+ st::msgServiceFont->spacew)
 				: 0)
+			+ checkWidth
 			+ st::msgServiceFont->spacew;
 		availableLeft += skipWidth;
 		availableWidth -= skipWidth;
@@ -6377,7 +6397,8 @@ void Message::fromNameUpdated(int width) const {
 		- (_fromNameStatus
 			? (st::dialogsPremiumIcon.icon.width()
 				+ st::msgServiceFont->spacew)
-			: 0);
+			: 0)
+		- (from ? Tele::BubbleCheckWidth(_fromNameBadges) : 0);
 	auto viaWidth = 0;
 	if (via && !displayForwardedFrom()) {
 		via->resize(available - st::msgServiceFont->spacew);
diff --git a/Telegram/SourceFiles/info/profile/info_profile_badge.cpp b/Telegram/SourceFiles/info/profile/info_profile_badge.cpp
index 78acde4d2b78d1c3c331598082513585d944af96..cc74c3ee0d6bdec8099a3a613af4578a24d4f395 100644
--- a/Telegram/SourceFiles/info/profile/info_profile_badge.cpp
+++ b/Telegram/SourceFiles/info/profile/info_profile_badge.cpp
@@ -282,7 +282,10 @@ rpl::producer<Badge::Content> BadgeContentForPeer(not_null<PeerData*> peer) {
 			return Badge::Content{ BadgeType::Premium, emojiStatusId };
 		}
 		if (badge == BadgeType::Verified) {
-			badge = BadgeType::None;
+			badge = (emojiStatusId
+					&& (!statusOnlyForPremium || peer->isPremium()))
+				? BadgeType::Premium
+				: BadgeType::None;
 		}
 		if (statusOnlyForPremium && badge != BadgeType::Premium) {
 			emojiStatusId = EmojiStatusId();
diff --git a/Telegram/SourceFiles/tele/tele_bubble_badges.cpp b/Telegram/SourceFiles/tele/tele_bubble_badges.cpp
index 6a3d88e54b777caad49b40e099f7b2041b4d137f..e89de87be5eedecc5b5606d5aae30d6de115ac2c 100644
--- a/Telegram/SourceFiles/tele/tele_bubble_badges.cpp
+++ b/Telegram/SourceFiles/tele/tele_bubble_badges.cpp
@@ -18,80 +18,50 @@ namespace {
 
 constexpr auto kVerifiedBit = uint64(1);
 
-[[nodiscard]] QString VerifiedData() {
-	return u"tele-verified"_q;
+[[nodiscard]] DocumentId VerifyIcon(not_null<PeerData*> peer) {
+	const auto details = peer->botVerifyDetails();
+	return details ? details->iconId : DocumentId();
 }
 
-class VerifiedCheck final : public Ui::Text::CustomEmoji {
-public:
-	int width() override;
-	QString entityData() override;
-	void paint(QPainter &p, const Context &context) override;
-	void unload() override;
-	bool ready() override;
-	bool readyInDefaultState() override;
-
-private:
-	QImage _frame;
-	QColor _color;
-
-};
+} // namespace
 
-int VerifiedCheck::width() {
-	return st::infoVerifiedStar.width();
+uint64 BubbleBadgesKey(not_null<PeerData*> peer) {
+	if (!BubbleBadges()) {
+		return 0;
+	}
+	return (uint64(VerifyIcon(peer)) << 1)
+		| (peer->isVerified() ? kVerifiedBit : 0);
 }
 
-QString VerifiedCheck::entityData() {
-	return VerifiedData();
+int BubbleCheckWidth(uint64 badges) {
+	return (badges & kVerifiedBit)
+		? (st::msgNameFont->spacew + st::infoVerifiedStar.width())
+		: 0;
 }
 
-void VerifiedCheck::paint(QPainter &p, const Context &context) {
+void PaintBubbleCheck(QPainter &p, int left, int top, const QColor &color) {
+	static auto frames = base::flat_map<QRgb, QImage>();
 	const auto &star = st::infoVerifiedStar;
-	if (_frame.isNull() || _color != context.textColor) {
+	if (frames.size() > 32) {
+		frames.clear();
+	}
+	auto &frame = frames[color.rgba()];
+	if (frame.isNull()) {
 		const auto ratio = style::DevicePixelRatio();
-		_frame = QImage(
+		frame = QImage(
 			star.size() * ratio,
 			QImage::Format_ARGB32_Premultiplied);
-		_frame.setDevicePixelRatio(ratio);
-		_frame.fill(Qt::transparent);
-		auto q = QPainter(&_frame);
-		star.paint(q, 0, 0, star.width(), context.textColor);
+		frame.setDevicePixelRatio(ratio);
+		frame.fill(Qt::transparent);
+		auto q = QPainter(&frame);
+		star.paint(q, 0, 0, star.width(), color);
 		q.setCompositionMode(QPainter::CompositionMode_DestinationOut);
 		st::infoVerifiedCheck.paint(q, 0, 0, star.width(), QColor(0, 0, 0));
-		q.end();
-		_color = context.textColor;
 	}
-	const auto size = Ui::Text::AdjustCustomEmojiSize(st::emojiSize);
 	p.drawImage(
-		context.position + QPoint(0, (size - star.height()) / 2),
-		_frame);
-}
-
-void VerifiedCheck::unload() {
-	_frame = QImage();
-}
-
-bool VerifiedCheck::ready() {
-	return true;
-}
-
-bool VerifiedCheck::readyInDefaultState() {
-	return true;
-}
-
-[[nodiscard]] DocumentId VerifyIcon(not_null<PeerData*> peer) {
-	const auto details = peer->botVerifyDetails();
-	return details ? details->iconId : DocumentId();
-}
-
-} // namespace
-
-uint64 BubbleBadgesKey(not_null<PeerData*> peer) {
-	if (!BubbleBadges()) {
-		return 0;
-	}
-	return (uint64(VerifyIcon(peer)) << 1)
-		| (peer->isVerified() ? kVerifiedBit : 0);
+		left + st::msgNameFont->spacew,
+		top + (st::msgNameFont->height - star.height()) / 2,
+		frame);
 }
 
 void SetBubbleName(
@@ -108,9 +78,6 @@ void SetBubbleName(
 		text = Data::SingleCustomEmoji(icon).append(' ').append(
 			std::move(text));
 	}
-	if (badges & kVerifiedBit) {
-		text.append(' ').append(Ui::Text::SingleCustomEmoji(VerifiedData()));
-	}
 	const auto session = &peer->session();
 	name.setMarkedText(st::msgNameStyle, text, Ui::NameTextOptions(), {
 		.repaint = std::move(repaint),
@@ -118,9 +85,6 @@ void SetBubbleName(
 				QStringView data,
 				const Ui::Text::MarkedContext &context)
 		-> std::unique_ptr<Ui::Text::CustomEmoji> {
-			if (data == VerifiedData()) {
-				return std::make_unique<VerifiedCheck>();
-			}
 			return session->data().customEmojiManager().create(
 				data,
 				context.repaint);
diff --git a/Telegram/SourceFiles/tele/tele_bubble_badges.h b/Telegram/SourceFiles/tele/tele_bubble_badges.h
index 30bbb1ddec3b6d4cf167269d43edd34f6f3cc73f..013b718ecdcf2795ac1bbf35287ade44aa8db18e 100644
--- a/Telegram/SourceFiles/tele/tele_bubble_badges.h
+++ b/Telegram/SourceFiles/tele/tele_bubble_badges.h
@@ -9,6 +9,8 @@ class String;
 namespace Tele {
 
 [[nodiscard]] uint64 BubbleBadgesKey(not_null<PeerData*> peer);
+[[nodiscard]] int BubbleCheckWidth(uint64 badges);
+void PaintBubbleCheck(QPainter &p, int left, int top, const QColor &color);
 void SetBubbleName(
 	Ui::Text::String &name,
 	not_null<PeerData*> peer,
