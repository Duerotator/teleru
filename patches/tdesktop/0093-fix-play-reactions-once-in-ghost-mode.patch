 namespace Main {
 class Session;
 } // namespace Main
@@ -40,6 +45,13 @@ struct GhostChat {
 [[nodiscard]] bool HideTyping(not_null<PeerData*> peer);
 [[nodiscard]] bool HideOnline();
 [[nodiscard]] bool SkipReadInbox(not_null<History*> history, MsgId tillId);
+[[nodiscard]] bool HideContentsRead(not_null<HistoryItem*> item);
+void ApplyLocalReactionsRead(
+	not_null<HistoryItem*> item,
+	base::flat_map<
+		Data::ReactionId,
+		std::vector<Data::RecentReaction>> &recent,
+	bool min);
 void ReadOnSend(const Api::SendAction &action);
 void OfflineAfterSend(not_null<Main::Session*> session);
 
