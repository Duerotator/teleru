Subject: [PATCH] fix: play reactions once in ghost mode

---
 Telegram/SourceFiles/apiwrap.cpp              |  4 +-
 .../data/data_message_reactions.cpp           |  2 +
 Telegram/SourceFiles/tele/tele_ghost.cpp      | 88 +++++++++++++++++++
 Telegram/SourceFiles/tele/tele_ghost.h        | 12 +++
 4 files changed, 104 insertions(+), 2 deletions(-)

diff --git a/Telegram/SourceFiles/apiwrap.cpp b/Telegram/SourceFiles/apiwrap.cpp
index 07b270283d74ea82ff038ae12f8c5f4244b75827..d2e6648810d8587ad929b002b7e14fcd3c7b5d9e 100644
--- a/Telegram/SourceFiles/apiwrap.cpp
+++ b/Telegram/SourceFiles/apiwrap.cpp
@@ -1450,7 +1450,7 @@ void ApiWrap::markContentsRead(
 		if (Tele::KeepsSecretMedia(item)
 			|| !item->markContentsRead(true)
 			|| !item->isRegular()
-			|| Tele::HideRead(item->history()->peer)) {
+			|| Tele::HideContentsRead(item)) {
 			continue;
 		}
 		if (const auto channel = item->history()->peer->asChannel()) {
@@ -1478,7 +1478,7 @@ void ApiWrap::markContentsRead(not_null<HistoryItem*> item) {
 	if (Tele::KeepsSecretMedia(item)
 		|| !item->markContentsRead(true)
 		|| !item->isRegular()
-		|| Tele::HideRead(item->history()->peer)) {
+		|| Tele::HideContentsRead(item)) {
 		return;
 	}
 	const auto ids = MTP_vector<MTPint>(1, MTP_int(item->id));
diff --git a/Telegram/SourceFiles/data/data_message_reactions.cpp b/Telegram/SourceFiles/data/data_message_reactions.cpp
index d6c5efd07f2f58fdd76ced068438d95d47becba0..d659ea2bee70f2096a07e8024139ee9cef09b65b 100644
--- a/Telegram/SourceFiles/data/data_message_reactions.cpp
