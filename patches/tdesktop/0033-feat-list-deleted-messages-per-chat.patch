+[[nodiscard]] QString CountText(int count) {
+	return (count == 1)
+		? u"1 deleted message"_q
+		: u"%1 deleted messages"_q.arg(count);
+}
+
+void ConfirmClear(
+		not_null<Window::SessionController*> controller,
+		not_null<History*> history) {
+	const auto count = KeptDeletedCount(history);
+	if (!count) {
+		return;
+	}
+	const auto weak = base::make_weak(history.get());
+	controller->show(Ui::MakeConfirmBox({
+		.text = u"Clear %1 from this chat? "
+			"They were kept only on this device."_q.arg(CountText(count)),
+		.confirmed = [=](Fn<void()> &&close) {
+			close();
+			if (const auto strong = weak.get()) {
+				ClearKeptDeleted(strong);
+			}
+		},
+		.confirmText = u"Clear"_q,
+		.confirmStyle = &st::attentionBoxButton,
+	}));
+}
