+DeletedWidget::DeletedWidget(
+	QWidget *parent,
+	not_null<Window::SessionController*> controller,
+	not_null<History*> history)
+: Window::SectionWidget(parent, controller, history->peer)
+, HistoryView::WindowListDelegate(controller)
+, _history(history)
+, _topBar(this, controller)
+, _topBarShadow(this)
+, _scroll(std::make_unique<Ui::ElasticScroll>(
+	this,
+	controller->chatStyle()->value(lifetime(), st::historyScroll)))
+, _clearButton(std::make_unique<Ui::FlatButton>(
+	this,
+	u"Clear all"_q.toUpper(),
+	st::historyComposeButton)) {
+	controller->chatStyle()->paletteChanged(
+	) | rpl::on_next([=] {
+		_scroll->updateBars();
+	}, _scroll->lifetime());
+
+	Window::ChatThemeValueFromPeer(
+		controller,
+		history->peer
+	) | rpl::on_next([=](std::shared_ptr<Ui::ChatTheme> &&theme) {
+		_theme = std::move(theme);
+		controller->setChatStyleTheme(_theme);
+	}, lifetime());
+
+	_topBar->setActiveChat(
+		TopBarWidget::ActiveChat{
+			.key = _history,
+			.section = Dialogs::EntryState::Section::Pinned,
+		},
+		nullptr);
+
+	_topBar->move(0, 0);
+	_topBar->resizeToWidth(width());
+	_topBar->show();
+
+	_topBar->deleteSelectionRequest(
+	) | rpl::on_next([=] {
+		confirmDeleteSelected();
+	}, _topBar->lifetime());
+	_topBar->clearSelectionRequest(
+	) | rpl::on_next([=] {
+		clearSelected();
+	}, _topBar->lifetime());
+	setupSearch();
+
+	_topBarShadow->raise();
+	controller->adaptive().value(
+	) | rpl::on_next([=] {
+		updateAdaptiveLayout();
+	}, lifetime());
+
+	_scroll->setHandleTouch(false);
+	_inner = _scroll->setOwnedWidget(object_ptr<ListWidget>(
+		this,
+		&controller->session(),
+		static_cast<ListDelegate*>(this)));
+	_inner->lower();
+	_scroll->move(0, _topBar->height());
+	_scroll->show();
+	_scroll->setOverscrollBg(QColor(0, 0, 0, 0));
+	_scroll->setOverscrollEdges([=] {
+		return _inner->loadedAtTopKnown() && _inner->loadedAtTop();
+	}, [=] {
+		return _inner->loadedAtBottomKnown() && _inner->loadedAtBottom();
+	});
+	_scroll->scrolls(
+	) | rpl::on_next([=] {
+		onScroll();
+	}, lifetime());
+
+	_inner->scrollKeyEvents(
+	) | rpl::on_next([=](not_null<QKeyEvent*> e) {
+		_scroll->keyPressEvent(e);
+	}, lifetime());
+
+	_clearButton->setClickedCallback([=] {
+		ConfirmClear(controller, _history);
+	});
+
+	KeptDeletedChanges(
+		_history
+	) | rpl::on_next([=] {
+		scheduleRefresh();
+	}, lifetime());
+	if (const auto count = KeptDeletedCount(_history)) {
+		setMessagesCount(count);
+	} else {
+		scheduleRefresh();
+	}
+
+	Window::SetupSwipeBackSection(this, _scroll.get(), _inner);
+}
+
+void DeletedWidget::setupSearch() {
+	_topBar->searchRequest(
+	) | rpl::on_next([=] {
+		_topBar->toggleSearch(true, anim::type::normal);
+	}, _topBar->lifetime());
+	_topBar->searchCancelled(
+	) | rpl::on_next([=] {
+		cancelSearch();
+	}, _topBar->lifetime());
+	_topBar->searchQuery(
+	) | rpl::on_next([=](const QString &query) {
+		const auto now = query.trimmed();
+		if (_query != now) {
+			_query = now;
+			_refreshes.fire({});
+		}
+	}, _topBar->lifetime());
+}
+
+void DeletedWidget::cancelSearch() {
+	_topBar->searchClear();
+	_topBar->toggleSearch(false, anim::type::normal);
+	doSetInnerFocus();
+}
+
+void DeletedWidget::scheduleRefresh() {
+	if (_refreshScheduled) {
+		return;
+	}
+	_refreshScheduled = true;
+	crl::on_main(this, [=] {
+		_refreshScheduled = false;
+		refresh();
+	});
+}
+
+void DeletedWidget::refresh() {
+	const auto count = KeptDeletedCount(_history);
+	if (!count) {
+		controller()->showBackFromStack();
+		return;
+	}
+	setMessagesCount(count);
+	_refreshes.fire({});
+}
+
+void DeletedWidget::setMessagesCount(int count) {
+	if (_messagesCount == count) {
+		return;
+	}
+	_messagesCount = count;
+	_topBar->setCustomTitle(CountText(count));
+}
+
+Data::MessagesSlice DeletedWidget::buildSlice(
+		Data::MessagePosition aroundId) const {
+	auto items = KeptDeletedItems(_history);
+	if (!_query.isEmpty()) {
+		const auto skip = [&](not_null<HistoryItem*> item) {
+			return !item->originalText().text.contains(
+				_query,
+				Qt::CaseInsensitive);
+		};
+		items.erase(ranges::remove_if(items, skip), end(items));
+	}
+	auto result = Data::MessagesSlice();
+	const auto size = int(items.size());
+	result.fullCount = size;
+	result.skippedBefore = result.skippedAfter = 0;
+	if (!size) {
+		return result;
+	}
+	const auto around = (aroundId.fullId.msg > 0)
+		? aroundId.fullId.msg
+		: (ServerMaxMsgId - 1);
+	const auto i = ranges::find_if(items, [&](not_null<HistoryItem*> item) {
+		return item->id >= around;
+	});
+	result.nearestToAround = ((i != end(items)) ? *i : items.back())->fullId();
+	result.ids.reserve(size);
+	for (const auto &item : items) {
+		result.ids.push_back(item->fullId());
+	}
+	return result;
+}
