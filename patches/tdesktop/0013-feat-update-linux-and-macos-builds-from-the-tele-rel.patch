+[[nodiscard]] bool SafeRelativePath(const QString &path) {
+	if (path.contains('\\')) {
+		return false;
+	}
+	for (const auto &part : path.split('/')) {
+		if (part.isEmpty() || part == u"."_q || part == u".."_q) {
+			return false;
+		}
+	}
+	return true;
+}
 
+[[nodiscard]] QString Unpack(const Release &release, const QByteArray &zip) {
+	if (Sha256Hex(zip) != release.zipSha256) {
+		return u"downloaded archive doesn't match the feed"_q;
+	}
+	const auto target = InstallPath() + u".new"_q;
+	base::Platform::DeleteDirectory(target);
+	const auto fail = [&](const QString &error) {
+		base::Platform::DeleteDirectory(target);
+		return error;
+	};
+	if (!QDir().mkpath(target)) {
+		return fail(u"can't create %1"_q.arg(target));
+	}
+	auto archive = zlib::FileToRead(zip);
+	auto global = unz_global_info();
+	if (archive.getGlobalInfo(&global) != UNZ_OK) {
+		return fail(u"can't read the archive"_q);
+	}
+	const auto prefix = QString::fromLatin1(kBundleInZip);
+	const auto exeInBundle = QString::fromLatin1(kExeInBundle);
+	auto sawExe = false;
+	for (auto i = uLong(0); i != global.number_entry; ++i) {
+		const auto moved = (i == 0)
+			? archive.goToFirstFile()
+			: archive.goToNextFile();
+		auto info = unz_file_info();
+		char name[1024] = { 0 };
+		if (moved != UNZ_OK
+			|| archive.getCurrentFileInfo(
+				&info,
+				name,
+				sizeof(name) - 1,
+				nullptr,
+				0,
+				nullptr,
+				0) != UNZ_OK
+			|| info.size_filename >= sizeof(name)) {
+			return fail(u"can't read the archive"_q);
+		}
+		const auto entry = QString::fromUtf8(name, int(info.size_filename));
+		if (!entry.startsWith(prefix)) {
+			return fail(u"unexpected %1 in the archive"_q.arg(entry));
+		}
+		auto relative = entry.mid(prefix.size());
+		const auto madeOnUnix = ((info.version >> 8) == 3);
+		const auto mode = madeOnUnix
+			? mode_t(info.external_fa >> 16)
+			: mode_t(0);
+		const auto directory = relative.isEmpty()
+			|| relative.endsWith('/')
+			|| S_ISDIR(mode);
+		if (relative.endsWith('/')) {
+			relative.chop(1);
+		}
+		if (!relative.isEmpty() && !SafeRelativePath(relative)) {
+			return fail(u"unsafe path %1 in the archive"_q.arg(entry));
+		}
+		const auto path = relative.isEmpty()
+			? target
+			: (target + '/' + relative);
+		const auto encoded = QFile::encodeName(path);
+		const auto permissions = mode & 0777;
+		if (directory) {
+			if (!QDir().mkpath(path)) {
+				return fail(u"can't create %1"_q.arg(path));
+			}
+			::chmod(encoded.constData(), permissions ? permissions : 0755);
+			continue;
+		}
+		QDir().mkpath(QFileInfo(path).path());
+		if (S_ISLNK(mode)) {
+			const auto link = archive.readCurrentFileContent(4096);
+			const auto resolved = QDir::cleanPath(
+				QFileInfo(path).path() + '/' + QString::fromUtf8(link));
+			if (archive.error() != UNZ_OK
+				|| link.isEmpty()
+				|| link.startsWith('/')
+				|| !resolved.startsWith(target + '/')) {
+				return fail(u"unsafe link %1 in the archive"_q.arg(entry));
+			} else if (::symlink(link.constData(), encoded.constData())) {
+				return fail(u"can't create %1: %2"_q.arg(path, ErrnoText()));
+			}
+			continue;
+		}
+		const auto content = archive.readCurrentFileContent(kMaxExeSize);
+		if (archive.error() != UNZ_OK
+			|| (content.isEmpty() && info.uncompressed_size > 0)) {
+			return fail(u"can't unpack %1 from the archive"_q.arg(entry));
+		} else if (relative == exeInBundle) {
+			if (Sha256Hex(content) != release.exeSha256) {
+				return fail(u"unpacked app doesn't match the feed"_q);
+			}
+			sawExe = true;
+		}
+		auto file = QFile(path);
+		if (!file.open(QIODevice::WriteOnly)
+			|| file.write(content) != content.size()
+			|| !file.flush()) {
+			return fail(u"can't write %1"_q.arg(path));
+		}
+		file.close();
+		::chmod(encoded.constData(), permissions ? permissions : 0644);
+	}
+	if (!sawExe) {
+		return fail(u"the archive has no %1"_q.arg(prefix + exeInBundle));
+	}
+	RemoveQuarantine(target);
+	return QString();
+}
