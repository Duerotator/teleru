diff --git a/Telegram/SourceFiles/tele/tele_screen_capture.cpp b/Telegram/SourceFiles/tele/tele_screen_capture.cpp
index e2a0e358e0b606bf9c97b576a0fdb67771913602..b9c0e6a36976137279263342f201c813544ac97a 100644
--- a/Telegram/SourceFiles/tele/tele_screen_capture.cpp
+++ b/Telegram/SourceFiles/tele/tele_screen_capture.cpp
@@ -10,19 +10,57 @@ namespace {
 
 constexpr auto kRequested = "teleScreenCaptureExcluded";
 
+void Apply(not_null<QWidget*> widget) {
+	Platform::SetWindowScreenshotProtection(
+		widget,
+		widget->property(kRequested).toBool());
+}
+
+class WindowFilter final : public QObject {
+protected:
+	bool eventFilter(QObject *watched, QEvent *event) override;
+
+};
+
+bool WindowFilter::eventFilter(QObject *watched, QEvent *event) {
+	const auto type = event->type();
+	if (type == QEvent::WinIdChange || type == QEvent::Show) {
+		if (const auto widget = qobject_cast<QWidget*>(watched)) {
+			if (widget->isWindow()) {
+				Apply(widget);
+			}
+		}
+	}
+	return QObject::eventFilter(watched, event);
+}
+
 } // namespace
 
 bool ScreenCaptureExcluded(not_null<QWidget*> window, bool requested) {
 	window->setProperty(kRequested, requested);
-	return requested && !AllowScreenCapture();
+	return StreamerMode() || (requested && !AllowScreenCapture());
 }
 
 void WatchScreenCapture(rpl::lifetime &lifetime) {
-	AllowScreenCaptureChanges() | rpl::on_next([] {
+	rpl::merge(
+		AllowScreenCaptureChanges(),
+		StreamerModeValue() | rpl::skip(1) | rpl::to_empty
+	) | rpl::on_next([] {
 		for (const auto widget : QApplication::topLevelWidgets()) {
-			Platform::SetWindowScreenshotProtection(
-				widget,
-				widget->property(kRequested).toBool());
+			Apply(widget);
+		}
+	}, lifetime);
+	if (!Platform::ScreenshotProtectionSupported()) {
+		return;
+	}
+	const auto filter = lifetime.make_state<std::unique_ptr<QObject>>();
+	StreamerModeValue(
+	) | rpl::on_next([=](bool enabled) {
+		if (!enabled) {
+			*filter = nullptr;
+		} else if (!*filter) {
+			*filter = std::make_unique<WindowFilter>();
+			qApp->installEventFilter(filter->get());
 		}
 	}, lifetime);
 }
