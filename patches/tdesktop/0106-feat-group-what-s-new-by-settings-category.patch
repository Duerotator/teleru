+[[nodiscard]] TextWithEntities Title(const Notes &notes) {
+	return { Lower(notes.title + u" is here"_q) };
+}
+
+[[nodiscard]] TextWithEntities FullLink(const Notes &notes) {
+	return Ui::Text::Link(Lower(u"Full changelog"_q), notes.url);
+}
+
+[[nodiscard]] TextWithEntities EntryText(const Entry &entry) {
+	auto result = TextWithEntities{ Lower(entry.text) };
+	if (!entry.where.isEmpty()) {
+		result.append('\n').append(Ui::Text::Italic(Lower(entry.where)));
+	}
+	return result;
