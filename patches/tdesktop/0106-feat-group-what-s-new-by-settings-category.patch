+[[nodiscard]] Iv::RichPage::Block TextBlock(
+		Iv::RichPage::BlockKind kind,
+		TextWithEntities text,
+		int headingLevel = 0) {
+	auto result = Iv::RichPage::Block();
+	result.kind = kind;
+	result.headingLevel = headingLevel;
+	result.text.text = std::move(text);
+	return result;
+}
+
+[[nodiscard]] std::shared_ptr<const Iv::RichPage> RichNotes(
+		not_null<Main::Session*> session,
+		const Notes &notes) {
+	using Kind = Iv::RichPage::BlockKind;
+	auto result = std::make_shared<Iv::RichPage>();
+	auto &blocks = result->blocks;
+	blocks.push_back(TextBlock(Kind::Heading, Title(notes), 2));
+	for (const auto &group : notes.groups) {
+		if (!group.name.isEmpty()) {
+			blocks.push_back(TextBlock(
+				Kind::Heading,
+				{ Lower(group.name) },
+				3));
 		}
-		result.append('\n');
+		auto list = Iv::RichPage::Block();
+		list.kind = Kind::List;
+		list.listKind = Iv::RichPage::ListKind::Bullet;
+		list.listItems.reserve(group.entries.size());
+		for (const auto &entry : group.entries) {
+			auto item = Iv::RichPage::ListItem();
+			item.text.text = EntryText(entry);
+			list.listItems.push_back(std::move(item));
+		}
+		blocks.push_back(std::move(list));
+	}
+	blocks.push_back(TextBlock(Kind::Paragraph, FullLink(notes)));
+	const auto limits = Iv::ResolveRichMessageLimits(session);
+	if (Iv::ValidateRichMessage(*result, limits)) {
+		return nullptr;
+	}
+	return result;
+}
+
+[[nodiscard]] TextWithEntities GroupText(const Group &group) {
+	auto result = TextWithEntities();
+	if (!group.name.isEmpty()) {
+		result.append(Ui::Text::Bold(Lower(group.name))).append('\n');
 	}
-	if (count) {
+	for (const auto &entry : group.entries) {
+		result.append(Ui::kQBullet + ' ').append(EntryText(entry));
 		result.append('\n');
 	}
-	result.append(Ui::Text::Link(Lower(u"Full changelog"_q), url));
 	return result;
 }
 
-[[nodiscard]] std::vector<ChangelogMessage> Split(TextWithEntities text) {
-	auto result = std::vector<ChangelogMessage>();
+void AppendMessages(
+		std::vector<ChangelogMessage> &messages,
+		TextWithEntities text) {
 	auto part = TextWithEntities();
 	while (TextUtilities::CutPart(part, text, kMaxMessageLength)) {
-		result.push_back({ .text = std::move(part) });
+		messages.push_back({ .text = std::move(part) });
 		part = TextWithEntities();
 	}
+}
+
+[[nodiscard]] std::vector<ChangelogMessage> PlainNotes(const Notes &notes) {
+	auto whole = Ui::Text::Bold(Title(notes).text);
+	for (const auto &group : notes.groups) {
+		whole.append('\n').append(GroupText(group));
+	}
+	whole.append('\n').append(FullLink(notes));
+	auto result = std::vector<ChangelogMessage>();
+	if (whole.text.size() <= kMaxSplitLength) {
+		AppendMessages(result, std::move(whole));
+		return result;
+	}
+	for (auto i = 0, count = int(notes.groups.size()); i != count; ++i) {
+		auto text = i
+			? TextWithEntities()
+			: Ui::Text::Bold(Title(notes).text).append(u"\n\n"_q);
+		text.append(GroupText(notes.groups[i]));
+		if (i + 1 == count) {
+			text.append('\n').append(FullLink(notes));
+		}
+		AppendMessages(result, std::move(text));
+	}
 	return result;
 }
 
+[[nodiscard]] std::vector<ChangelogMessage> Messages(
+		not_null<Main::Session*> session,
+		const Notes &notes) {
+	if (auto rich = RichNotes(session, notes)) {
+		return { ChangelogMessage{ .rich = std::move(rich) } };
+	}
+	return PlainNotes(notes);
+}
+
