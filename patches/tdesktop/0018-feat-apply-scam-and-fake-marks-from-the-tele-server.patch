From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: nitreojs <hello@starkow.dev>
Date: Sun, 27 Sep 2026 01:02:59 +0300
Subject: [PATCH] feat: apply scam and fake marks from the tele server

---
 Telegram/SourceFiles/data/data_session.cpp |  8 +-
 Telegram/SourceFiles/tele/tele_badges.cpp  | 85 +++++++++++++++++-----
 Telegram/SourceFiles/tele/tele_badges.h    |  2 +
 3 files changed, 73 insertions(+), 22 deletions(-)

diff --git a/Telegram/SourceFiles/data/data_session.cpp b/Telegram/SourceFiles/data/data_session.cpp
index e76c627ea1b7f21f28f0bed46d160be52b368e83..edd9837e97a525f5ea7d9b498ca70e78513340cb 100644
--- a/Telegram/SourceFiles/data/data_session.cpp
+++ b/Telegram/SourceFiles/data/data_session.cpp
@@ -740,8 +740,8 @@ not_null<UserData*> Session::processUser(const MTPUser &data) {
 			: stories().peerSourceState(result, *data.vstories_max_id());
 		const auto flagsSet = (data.is_deleted() ? Flag::Deleted : Flag())
 			| ((Tele::Verified(result) || data.is_verified()) ? Flag::Verified : Flag())
-			| (data.is_scam() ? Flag::Scam : Flag())
-			| (data.is_fake() ? Flag::Fake : Flag())
+			| ((Tele::Scam(result) || data.is_scam()) ? Flag::Scam : Flag())
+			| ((Tele::Fake(result) || data.is_fake()) ? Flag::Fake : Flag())
 			| (data.is_bot_inline_geo() ? Flag::BotInlineGeo : Flag())
 			| (data.is_bot_forum_view() ? Flag::Forum : Flag())
 			| (data.is_premium() ? Flag::Premium : Flag())
@@ -1151,8 +1151,8 @@ not_null<PeerData*> Session::processChat(const MTPChat &data) {
 			: stories().peerSourceState(channel, *data.vstories_max_id());
 		const auto flagsSet = (data.is_broadcast() ? Flag::Broadcast : Flag())
 			| ((Tele::Verified(channel) || data.is_verified()) ? Flag::Verified : Flag())
-			| (data.is_scam() ? Flag::Scam : Flag())
-			| (data.is_fake() ? Flag::Fake : Flag())
+			| ((Tele::Scam(channel) || data.is_scam()) ? Flag::Scam : Flag())
+			| ((Tele::Fake(channel) || data.is_fake()) ? Flag::Fake : Flag())
 			| (data.is_megagroup() ? Flag::Megagroup : Flag())
 			| (data.is_gigagroup() ? Flag::Gigagroup : Flag())
 			| (hasUsername ? Flag::Username : Flag())
diff --git a/Telegram/SourceFiles/tele/tele_badges.cpp b/Telegram/SourceFiles/tele/tele_badges.cpp
index e5a2630a8471c7f290a5e540cec6e4eb9dd05b50..f5039de13a27adf0a48a91bb9eff2f3da46fedcb 100644
--- a/Telegram/SourceFiles/tele/tele_badges.cpp
+++ b/Telegram/SourceFiles/tele/tele_badges.cpp
@@ -68,6 +68,8 @@ struct Params {
 
 struct Entry {
 	bool checkmark = false;
+	bool scam = false;
+	bool fake = false;
 	Ui::BotVerifyDetails details;
 
 	friend inline bool operator==(const Entry &, const Entry &) = default;
@@ -201,14 +203,22 @@ struct Feed {
 	}
 	const auto fields = value.toObject();
 	const auto checkmark = fields.value(u"checkmark"_q);
+	const auto scam = fields.value(u"scam"_q);
+	const auto fake = fields.value(u"fake"_q);
 	const auto icon = fields.value(u"icon"_q);
 	const auto description = fields.value(u"description"_q);
 	if ((Present(checkmark) && !checkmark.isBool())
+		|| (Present(scam) && !scam.isBool())
+		|| (Present(fake) && !fake.isBool())
 		|| (Present(icon) && !icon.isString())
 		|| (Present(description) && !description.isString())) {
 		return std::nullopt;
 	}
-	auto result = Entry{ .checkmark = checkmark.toBool() };
+	auto result = Entry{
+		.checkmark = checkmark.toBool(),
+		.scam = scam.toBool(),
+		.fake = fake.toBool(),
+	};
 	if (!Present(icon)) {
 		return result;
 	}
@@ -300,19 +310,29 @@ template <typename Peer, typename Flag>
 void Apply(
 		not_null<Peer*> peer,
 		Flag verified,
+		Flag scam,
+		Flag fake,
 		const Entry &was,
 		const Entry &now) {
-	if (now.checkmark) {
-		peer->addFlags(verified);
-	} else if (was.checkmark) {
-		peer->removeFlags(verified);
-	}
+	const auto flag = [&](Flag value, bool wasOn, bool nowOn) {
+		if (nowOn) {
+			peer->addFlags(value);
+		} else if (wasOn) {
+			peer->removeFlags(value);
+		}
+	};
+	flag(verified, was.checkmark, now.checkmark);
+	flag(scam, was.scam, now.scam);
+	flag(fake, was.fake, now.fake);
 	if (now.details) {
 		peer->setBotVerifyDetails(now.details);
 	} else if (was.details) {
 		peer->setBotVerifyDetails({});
 	}
-	if ((was.checkmark && !now.checkmark) || (was.details && !now.details)) {
+	if ((was.checkmark && !now.checkmark)
+		|| (was.scam && !now.scam)
+		|| (was.fake && !now.fake)
+		|| (was.details && !now.details)) {
 		peer->session().api().requestFullPeer(peer);
 	}
 }
@@ -322,7 +342,7 @@ public:
 	Badges();
 
 	[[nodiscard]] bool active() const;
-	[[nodiscard]] bool verified(PeerKey key);
+	[[nodiscard]] const Entry *lookup(PeerKey key);
 	[[nodiscard]] const Entry *applied(PeerKey key) const;
 	void refreshNow(Fn<void(QString)> done);
 
@@ -397,13 +417,13 @@ bool Badges::active() const {
 	return _feed && !_feed->entries.empty();
 }
 
-bool Badges::verified(PeerKey key) {
+const Entry *Badges::lookup(PeerKey key) {
 	if (const auto i = _applied.find(key); i != end(_applied)) {
-		return i->second.checkmark;
+		return &i->second;
 	} else if (!_tags.contains(key) && !_failed.contains(key)) {
 		queue(key);
 	}
-	return false;
+	return nullptr;
 }
 
 const Entry *Badges::applied(PeerKey key) const {
@@ -724,9 +744,23 @@ void Badges::push(PeerKey key, const Entry &was, const Entry &now) const {
 		if (!peer) {
 			return;
 		} else if (const auto user = peer->asUser()) {
-			Apply<UserData>(user, UserDataFlag::Verified, was, now);
+			using Flag = UserDataFlag;
+			Apply<UserData>(
+				user,
+				Flag::Verified,
+				Flag::Scam,
+				Flag::Fake,
+				was,
+				now);
 		} else if (const auto channel = peer->asChannel()) {
-			Apply<ChannelData>(channel, ChannelDataFlag::Verified, was, now);
+			using Flag = ChannelDataFlag;
+			Apply<ChannelData>(
+				channel,
+				Flag::Verified,
+				Flag::Scam,
+				Flag::Fake,
+				was,
+				now);
 		}
 		session->changes().peerUpdated(
 			peer,
@@ -735,6 +769,14 @@ void Badges::push(PeerKey key, const Entry &was, const Entry &now) const {
 	});
 }
 
+[[nodiscard]] const Entry *Lookup(not_null<PeerData*> peer) {
+	if (!Instance || !Instance->active()) {
+		return nullptr;
+	}
+	const auto key = Key(peer);
+	return key ? Instance->lookup(key) : nullptr;
+}
+
 } // namespace
 
 void StartBadges() {
@@ -752,11 +794,18 @@ void RefreshBadges(Fn<void(QString)> done) {
 }
 
 bool Verified(not_null<PeerData*> peer) {
-	if (!Instance || !Instance->active()) {
-		return false;
-	}
-	const auto key = Key(peer);
-	return key && Instance->verified(key);
+	const auto entry = Lookup(peer);
+	return entry && entry->checkmark;
+}
+
+bool Scam(not_null<PeerData*> peer) {
+	const auto entry = Lookup(peer);
+	return entry && entry->scam;
+}
+
+bool Fake(not_null<PeerData*> peer) {
+	const auto entry = Lookup(peer);
+	return entry && entry->fake;
 }
 
 void OverrideVerifyDetails(
diff --git a/Telegram/SourceFiles/tele/tele_badges.h b/Telegram/SourceFiles/tele/tele_badges.h
index f64c9f237708be71c9d5ff28b2c2ef20e3313743..a694255a26d82e9b62e24fc8643a4d5fa2b28516 100644
--- a/Telegram/SourceFiles/tele/tele_badges.h
+++ b/Telegram/SourceFiles/tele/tele_badges.h
@@ -12,6 +12,8 @@ void StartBadges();
 void RefreshBadges(Fn<void(QString)> done);
 
 [[nodiscard]] bool Verified(not_null<PeerData*> peer);
+[[nodiscard]] bool Scam(not_null<PeerData*> peer);
+[[nodiscard]] bool Fake(not_null<PeerData*> peer);
 void OverrideVerifyDetails(
 	not_null<PeerData*> peer,
 	Ui::BotVerifyDetails &details);
