 	updateTitle();
 	updateWindowIcon();
@@ -889,6 +894,10 @@ void MainWindow::updateTitle() {
 	if (Core::Quitting()) {
 		return;
 	}
+	if (const auto custom = Tele::WindowTitleText(&controller())) {
+		setTitle(*custom);
+		return;
+	}
 
 	const auto suffix = nativeTitleSuffix();
 	const auto settings = Core::App().settings().windowTitleContent();
