diff --git a/Telegram/SourceFiles/settings/settings_tele.cpp b/Telegram/SourceFiles/settings/settings_tele.cpp
index b7a715850b278878e7e50200a6c1c255c1908375..964ec99163beb94f477f97afcd5b1e4ad64150bf 100644
--- a/Telegram/SourceFiles/settings/settings_tele.cpp
+++ b/Telegram/SourceFiles/settings/settings_tele.cpp
@@ -292,40 +292,72 @@ void AddServer(
 
 void TitleBox(
 		not_null<Ui::GenericBox*> box,
-		not_null<Window::Controller*> window) {
-	box->setTitle(rpl::single(::Tele::Lower(u"Title bar label"_q)));
+		not_null<Window::Controller*> window,
+		bool windowTitle) {
+	const auto option = &base::options::lookup<QString>(windowTitle
+		? ::Tele::kOptionWindowTitleTemplate
+		: ::Tele::kOptionTitleTemplate);
+	box->setTitle(rpl::single(::Tele::Lower(windowTitle
+		? u"Window title"_q
+		: u"Title bar label"_q)));
 	const auto field = box->addRow(object_ptr<Ui::InputField>(
 		box,
 		st::defaultInputField,
 		rpl::single(::Tele::Lower(u"Template"_q)),
-		::Tele::TitleTemplate()));
+		option->value()));
 	const auto preview = box->addRow(object_ptr<Ui::FlatLabel>(
 		box,
 		QString(),
 		st::boxLabel));
+	const auto refresh = [=] {
+		const auto source = field->getLastText();
+		const auto text = windowTitle
+			? ::Tele::PreviewWindowTitleText(window, source)
+			: ::Tele::PreviewTitleText(window, source);
+		preview->setText(!text.isEmpty()
+			? text
+			: !windowTitle
+			? u"no label"_q
+			: source.isEmpty()
+			? ::Tele::Lower(u"Default title"_q)
+			: ::Tele::Lower(u"Empty title"_q));
+	};
+	if (windowTitle) {
+		const auto use = box->addRow(object_ptr<Ui::LinkButton>(
+			box,
+			::Tele::Lower(u"Use the title bar label"_q)));
+		use->setClickedCallback([=] {
+			field->setText(u"{label}"_q);
+			refresh();
+		});
+	}
 	box->addRow(object_ptr<Ui::FlatLabel>(
 		box,
 		u"{build} {version}\n"
 		"{time} {date} {weekday}, or custom formats like "
 		"{time:HH:mm:ss} and {date:dd MMM}\n"
 		"{name} {username} {id} {accounts}\n"
-		"{unread} {chat} {chat_unread} {status}\n"
-		"[ ... ] hides its part when a variable inside is empty or 0, "
+		"{unread} {chat} {chat_unread} {status}\n"_q
+		+ (windowTitle ? u"{label}\n"_q : QString())
+		+ u"[ ... ] hides its part when a variable inside is empty or 0, "
 		"doubled brackets are literal."_q,
 		st::boxDividerLabel));
-	const auto refresh = [=] {
-		const auto text = ::Tele::PreviewTitleText(
-			window,
-			field->getLastText());
-		preview->setText(text.isEmpty() ? u"no label"_q : text);
-	};
+	if (windowTitle) {
+		box->addRow(object_ptr<Ui::FlatLabel>(
+			box,
+			::Tele::Lower(u"The title Windows, macOS and Linux show in the "
+				"taskbar, Alt+Tab and the system window frame. Empty keeps "
+				"the default title, a template that renders to nothing "
+				"leaves the title blank."_q),
+			st::boxDividerLabel));
+	}
 	const auto timer = box->lifetime().make_state<base::Timer>(refresh);
 	timer->callEach(crl::time(1000));
 	field->changes(
 	) | rpl::on_next(refresh, field->lifetime());
 	refresh();
 	const auto save = [=] {
-		::Tele::SetTitleTemplate(field->getLastText());
+		option->set(field->getLastText());
 		box->closeBox();
 	};
 	field->submits(
@@ -340,8 +372,7 @@ void TitleBox(
 		box->closeBox();
 	});
 	box->addLeftButton(rpl::single(::Tele::Lower(u"Reset"_q)), [=] {
-		field->setText(base::options::lookup<QString>(
-			::Tele::kOptionTitleTemplate).defaultValue());
+		field->setText(option->defaultValue());
 		refresh();
 	});
 }
@@ -359,7 +390,7 @@ void AddTitle(
 		}),
 		st::settingsButtonNoIcon);
 	button->setClickedCallback([=] {
-		controller->show(Box(TitleBox, &controller->window()));
+		controller->show(Box(TitleBox, &controller->window(), false));
 	});
 	SetupLink(button, option.id());
 	container->add(
@@ -368,6 +399,26 @@ void AddTitle(
 			::Tele::Lower(option.description()),
 			st::settingsExperimentalAbout),
 		st::settingsExperimentalAboutPadding);
+	const auto &windowOption = base::options::lookup<QString>(
+		::Tele::kOptionWindowTitleTemplate);
+	const auto windowButton = AddButtonWithLabel(
+		container,
+		rpl::single(::Tele::Lower(u"Window title"_q)),
+		::Tele::WindowTitleTemplateValue(
+		) | rpl::map([](const QString &text) {
+			return text.isEmpty() ? ::Tele::Lower(u"Default"_q) : text;
+		}),
+		st::settingsButtonNoIcon);
+	windowButton->setClickedCallback([=] {
+		controller->show(Box(TitleBox, &controller->window(), true));
+	});
+	SetupLink(windowButton, windowOption.id());
+	container->add(
+		object_ptr<Ui::FlatLabel>(
+			container,
+			::Tele::Lower(windowOption.description()),
+			st::settingsExperimentalAbout),
+		st::settingsExperimentalAboutPadding);
 }
 
 class IgnoredRow final : public PeerListRowWithLink {
diff --git a/Telegram/SourceFiles/tele/tele_options.cpp b/Telegram/SourceFiles/tele/tele_options.cpp
index 97020eddedbe0715ba0d17a0f4aea7269d063549..22d865d1590a766b395912c84403148b90697bda 100644
--- a/Telegram/SourceFiles/tele/tele_options.cpp
+++ b/Telegram/SourceFiles/tele/tele_options.cpp
@@ -45,6 +45,7 @@ const char kOptionScreenshotSecretMedia[] = "tele-screenshot-secret-media";
 const char kOptionViewAsTl[] = "tele-view-as-tl";
 const char kOptionServerUrl[] = "tele-server-url";
 const char kOptionTitleTemplate[] = "tele-title";
+const char kOptionWindowTitleTemplate[] = "tele-window-title";
 
 namespace {
 
@@ -373,6 +374,15 @@ base::options::option<QString> TitleTemplateOption({
 	.defaultValue = u"TELE {build}"_q,
 });
 
+base::options::option<QString> WindowTitleTemplateOption({
+	.id = kOptionWindowTitleTemplate,
+	.name = "Window title",
+	.description = "The title the system shows in the taskbar, Alt+Tab "
+		"and the system window frame, with the same variables as the "
+		"label and {label} for the label itself. Empty keeps the "
+		"default title.",
+});
+
 } // namespace
 
 bool HideStories() {
@@ -694,4 +704,22 @@ rpl::producer<QString> TitleTemplateValue() {
 	});
 }
 
+QString WindowTitleTemplate() {
+	return WindowTitleTemplateOption.value();
+}
+
+void SetWindowTitleTemplate(const QString &value) {
+	WindowTitleTemplateOption.set(value);
+}
+
+rpl::producer<QString> WindowTitleTemplateValue() {
+	return rpl::single(
+		rpl::empty
+	) | rpl::then(
+		WindowTitleTemplateOption.changes()
+	) | rpl::map([] {
+		return WindowTitleTemplateOption.value();
+	});
+}
+
 } // namespace Tele
diff --git a/Telegram/SourceFiles/tele/tele_options.h b/Telegram/SourceFiles/tele/tele_options.h
index 56d6c5d3d280071971058d83e5b7089f06137d05..6990ac3450f715f3338be93658bcf12b43e6d53f 100644
