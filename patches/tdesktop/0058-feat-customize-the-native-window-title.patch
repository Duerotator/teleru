+++ b/Telegram/SourceFiles/tele/tele_options.h
@@ -43,6 +43,7 @@ extern const char kOptionScreenshotSecretMedia[];
 extern const char kOptionViewAsTl[];
 extern const char kOptionServerUrl[];
 extern const char kOptionTitleTemplate[];
+extern const char kOptionWindowTitleTemplate[];
 
 [[nodiscard]] bool HideStories();
 [[nodiscard]] bool InvisibleStories();
@@ -106,5 +107,8 @@ void SetServerUrl(const QString &url);
 [[nodiscard]] QString TitleTemplate();
 void SetTitleTemplate(const QString &value);
 [[nodiscard]] rpl::producer<QString> TitleTemplateValue();
+[[nodiscard]] QString WindowTitleTemplate();
+void SetWindowTitleTemplate(const QString &value);
+[[nodiscard]] rpl::producer<QString> WindowTitleTemplateValue();
 
 } // namespace Tele
diff --git a/Telegram/SourceFiles/tele/tele_title.cpp b/Telegram/SourceFiles/tele/tele_title.cpp
index 4c6317f887bcdd01d4db58562f7601e79c9c492d..c2947f1d97d0addea830cd306c7c68939f0e09dc 100644
--- a/Telegram/SourceFiles/tele/tele_title.cpp
+++ b/Telegram/SourceFiles/tele/tele_title.cpp
@@ -42,10 +42,17 @@ struct Token {
 struct Template {
 	std::vector<Token> tokens;
 	Tick tick = Tick::None;
+	bool label = false;
+};
+
+enum class Target {
+	Label,
+	Window,
 };
 
 struct Context {
 	Window::SessionController *controller = nullptr;
+	const std::vector<Token> *label = nullptr;
 	QDateTime now;
 };
 
@@ -141,12 +148,21 @@ struct Context {
 	return result;
 }
 
+[[nodiscard]] bool UsesLabel(const std::vector<Token> &tokens) {
+	return ranges::any_of(tokens, [](const Token &token) {
+		return token.optional
+			? UsesLabel(token.group)
+			: (token.variable && token.name == u"label"_q);
+	});
+}
+
 [[nodiscard]] Template Parse(const QString &source) {
 	auto position = 0;
 	auto closed = false;
 	auto tokens = ParseTokens(source, position, false, closed);
 	const auto tick = TickFor(tokens);
-	return { .tokens = std::move(tokens), .tick = tick };
+	const auto label = UsesLabel(tokens);
+	return { .tokens = std::move(tokens), .tick = tick, .label = label };
 }
 
 [[nodiscard]] Context MakeContext(not_null<Window::Controller*> window) {
@@ -173,6 +189,11 @@ struct Context {
 		|| (state < 0);
 }
 
+[[nodiscard]] std::optional<QString> Render(
+	const std::vector<Token> &tokens,
+	const Context &context,
+	bool optional);
+
 [[nodiscard]] std::optional<QString> Value(
 		const Token &token,
 		const Context &context) {
@@ -226,6 +247,10 @@ struct Context {
 		return (controller && Connecting(&controller->session()))
 			? u"connecting"_q
 			: QString();
+	} else if (name == u"label"_q && context.label) {
+		auto inner = context;
+		inner.label = nullptr;
+		return Render(*context.label, inner, false).value_or(QString());
 	}
 	return std::nullopt;
 }
@@ -258,46 +283,50 @@ struct Context {
 	return period - (now % period) + 10;
 }
 
-} // namespace
-
-QString TitleText(not_null<Window::Controller*> window) {
-	return PreviewTitleText(window, TitleTemplate());
-}
-
-QString PreviewTitleText(
+[[nodiscard]] rpl::producer<QString> LiveText(
 		not_null<Window::Controller*> window,
-		const QString &source) {
-	return Render(Parse(source).tokens, MakeContext(window), false).value_or(
-		QString());
-}
-
-rpl::producer<QString> TitleTextValue(not_null<Window::Controller*> window) {
+		Target target) {
 	return [=](auto consumer) {
 		auto lifetime = rpl::lifetime();
 		struct State {
 			Template parsed;
+			Template label;
+			Tick tick = Tick::None;
 			base::Timer timer;
 			rpl::lifetime session;
 			std::optional<QString> last;
 		};
 		const auto state = lifetime.make_state<State>();
 		const auto push = [=] {
+			auto context = MakeContext(window);
+			if (target == Target::Window) {
+				context.label = &state->label.tokens;
+			}
 			auto text = Render(
 				state->parsed.tokens,
-				MakeContext(window),
+				context,
 				false).value_or(QString());
 			if (state->last != text) {
 				state->last = text;
 				consumer.put_next_copy(text);
 			}
-			if (state->parsed.tick != Tick::None) {
-				state->timer.callOnce(TickDelay(state->parsed.tick));
+			if (state->tick != Tick::None) {
+				state->timer.callOnce(TickDelay(state->tick));
 			}
 		};
 		state->timer.setCallback(push);
-		TitleTemplateValue(
-		) | rpl::on_next([=](const QString &source) {
+		const auto titled = (target == Target::Window);
+		rpl::combine(
+			titled ? WindowTitleTemplateValue() : TitleTemplateValue(),
+			(titled
+				? TitleTemplateValue()
+				: rpl::producer<QString>(rpl::single(QString())))
+		) | rpl::on_next([=](const QString &source, const QString &label) {
 			state->parsed = Parse(source);
+			state->label = Parse(label);
+			state->tick = state->parsed.label
+				? std::max(state->parsed.tick, state->label.tick)
+				: state->parsed.tick;
 			state->timer.cancel();
 			push();
 		}, lifetime);
@@ -325,4 +354,52 @@ rpl::producer<QString> TitleTextValue(not_null<Window::Controller*> window) {
 	};
 }
 
+} // namespace
+
+QString TitleText(not_null<Window::Controller*> window) {
+	return PreviewTitleText(window, TitleTemplate());
+}
+
+QString PreviewTitleText(
+		not_null<Window::Controller*> window,
+		const QString &source) {
+	return Render(Parse(source).tokens, MakeContext(window), false).value_or(
+		QString());
+}
+
+rpl::producer<QString> TitleTextValue(not_null<Window::Controller*> window) {
+	return LiveText(window, Target::Label);
+}
+
+QString PreviewWindowTitleText(
+		not_null<Window::Controller*> window,
+		const QString &source) {
+	const auto label = Parse(TitleTemplate());
+	auto context = MakeContext(window);
+	context.label = &label.tokens;
+	return Render(Parse(source).tokens, context, false).value_or(QString());
+}
+
+std::optional<QString> WindowTitleText(not_null<Window::Controller*> window) {
+	const auto source = WindowTitleTemplate();
+	if (source.isEmpty()) {
+		return std::nullopt;
+	}
+	const auto text = PreviewWindowTitleText(window, source);
+	return text.isEmpty() ? u" "_q : text;
+}
+
+rpl::producer<> WindowTitleChanges(not_null<Window::Controller*> window) {
+	return WindowTitleTemplateValue(
+	) | rpl::map([](const QString &source) {
+		return source.isEmpty();
+	}) | rpl::distinct_until_changed(
+	) | rpl::map([=](bool empty) -> rpl::producer<> {
+		if (empty) {
+			return rpl::single(rpl::empty);
+		}
+		return LiveText(window, Target::Window) | rpl::to_empty;
+	}) | rpl::flatten_latest();
+}
+
 } // namespace Tele
