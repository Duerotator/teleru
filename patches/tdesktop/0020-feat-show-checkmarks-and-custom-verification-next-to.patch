index 0000000000000000000000000000000000000000..6a3d88e54b777caad49b40e099f7b2041b4d137f
--- /dev/null
+++ b/Telegram/SourceFiles/tele/tele_bubble_badges.cpp
@@ -0,0 +1,131 @@
+#include "tele/tele_bubble_badges.h"
+
+#include "data/data_peer.h"
+#include "data/data_session.h"
+#include "data/stickers/data_custom_emoji.h"
+#include "main/main_session.h"
+#include "tele/tele_options.h"
+#include "ui/text/text.h"
+#include "ui/text/text_custom_emoji.h"
+#include "ui/text/text_options.h"
+#include "ui/text/text_utilities.h"
+#include "ui/unread_badge.h"
+#include "styles/style_chat.h"
+#include "styles/style_info.h"
+
+namespace Tele {
+namespace {
+
+constexpr auto kVerifiedBit = uint64(1);
+
+[[nodiscard]] QString VerifiedData() {
+	return u"tele-verified"_q;
+}
+
+class VerifiedCheck final : public Ui::Text::CustomEmoji {
+public:
+	int width() override;
+	QString entityData() override;
+	void paint(QPainter &p, const Context &context) override;
+	void unload() override;
+	bool ready() override;
+	bool readyInDefaultState() override;
+
+private:
+	QImage _frame;
+	QColor _color;
+
+};
+
+int VerifiedCheck::width() {
+	return st::infoVerifiedStar.width();
+}
+
+QString VerifiedCheck::entityData() {
+	return VerifiedData();
+}
+
+void VerifiedCheck::paint(QPainter &p, const Context &context) {
+	const auto &star = st::infoVerifiedStar;
+	if (_frame.isNull() || _color != context.textColor) {
+		const auto ratio = style::DevicePixelRatio();
+		_frame = QImage(
+			star.size() * ratio,
+			QImage::Format_ARGB32_Premultiplied);
+		_frame.setDevicePixelRatio(ratio);
+		_frame.fill(Qt::transparent);
+		auto q = QPainter(&_frame);
+		star.paint(q, 0, 0, star.width(), context.textColor);
+		q.setCompositionMode(QPainter::CompositionMode_DestinationOut);
+		st::infoVerifiedCheck.paint(q, 0, 0, star.width(), QColor(0, 0, 0));
+		q.end();
+		_color = context.textColor;
+	}
+	const auto size = Ui::Text::AdjustCustomEmojiSize(st::emojiSize);
+	p.drawImage(
+		context.position + QPoint(0, (size - star.height()) / 2),
+		_frame);
+}
+
+void VerifiedCheck::unload() {
+	_frame = QImage();
+}
+
+bool VerifiedCheck::ready() {
+	return true;
+}
+
+bool VerifiedCheck::readyInDefaultState() {
+	return true;
+}
+
+[[nodiscard]] DocumentId VerifyIcon(not_null<PeerData*> peer) {
+	const auto details = peer->botVerifyDetails();
+	return details ? details->iconId : DocumentId();
+}
+
+} // namespace
+
+uint64 BubbleBadgesKey(not_null<PeerData*> peer) {
+	if (!BubbleBadges()) {
+		return 0;
+	}
+	return (uint64(VerifyIcon(peer)) << 1)
+		| (peer->isVerified() ? kVerifiedBit : 0);
+}
+
+void SetBubbleName(
+		Ui::Text::String &name,
+		not_null<PeerData*> peer,
+		uint64 badges,
+		Fn<void()> repaint) {
+	if (!badges) {
+		name.setText(st::msgNameStyle, peer->name(), Ui::NameTextOptions());
+		return;
+	}
+	auto text = TextWithEntities{ peer->name() };
+	if (const auto icon = VerifyIcon(peer)) {
+		text = Data::SingleCustomEmoji(icon).append(' ').append(
+			std::move(text));
+	}
+	if (badges & kVerifiedBit) {
+		text.append(' ').append(Ui::Text::SingleCustomEmoji(VerifiedData()));
+	}
+	const auto session = &peer->session();
+	name.setMarkedText(st::msgNameStyle, text, Ui::NameTextOptions(), {
+		.repaint = std::move(repaint),
+		.customEmojiFactory = [=](
+				QStringView data,
+				const Ui::Text::MarkedContext &context)
+		-> std::unique_ptr<Ui::Text::CustomEmoji> {
+			if (data == VerifiedData()) {
+				return std::make_unique<VerifiedCheck>();
+			}
+			return session->data().customEmojiManager().create(
+				data,
+				context.repaint);
+		},
+	});
+}
+
+} // namespace Tele
