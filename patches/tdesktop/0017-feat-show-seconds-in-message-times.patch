diff --git a/Telegram/SourceFiles/tele/tele_time.cpp b/Telegram/SourceFiles/tele/tele_time.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..528af5cfd66ea7988c0596d0f1fa07377e6316bb
--- /dev/null
+++ b/Telegram/SourceFiles/tele/tele_time.cpp
@@ -0,0 +1,96 @@
+#include "tele/tele_time.h"
+
+#include "base/unixtime.h"
+#include "lang/lang_keys.h"
+#include "tele/tele_options.h"
+#include "ui/text/format_values.h"
+
+#include <QtCore/QLocale>
+
+namespace Tele {
+namespace {
+
+constexpr auto kSecondsInYear = 365 * 24 * 60 * 60;
+
+[[nodiscard]] QString WithSeconds(const QString &format) {
+	auto quoted = false;
+	auto minutesEnd = -1;
+	for (auto i = 0, size = int(format.size()); i != size; ++i) {
+		const auto ch = format[i];
+		if (ch == QChar('\'')) {
+			quoted = !quoted;
+		} else if (quoted) {
+			continue;
+		} else if (ch == QChar('s')) {
+			return format;
+		} else if (ch == QChar('m')) {
+			minutesEnd = i + 1;
+		}
+	}
+	if (minutesEnd < 0) {
+		return format;
+	}
+	auto minutesStart = minutesEnd;
+	while (minutesStart > 0 && format[minutesStart - 1] == QChar('m')) {
+		--minutesStart;
+	}
+	auto separatorStart = minutesStart;
+	while (separatorStart > 0
+		&& !format[separatorStart - 1].isLetter()
+		&& format[separatorStart - 1] != QChar('\'')) {
+		--separatorStart;
+	}
+	const auto separator = format.mid(
+		separatorStart,
+		minutesStart - separatorStart);
+	const auto literal = (separatorStart > 0)
+		&& (format[separatorStart - 1] == QChar('\''));
+	return format.left(minutesEnd)
+		+ ((literal || separator.trimmed().isEmpty()) ? u":"_q : separator)
+		+ u"ss"_q
+		+ format.mid(minutesEnd);
+}
+
+} // namespace
+
+QString FormatMessageTime(const QTime &time) {
+	const auto locale = QLocale();
+	if (!MessageSeconds()) {
+		return locale.toString(time, QLocale::ShortFormat);
+	}
+	return locale.toString(
+		time,
+		WithSeconds(locale.timeFormat(QLocale::ShortFormat)));
+}
+
+QString FormatMessageSavedFromDate(const QDateTime &dateTime) {
+	if (!MessageSeconds()) {
+		return Ui::FormatDateTimeSavedFrom(dateTime);
+	}
+	const auto current = QDate::currentDate();
+	const auto date = dateTime.date();
+	const auto time = FormatMessageTime(dateTime.time());
+	if (date == current) {
+		return tr::lng_mediaview_today(tr::now, lt_time, time);
+	} else if (date == current.addDays(-1)) {
+		return tr::lng_mediaview_yesterday(tr::now, lt_time, time);
+	}
+	const auto diff = std::abs(
+		base::unixtime::now() - base::unixtime::serialize(dateTime));
+	const auto day = (diff < kSecondsInYear)
+		? tr::lng_month_day(
+			tr::now,
+			lt_month,
+			Lang::MonthSmall(date.month())(tr::now),
+			lt_day,
+			QString::number(date.day()))
+		: langDayOfMonthFull(date);
+	return tr::lng_mediaview_date_time(
+		tr::now,
+		lt_date,
+		day,
+		lt_time,
+		time);
+}
+
+} // namespace Tele
