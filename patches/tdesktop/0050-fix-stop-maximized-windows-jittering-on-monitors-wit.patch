From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: nitreojs <hello@starkow.dev>
Date: Sun, 27 Sep 2026 06:28:14 +0300
Subject: [PATCH] fix: stop maximized windows jittering on monitors without a
 taskbar

---
 Telegram/SourceFiles/platform/win/integration_win.cpp | 8 +++++++-
 1 file changed, 7 insertions(+), 1 deletion(-)

diff --git a/Telegram/SourceFiles/platform/win/integration_win.cpp b/Telegram/SourceFiles/platform/win/integration_win.cpp
index 5e2e57d53bbbb61e903be26c77a57bcea9e00875..665181a967f14f2b36c8ab8b7dc7e22c976539e5 100644
--- a/Telegram/SourceFiles/platform/win/integration_win.cpp
+++ b/Telegram/SourceFiles/platform/win/integration_win.cpp
@@ -25,6 +25,10 @@ https://github.com/telegramdesktop/tdesktop/blob/master/LEGAL
 #include <QtCore/QAbstractNativeEventFilter>
 #include <private/qguiapplication_p.h>
 
+#if QT_VERSION < QT_VERSION_CHECK(6, 0, 0)
+#include <QtPlatformHeaders/QWindowsWindowFunctions>
+#endif // Qt < 6.0.0
+
 #include <propvarutil.h>
 #include <propkey.h>
 
@@ -37,7 +41,9 @@ void WindowsIntegration::init() {
 	if (native) {
 		native->setHasBorderInFullScreenDefault(true);
 	}
-#endif // Qt >= 6.5.0
+#elif QT_VERSION < QT_VERSION_CHECK(6, 0, 0)
+	QWindowsWindowFunctions::setHasBorderInFullScreenDefault(true);
+#endif // Qt >= 6.5.0 || Qt < 6.0.0
 	QCoreApplication::instance()->installNativeEventFilter(this);
 	_taskbarCreatedMsgId = RegisterWindowMessage(L"TaskbarButtonCreated");
 }
