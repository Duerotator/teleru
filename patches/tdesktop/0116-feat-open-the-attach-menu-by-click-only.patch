From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: nitreojs <hello@starkow.dev>
Date: Mon, 28 Sep 2026 02:23:36 +0300
Subject: [PATCH] feat: open the attach menu by click only

---
 Telegram/SourceFiles/history/history_widget.cpp      |  5 +++--
 .../view/controls/history_view_compose_controls.cpp  |  3 ++-
 Telegram/SourceFiles/settings/settings_tele.cpp      |  1 +
 Telegram/SourceFiles/tele/tele_emoji_panel.cpp       |  4 ++++
 Telegram/SourceFiles/tele/tele_emoji_panel.h         |  1 +
 Telegram/SourceFiles/tele/tele_options.cpp           | 12 ++++++++++++
 Telegram/SourceFiles/tele/tele_options.h             |  2 ++
 7 files changed, 25 insertions(+), 3 deletions(-)

diff --git a/Telegram/SourceFiles/history/history_widget.cpp b/Telegram/SourceFiles/history/history_widget.cpp
index 20b6e212a13f89d9d10476fbdc0fc9fcfa41f4df..ab7d1846bee32b5536a465b5a46db688b957b471 100644
--- a/Telegram/SourceFiles/history/history_widget.cpp
+++ b/Telegram/SourceFiles/history/history_widget.cpp
@@ -172,6 +172,7 @@ https://github.com/telegramdesktop/tdesktop/blob/master/LEGAL
 #include "tele/tele_ghost.h"
 #include "tele/tele_shortcuts.h"
 #include "tele/tele_deleted_reply.h"
+#include "tele/tele_emoji_panel.h"
 #include "media/audio/media_audio.h"
 #include "media/audio/media_audio_capture.h"
 #include "media/player/media_player_instance.h"
@@ -3541,7 +3542,7 @@ void HistoryWidget::setHistory(History *history) {
 	if (was && !now) {
 		_attachToggle->removeEventFilter(_attachBotsMenu.get());
 		_attachBotsMenu->hideFast();
-	} else if (now && !was && !ChatHelpers::ShowPanelOnClick()) {
+	} else if (now && !was && Tele::AttachMenuOnHover()) {
 		_attachToggle->installEventFilter(_attachBotsMenu.get());
 	}
 
@@ -3643,7 +3644,7 @@ void HistoryWidget::refreshAttachBotsMenu() {
 	}
 	_attachBotsMenu->setOrigin(
 		Ui::PanelAnimation::Origin::BottomLeft);
-	if (!ChatHelpers::ShowPanelOnClick()) {
+	if (Tele::AttachMenuOnHover()) {
 		_attachToggle->installEventFilter(_attachBotsMenu.get());
 	}
 	_attachBotsMenu->heightValue(
diff --git a/Telegram/SourceFiles/history/view/controls/history_view_compose_controls.cpp b/Telegram/SourceFiles/history/view/controls/history_view_compose_controls.cpp
index a42de883724ee3c39219ffe9a0dc9009f8e30170..607a4f0227f08dda41f8f1534f8311efcc89e62b 100644
--- a/Telegram/SourceFiles/history/view/controls/history_view_compose_controls.cpp
+++ b/Telegram/SourceFiles/history/view/controls/history_view_compose_controls.cpp
@@ -112,6 +112,7 @@ https://github.com/telegramdesktop/tdesktop/blob/master/LEGAL
 #include "support/support_common.h"
 #include "tele/tele_calcmula_preview.h"
 #include "tele/tele_deleted_reply.h"
+#include "tele/tele_emoji_panel.h"
 #include "support/support_helper.h"
 #include "ui/item_text_options.h"
 #include "ui/text/text_options.h"
@@ -5615,7 +5616,7 @@ void ComposeControls::updateAttachBotsMenu() {
 	}
 	_attachBotsMenu->setOrigin(
 		Ui::PanelAnimation::Origin::BottomLeft);
-	if (!ChatHelpers::ShowPanelOnClick()) {
+	if (Tele::AttachMenuOnHover()) {
 		_attachToggle->installEventFilter(_attachBotsMenu.get());
 	}
 	_attachBotsMenu->heightValue(
diff --git a/Telegram/SourceFiles/settings/settings_tele.cpp b/Telegram/SourceFiles/settings/settings_tele.cpp
index 9307f7b64a77d66e12cc89661b5251322e0a315b..4f4183002d45b92e0950971396e174b84243ded7 100644
--- a/Telegram/SourceFiles/settings/settings_tele.cpp
+++ b/Telegram/SourceFiles/settings/settings_tele.cpp
@@ -1449,6 +1449,7 @@ void FillInterface(SectionBuilder &builder) {
 	AddOptionToggle(builder, ::Tele::kOptionHideMentionsButton);
 	AddOptionToggle(builder, ::Tele::kOptionHideReactionsButton);
 	AddOptionToggle(builder, ::Tele::kOptionEmojiPanelClick);
+	AddOptionToggle(builder, ::Tele::kOptionAttachMenuClick);
 	AddCallButtons(builder);
 	AddGroupDivider(builder);
 	AddGroupTitle(builder, u"Text"_q);
diff --git a/Telegram/SourceFiles/tele/tele_emoji_panel.cpp b/Telegram/SourceFiles/tele/tele_emoji_panel.cpp
index 98b2d1464c4bffcab263dfcaf3ce5b03452a3a9f..bad34c4634cf6264356be5003f2ba632e1c5858d 100644
--- a/Telegram/SourceFiles/tele/tele_emoji_panel.cpp
+++ b/Telegram/SourceFiles/tele/tele_emoji_panel.cpp
@@ -134,4 +134,8 @@ bool EmojiPanelKeepsOpen(not_null<ChatHelpers::TabbedPanel*> panel) {
 	return EmojiPanelClick() && Panels.contains(panel);
 }
 
+bool AttachMenuOnHover() {
+	return !ChatHelpers::ShowPanelOnClick() && !AttachMenuClick();
+}
+
 } // namespace Tele
diff --git a/Telegram/SourceFiles/tele/tele_emoji_panel.h b/Telegram/SourceFiles/tele/tele_emoji_panel.h
index 0e224ebe3c4fc98107ea1c889c92c3c74db8456f..dc42a527d85897ee17bb212860730b76f25c3a4b 100644
--- a/Telegram/SourceFiles/tele/tele_emoji_panel.h
+++ b/Telegram/SourceFiles/tele/tele_emoji_panel.h
@@ -11,5 +11,6 @@ namespace Tele {
 	QObject *toggle);
 [[nodiscard]] bool EmojiPanelKeepsOpen(
 	not_null<ChatHelpers::TabbedPanel*> panel);
+[[nodiscard]] bool AttachMenuOnHover();
 
 } // namespace Tele
diff --git a/Telegram/SourceFiles/tele/tele_options.cpp b/Telegram/SourceFiles/tele/tele_options.cpp
index 71775d8faf789f17317b45befda8feffc72006b0..8e40a2637f0d1cedf5b6bda6de458f2061430f90 100644
--- a/Telegram/SourceFiles/tele/tele_options.cpp
+++ b/Telegram/SourceFiles/tele/tele_options.cpp
@@ -39,6 +39,7 @@ const char kOptionStaticUserpicsChats[] = "tele-static-userpics-chats";
 const char kOptionHideMentionsButton[] = "tele-hide-mentions-button";
 const char kOptionHideReactionsButton[] = "tele-hide-reactions-button";
 const char kOptionEmojiPanelClick[] = "tele-emoji-panel-click";
+const char kOptionAttachMenuClick[] = "tele-attach-menu-click";
 const char kOptionShowGiftIds[] = "tele-show-gift-ids";
 const char kOptionShowRegularGiftIds[] = "tele-show-regular-gift-ids";
 const char kOptionSeeTgButton[] = "tele-seetg-button";
@@ -302,6 +303,13 @@ base::options::toggle EmojiPanelClickOption({
 	.description = "Hovering the emoji button no longer opens stickers and GIFs.",
 });
 
+base::options::toggle AttachMenuClickOption({
+	.id = kOptionAttachMenuClick,
+	.name = "Open the attach menu by click only",
+	.description = "Hovering the paperclip no longer opens the attach menu. "
+		"Applies to chats you open after switching it.",
+});
+
 base::options::toggle ShowGiftIdsOption({
 	.id = kOptionShowGiftIds,
 	.name = "Show gift IDs",
@@ -779,6 +787,10 @@ bool EmojiPanelClick() {
 	return EmojiPanelClickOption.value();
 }
 
+bool AttachMenuClick() {
+	return AttachMenuClickOption.value();
+}
+
 bool ShowGiftIds() {
 	return ShowGiftIdsOption.value();
 }
diff --git a/Telegram/SourceFiles/tele/tele_options.h b/Telegram/SourceFiles/tele/tele_options.h
index 857e86d94ab6e04a9e6eb26ae006c4e9ce2f43ef..9cc22d713288257d41beb39d3ac49371f43ca8d8 100644
--- a/Telegram/SourceFiles/tele/tele_options.h
+++ b/Telegram/SourceFiles/tele/tele_options.h
@@ -36,6 +36,7 @@ extern const char kOptionStaticUserpicsChats[];
 extern const char kOptionHideMentionsButton[];
 extern const char kOptionHideReactionsButton[];
 extern const char kOptionEmojiPanelClick[];
+extern const char kOptionAttachMenuClick[];
 extern const char kOptionShowGiftIds[];
 extern const char kOptionShowRegularGiftIds[];
 extern const char kOptionSeeTgButton[];
@@ -122,6 +123,7 @@ void SetGroupCallButton(const QString &value);
 [[nodiscard]] bool HideReactionsButton();
 [[nodiscard]] rpl::producer<> HideReactionsButtonChanges();
 [[nodiscard]] bool EmojiPanelClick();
+[[nodiscard]] bool AttachMenuClick();
 [[nodiscard]] bool ShowGiftIds();
 [[nodiscard]] bool ShowRegularGiftIds();
 [[nodiscard]] bool SeeTgButton();
