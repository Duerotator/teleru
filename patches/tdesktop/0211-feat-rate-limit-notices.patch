+void Instance::Private::teleFloodEvent(
+		mtpRequestId requestId,
+		int seconds,
+		bool resent) {
+	if (!requestId || seconds < 0) {
+		return;
+	}
+	auto request = mtpTypeId(0);
+	{
+		QReadLocker locker(&_requestMapLock);
+		const auto i = _requestMap.find(requestId);
+		if (i != _requestMap.cend()
+			&& i->second
+			&& (i->second->size()
+				> SerializedRequest::kMessageBodyPosition)) {
+			request = mtpTypeId((*i->second)[
+				SerializedRequest::kMessageBodyPosition]);
+		}
+	}
+	_teleFloodWaits.fire({
+		.requestId = requestId,
+		.request = request,
+		.seconds = seconds,
+		.resent = resent,
+	});
+}
