 	AddOptionToggle(content, controller(), ::Tele::kOptionGhostTyping);
 	AddOptionToggle(content, controller(), ::Tele::kOptionGhostOnline);
 	AddOptionToggle(content, controller(), ::Tele::kOptionGhostStories);
