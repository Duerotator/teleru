+bool PaintShotIcon(
+		QPainter &p,
+		const style::icon &icon,
+		QPoint position,
+		int outerw) {
+	const auto ratio = ShotSharpRatio();
+	const auto data = ratio ? (icon.*Exposed(IconDataTag())) : nullptr;
+	if (!data) {
+		return false;
+	}
+	const auto &parts = data->*Exposed(IconPartsTag());
+	auto images = std::vector<QImage>();
+	images.reserve(parts.size());
+	for (const auto &part : parts) {
+		images.push_back(IconImage(part, style::Scale() * ratio));
+		if (images.back().isNull()) {
+			return false;
+		}
+	}
+	auto hq = PainterHighQualityEnabler(p);
+	for (auto i = 0; i != int(parts.size()); ++i) {
+		const auto &part = parts[i];
+		const auto padding = part.*Exposed(IconPaddingTag());
+		const auto size = QSizeF(images[i].size()) / ratio;
+		const auto x = rtl()
+			? (outerw - position.x() - part.width() + padding.right())
+			: (position.x() + padding.left());
+		p.drawImage(
+			QRectF(QPointF(x, position.y() + padding.top()), size),
+			images[i]);
+	}
+	return true;
+}
+
+bool PaintShotSticker(
+		QPainter &p,
+		not_null<DocumentData*> document,
+		QRect rect,
+		QSize size,
+		QColor colored,
+		bool mirror) {
+	const auto ratio = ShotSharpRatio();
+	if (!ratio || size.isEmpty()) {
+		return false;
+	}
+	const auto media = document->activeMediaView();
+	const auto side = std::max(size.width(), size.height());
+	auto frame = RenderFrame(document, media, side * ratio);
+	if (frame.isNull()) {
+		return false;
+	}
+	if (colored.alpha() > 0) {
+		frame = Colorized(frame, colored);
+	}
+	const auto target = QRect(
+		rect.x() + (rect.width() - side) / 2,
+		rect.y() + (rect.height() - side) / 2,
+		side,
+		side);
+	auto hq = PainterHighQualityEnabler(p);
+	if (mirror) {
+		p.save();
+		const auto middle = QPointF(target.center()) + QPointF(0.5, 0.5);
+		p.translate(middle);
+		p.scale(-1., 1.);
+		p.translate(-middle);
+		p.drawImage(target, frame);
+		p.restore();
+	} else {
+		p.drawImage(target, frame);
+	}
+	return true;
+}
+
+std::unique_ptr<Ui::Text::CustomEmoji> WrapShotEmoji(
+		std::unique_ptr<Ui::Text::CustomEmoji> emoji,
+		not_null<Data::Session*> owner,
+		uint64 documentId,
+		int frameSize) {
+	if (!Current().emojiScopes) {
+		return emoji;
+	}
+	return std::make_unique<ShotEmoji>(
+		std::move(emoji),
+		owner->document(documentId),
+		frameSize / style::DevicePixelRatio());
+}
+
+} // namespace Tele
