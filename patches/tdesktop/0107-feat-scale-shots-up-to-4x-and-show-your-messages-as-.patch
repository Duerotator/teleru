+using style::internal::Color;
+using style::internal::IconData;
+using style::internal::IconMask;
+using style::internal::MonoIcon;
+
+template <typename Tag, typename Tag::Type Member>
+struct Expose {
+	friend typename Tag::Type Exposed(Tag) {
+		return Member;
+	}
+};
+
+struct IconDataTag {
+	using Type = IconData *style::internal::Icon::*;
+	friend Type Exposed(IconDataTag);
+};
+struct IconPartsTag {
+	using Type = std::vector<MonoIcon> IconData::*;
+	friend Type Exposed(IconPartsTag);
+};
+struct IconMaskTag {
+	using Type = const IconMask *MonoIcon::*;
+	friend Type Exposed(IconMaskTag);
+};
+struct IconColorTag {
+	using Type = Color MonoIcon::*;
+	friend Type Exposed(IconColorTag);
+};
+struct IconPaddingTag {
+	using Type = QMargins MonoIcon::*;
+	friend Type Exposed(IconPaddingTag);
+};
+
+template struct Expose<IconDataTag, &style::internal::Icon::_data>;
+template struct Expose<IconPartsTag, &IconData::_parts>;
+template struct Expose<IconMaskTag, &MonoIcon::_mask>;
+template struct Expose<IconColorTag, &MonoIcon::_color>;
+template struct Expose<IconPaddingTag, &MonoIcon::_padding>;
+
+struct IconKey {
+	const IconMask *mask = nullptr;
+	QRgb color = 0;
+	int scale = 0;
+
+	friend inline auto operator<=>(const IconKey &, const IconKey &)
+		= default;
+	friend inline bool operator==(const IconKey &, const IconKey &)
+		= default;
+};
+
+struct State {
+	int ratio = 0;
+	int emojiScopes = 0;
+	base::flat_map<IconKey, QImage> icons;
+	base::flat_map<std::pair<uint64, int>, QImage> frames;
+};
+
+[[nodiscard]] State &Current() {
+	static auto result = State();
+	return result;
+}
+
+[[nodiscard]] QImage IconImage(
+		const MonoIcon &part,
+		int scale) {
+	const auto mask = part.*Exposed(IconMaskTag());
+	const auto &color = part.*Exposed(IconColorTag());
+	if (!mask || !color) {
+		return QImage();
+	}
+	const auto key = IconKey{
+		.mask = mask,
+		.color = color->c.rgba(),
+		.scale = scale,
+	};
+	auto &icons = Current().icons;
+	if (const auto i = icons.find(key); i != end(icons)) {
+		return i->second;
+	}
+	const auto plain = MonoIcon(mask, color, QMargins());
+	return icons.emplace(key, plain.instance(color->c, scale, true))
+		.first->second;
+}
+
+[[nodiscard]] QImage RenderFrame(
+		not_null<DocumentData*> document,
+		const std::shared_ptr<Data::DocumentMedia> &media,
+		int size) {
+	const auto sticker = document->sticker();
+	if (!sticker || !media || !media->loaded()) {
+		return QImage();
+	}
+	const auto key = std::make_pair(uint64(document->id), size);
+	auto &frames = Current().frames;
+	if (const auto i = frames.find(key); i != end(frames)) {
+		return i->second;
+	}
+	const auto bytes = Lottie::ReadContent(
+		media->bytes(),
+		document->filepath());
+	if (bytes.isEmpty()) {
+		return QImage();
+	}
+	auto generator = std::unique_ptr<Ui::FrameGenerator>();
+	switch (sticker->type) {
+	case StickerType::Tgs:
+		generator = std::make_unique<Lottie::FrameGenerator>(bytes);
+		break;
+	case StickerType::Webm:
+		generator = std::make_unique<FFmpeg::FrameGenerator>(bytes);
+		break;
+	case StickerType::Webp:
+		generator = std::make_unique<Ui::ImageFrameGenerator>(bytes);
+		break;
+	}
+	if (!generator) {
+		return QImage();
+	}
+	auto frame = generator->renderNext(
+		QImage(),
+		QSize(size, size),
+		Qt::KeepAspectRatio);
+	return frames.emplace(key, std::move(frame.image)).first->second;
+}
+
+[[nodiscard]] QImage Colorized(const QImage &image, QColor color) {
+	auto result = QImage(image.size(), QImage::Format_ARGB32_Premultiplied);
+	style::colorizeImage(image, color, &result, QRect(), QPoint(), true);
+	return result;
+}
+
+[[nodiscard]] std::shared_ptr<Data::DocumentMedia> LoadMedia(
+		not_null<DocumentData*> document) {
+	if (OfflineForLaunch() || !document->sticker()) {
+		return nullptr;
+	}
+	auto result = document->createMediaView();
+	result->checkStickerLarge();
+	return result;
+}
