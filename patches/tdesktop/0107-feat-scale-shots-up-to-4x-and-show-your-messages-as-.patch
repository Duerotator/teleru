+} // namespace
+
+int ShotSharpRatio() {
+	const auto ratio = Current().ratio;
+	return (ratio > style::DevicePixelRatio()) ? ratio : 0;
+}
+
+ShotSharpScope::ShotSharpScope(int ratio)
+: _was(Current().ratio) {
+	Current().ratio = ratio;
+}
+
+ShotSharpScope::~ShotSharpScope() {
+	auto &current = Current();
+	current.ratio = _was;
+	if (!_was) {
+		current.icons.clear();
+		current.frames.clear();
+	}
+}
+
+ShotEmojiScope::ShotEmojiScope() {
+	++Current().emojiScopes;
+}
+
+ShotEmojiScope::~ShotEmojiScope() {
+	--Current().emojiScopes;
+}
