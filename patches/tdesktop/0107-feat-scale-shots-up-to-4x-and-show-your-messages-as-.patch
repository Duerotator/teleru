+[[nodiscard]] Ui::CornersPixmaps PrepareCorners(
+		int radius,
+		const style::color &bg,
+		const style::color *shadow,
+		int ratio) {
+	const auto r = radius * ratio;
+	const auto s = shadow ? (st::msgShadow * ratio) : 0;
+	auto image = QImage(r * 3, r * 3 + s, QImage::Format_ARGB32_Premultiplied);
+	image.fill(Qt::transparent);
+	{
+		auto p = QPainter(&image);
+		auto hq = PainterHighQualityEnabler(p);
+		p.setCompositionMode(QPainter::CompositionMode_Source);
+		p.setPen(Qt::NoPen);
+		if (shadow) {
+			p.setBrush((*shadow)->b);
+			p.drawRoundedRect(0, s, r * 3, r * 3, r, r);
+		}
+		p.setBrush(bg->b);
+		p.drawRoundedRect(0, 0, r * 3, r * 3, r, r);
+	}
+	const auto parts = std::array{
+		QRect(0, 0, r, r),
+		QRect(r * 2, 0, r, r),
+		QRect(0, r * 2, r, r + s),
+		QRect(r * 2, r * 2, r, r + s),
+	};
+	auto result = Ui::CornersPixmaps();
+	for (auto i = 0; i != 4; ++i) {
+		result.p[i] = Ui::PixmapFromImage(image.copy(parts[i]));
+		result.p[i].setDevicePixelRatio(ratio);
+	}
+	return result;
+}
+
+void ValidateCorners(
+		Ui::CornersPixmaps &corners,
+		int radius,
+		const style::color &bg,
+		const style::color *shadow,
+		int ratio) {
+	if (corners.p[0].isNull() || corners.p[0].devicePixelRatio() != ratio) {
+		corners = PrepareCorners(radius, bg, shadow, ratio);
+	}
+}
