From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: nitreojs <hello@starkow.dev>
Date: Sat, 26 Sep 2026 23:33:38 +0300
Subject: [PATCH] feat: give linux and macos builds their own identity

---
 Telegram/CMakeLists.txt                       |  4 +--
 Telegram/SourceFiles/core/launcher.cpp        |  2 +-
 .../platform/linux/specific_linux.cpp         | 34 ++-----------------
 lib/xdg/org.telegram.desktop.desktop          |  8 ++---
 4 files changed, 10 insertions(+), 38 deletions(-)

diff --git a/Telegram/CMakeLists.txt b/Telegram/CMakeLists.txt
index 56fe1df41bbfa56b356d4647084e40973a7122a8..5081915924a6c425534f43f6a46ef2cfa2a5d0f6 100644
--- a/Telegram/CMakeLists.txt
+++ b/Telegram/CMakeLists.txt
@@ -2415,9 +2415,9 @@ if (build_macstore)
     )
 else()
     if (CMAKE_GENERATOR STREQUAL Xcode)
-        set(bundle_identifier "com.tdesktop.Telegram$<$<CONFIG:Debug>:Debug>")
+        set(bundle_identifier "dev.starkow.tele$<$<CONFIG:Debug>:Debug>")
     else()
-        set(bundle_identifier "com.tdesktop.Telegram")
+        set(bundle_identifier "dev.starkow.tele")
     endif()
     set(bundle_entitlements "Telegram.entitlements")
     set(output_name "tele")
diff --git a/Telegram/SourceFiles/core/launcher.cpp b/Telegram/SourceFiles/core/launcher.cpp
index b3b76e088fb5ded83299fe1ae47c5ee5dd7e1a62..7677c37c482a6678b9a995983bbbec0cdefcb109 100644
--- a/Telegram/SourceFiles/core/launcher.cpp
+++ b/Telegram/SourceFiles/core/launcher.cpp
@@ -340,7 +340,7 @@ void Launcher::init() {
 	prepareSettings();
 	initQtMessageLogging();
 
-	QApplication::setApplicationName(u"TelegramDesktop"_q);
+	QApplication::setApplicationName(u"tele"_q);
 
 #if QT_VERSION < QT_VERSION_CHECK(6, 0, 0)
 	// fallback session management is useless for tdesktop since it doesn't have
diff --git a/Telegram/SourceFiles/platform/linux/specific_linux.cpp b/Telegram/SourceFiles/platform/linux/specific_linux.cpp
index e9f4e5b07e3a00e97b7b6adf5156e1284340cc15..af4df7617d8c8fe86cd59c231fa6640ec2918ced 100644
--- a/Telegram/SourceFiles/platform/linux/specific_linux.cpp
+++ b/Telegram/SourceFiles/platform/linux/specific_linux.cpp
@@ -468,9 +468,8 @@ void InstallLauncher() {
 	static const auto DisabledByEnv = !qEnvironmentVariableIsEmpty(
 		"DESKTOPINTEGRATION");
 
-	// don't update desktop file for alpha version or if updater is disabled
+	// don't update desktop file for alpha version
 	if (cAlphaVersion()
-			|| Core::UpdaterDisabled()
 			|| KSandbox::isInside()
 			|| DisabledByEnv) {
 		return;
@@ -670,35 +669,12 @@ bool SkipTaskbarSupported() {
 }
 
 QString ExecutablePathForShortcuts() {
-	if (Core::UpdaterDisabled()) {
-		const auto &arguments = Core::Launcher::Instance().arguments();
-		if (!arguments.isEmpty()) {
-			const auto result = QFileInfo(arguments.first()).fileName();
-			if (!result.isEmpty()) {
-				return result;
-			}
-		}
-		return cExeName();
-	}
 	return cExeDir() + cExeName();
 }
 
 } // namespace Platform
 
 QString psAppDataPath() {
-	// Previously we used ~/.TelegramDesktop, so look there first.
-	// If we find data there, we should still use it.
-	auto home = QDir::homePath();
-	if (!home.isEmpty()) {
-		auto oldPath = home + u"/.TelegramDesktop/"_q;
-		auto oldSettingsBase = oldPath + u"tdata/settings"_q;
-		if (QFile::exists(oldSettingsBase + '0')
-			|| QFile::exists(oldSettingsBase + '1')
-			|| QFile::exists(oldSettingsBase + 's')) {
-			return oldPath;
-		}
-	}
-
 	return QStandardPaths::writableLocation(QStandardPaths::AppLocalDataLocation) + '/';
 }
 
@@ -737,12 +713,8 @@ void start() {
 				+ cExeName();
 		}
 
-		if (!Core::UpdaterDisabled()) {
-			return u"org.telegram.desktop._%1"_q.arg(
-				Core::Launcher::Instance().instanceHash().constData());
-		}
-
-		return u"org.telegram.desktop"_q;
+		return u"dev.starkow.tele._%1"_q.arg(
+			Core::Launcher::Instance().instanceHash().constData());
 	}());
 
 	LOG(("App ID: %1").arg(QGuiApplication::desktopFileName()));
diff --git a/lib/xdg/org.telegram.desktop.desktop b/lib/xdg/org.telegram.desktop.desktop
index 73ca5cc2d5ff19e24d694953c03edf381d9a6468..9a48182e92ffe6b313397c9874adbc032c51e4c5 100644
--- a/lib/xdg/org.telegram.desktop.desktop
+++ b/lib/xdg/org.telegram.desktop.desktop
@@ -1,11 +1,11 @@
 [Desktop Entry]
-Name=Telegram
+Name=tele
 Comment=New era of messaging
 TryExec=Telegram
 Exec=Telegram -- %U
-Icon=org.telegram.desktop
+Icon=dev.starkow.tele
 Terminal=false
-StartupWMClass=TelegramDesktop
+StartupWMClass=tele
 Type=Application
 Categories=Chat;Network;InstantMessaging;Qt;
 MimeType=x-scheme-handler/tg;x-scheme-handler/tonsite;
@@ -18,5 +18,5 @@ X-GNOME-SingleWindow=true
 
 [Desktop Action quit]
 Exec=Telegram -quit
-Name=Quit Telegram
+Name=Quit tele
 Icon=application-exit
