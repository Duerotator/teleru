@@ -0,0 +1,286 @@
+#include "tele/tele_punctual_scheduled.h"
+
+#include "api/api_common.h"
+#include "apiwrap.h"
+#include "base/timer.h"
+#include "base/unixtime.h"
+#include "data/components/scheduled_messages.h"
+#include "data/data_chat_participant_status.h"
+#include "data/data_peer.h"
+#include "data/data_session.h"
+#include "dialogs/dialogs_indexed_list.h"
+#include "dialogs/dialogs_main_list.h"
+#include "history/history.h"
+#include "history/history_item.h"
+#include "history/history_item_components.h"
+#include "main/main_session.h"
+#include "mtproto/sender.h"
+#include "tele/tele_options.h"
+
+namespace Tele {
+namespace {
+
+constexpr auto kMaxWait = crl::time(60000);
+constexpr auto kWakeGap = TimeId(30);
+constexpr auto kWakeHold = crl::time(5000);
+constexpr auto kResweepGap = TimeId(1800);
+constexpr auto kSweepDelay = crl::time(15000);
+constexpr auto kSweepFastCount = 100;
+constexpr auto kSweepFastInterval = crl::time(1000);
+constexpr auto kSweepSlowInterval = crl::time(3000);
+
+void Load(not_null<History*> history) {
+	(void)history->session().scheduledMessages().updates(history);
+}
+
+class Punctual final {
+public:
+	explicit Punctual(not_null<Main::Session*> session);
+
+private:
+	void refresh();
+	void check();
+	void woke(TimeId gap);
+	void send(
+		not_null<History*> history,
+		std::vector<not_null<HistoryItem*>> items);
+	void request(
+		not_null<PeerData*> peer,
+		QVector<MTPint> ids,
+		bool split);
+	void sweep();
+	void scheduleSweep(crl::time delay);
+	[[nodiscard]] History *nextToSweep();
+	[[nodiscard]] bool eligible(not_null<HistoryItem*> item) const;
+
+	const not_null<Main::Session*> _session;
+	MTP::Sender _api;
+	base::Timer _timer;
+	base::Timer _sweepTimer;
+	base::flat_set<PeerId> _tracked;
+	base::flat_set<PeerId> _swept;
+	base::flat_map<FullMsgId, TimeId> _attempted;
+	TimeId _expected = 0;
+	TimeId _sweepStarted = 0;
+	crl::time _holdUntil = 0;
+	bool _enabled = false;
+	rpl::lifetime _lifetime;
+
+};
+
+Punctual::Punctual(not_null<Main::Session*> session)
+: _session(session)
+, _api(&session->mtp())
+, _timer([=] { check(); })
+, _sweepTimer([=] { sweep(); }) {
+	_session->scheduledMessages().allUpdates(
+	) | rpl::on_next([=](not_null<History*> history) {
+		_tracked.emplace(history->peer->id);
+		if (_enabled) {
+			_timer.callOnce(0);
+		}
+	}, _lifetime);
+
+	rpl::merge(
+		_session->data().chatsListChanges() | rpl::to_empty,
+		_session->data().chatsListLoadedEvents() | rpl::to_empty
+	) | rpl::filter([=] {
+		return _enabled && _sweepStarted && !_sweepTimer.isActive();
+	}) | rpl::on_next([=] {
+		scheduleSweep(kSweepFastInterval);
+	}, _lifetime);
+
+	PunctualScheduledChanges(
+	) | rpl::on_next([=] {
+		refresh();
+	}, _lifetime);
+	refresh();
+}
+
+void Punctual::refresh() {
+	_enabled = PunctualScheduled();
+	_expected = 0;
+	if (!_enabled) {
+		_timer.cancel();
+		_sweepTimer.cancel();
+		return;
+	}
+	if (!_sweepStarted) {
+		_sweepStarted = base::unixtime::now();
+		scheduleSweep(kSweepDelay);
+	} else {
+		scheduleSweep(kSweepFastInterval);
+	}
+	check();
+}
+
+void Punctual::check() {
+	if (!_enabled) {
+		return;
+	}
+	const auto now = base::unixtime::now();
+	if (_expected && now - _expected > kWakeGap) {
+		woke(now - _expected);
+	}
+	const auto hold = _holdUntil - crl::now();
+	if (hold > 0) {
+		_expected = now + TimeId(hold / 1000) + 1;
+		_timer.callOnce(hold);
+		return;
+	}
+	auto &scheduled = _session->scheduledMessages();
+	auto &owner = _session->data();
+	auto due = base::flat_map<
+		not_null<History*>,
+		std::vector<not_null<HistoryItem*>>>();
+	auto earliest = TimeId(0);
+	for (auto i = begin(_tracked); i != end(_tracked);) {
+		const auto history = owner.historyLoaded(*i);
+		if (!history || !scheduled.count(history)) {
+			i = _tracked.erase(i);
+			continue;
+		}
+		for (const auto &id : scheduled.list(history).ids) {
+			const auto item = owner.message(id);
+			if (!item || !eligible(item)) {
+				continue;
+			}
+			const auto date = item->date();
+			if (date <= now) {
+				due[history].push_back(item);
+			} else if (!earliest || date < earliest) {
+				earliest = date;
+			}
+		}
+		++i;
+	}
+	for (auto i = begin(_attempted); i != end(_attempted);) {
+		if (owner.message(i->first)) {
+			++i;
+		} else {
+			i = _attempted.erase(i);
+		}
+	}
+	for (auto &[history, items] : due) {
+		send(history, std::move(items));
+	}
+	const auto wait = earliest
+		? std::min(crl::time(earliest - now) * 1000, kMaxWait)
+		: kMaxWait;
+	_expected = now + TimeId(wait / 1000);
+	_timer.callOnce(wait);
+}
+
+void Punctual::woke(TimeId gap) {
+	DEBUG_LOG(("Tele Punctual: woke after %1 seconds.").arg(gap));
+	for (const auto &peerId : _tracked) {
+		if (const auto history = _session->data().historyLoaded(peerId)) {
+			Load(history);
+		}
+	}
+	_holdUntil = crl::now() + kWakeHold;
+	const auto now = base::unixtime::now();
+	if (gap >= kResweepGap && now - _sweepStarted >= kResweepGap) {
+		_swept.clear();
+		_sweepStarted = now;
+		scheduleSweep(kWakeHold);
+	}
+}
+
+bool Punctual::eligible(not_null<HistoryItem*> item) const {
+	if (!item->allowsSendNow()
+		|| item->isUploading()
+		|| item->awaitingVideoProcessing()
+		|| item->scheduleRepeatPeriod()
+		|| item->Get<HistoryMessageSuggestion>()
+		|| item->date() == Api::kScheduledUntilOnlineTimestamp) {
+		return false;
+	}
+	const auto i = _attempted.find(item->fullId());
+	return (i == end(_attempted)) || (i->second != item->date());
+}
+
+void Punctual::send(
+		not_null<History*> history,
+		std::vector<not_null<HistoryItem*>> items) {
+	ranges::sort(items, ranges::less(), &HistoryItem::date);
+	auto &scheduled = _session->scheduledMessages();
+	auto ids = QVector<MTPint>();
+	ids.reserve(items.size());
+	for (const auto &item : items) {
+		_attempted[item->fullId()] = item->date();
+		ids.push_back(MTP_int(scheduled.lookupId(item)));
+	}
+	request(history->peer, std::move(ids), true);
+}
+
+void Punctual::request(
+		not_null<PeerData*> peer,
+		QVector<MTPint> ids,
+		bool split) {
+	_api.request(MTPmessages_SendScheduledMessages(
+		peer->input(),
+		MTP_vector<MTPint>(ids)
+	)).done([=](const MTPUpdates &result) {
+		_session->api().applyUpdates(result);
+	}).fail([=](const MTP::Error &error) {
+		LOG(("Tele Punctual: could not send %1 scheduled to %2: %3."
+			).arg(ids.size()
+			).arg(peer->id.value
+			).arg(error.type()));
+		if (split && ids.size() > 1) {
+			for (const auto &id : ids) {
+				request(peer, { id }, false);
+			}
+		}
+	}).send();
+}
+
+void Punctual::scheduleSweep(crl::time delay) {
+	if (!_sweepTimer.isActive() || _sweepTimer.remainingTime() > delay) {
+		_sweepTimer.callOnce(delay);
+	}
+}
+
+History *Punctual::nextToSweep() {
+	const auto self = _session->data().history(_session->userPeerId());
+	if (!_swept.contains(self->peer->id)) {
+		return self;
+	}
+	const auto &scheduled = _session->scheduledMessages();
+	for (const auto &row : *_session->data().chatsList()->indexed()) {
+		const auto history = row->history();
+		if (!history || _swept.contains(history->peer->id)) {
+			continue;
+		} else if (scheduled.count(history)
+			|| !Data::CanSendAnything(history->peer, false)) {
+			_swept.emplace(history->peer->id);
+			continue;
+		}
+		return history;
+	}
+	return nullptr;
+}
+
+void Punctual::sweep() {
+	if (!_enabled) {
+		return;
+	}
+	const auto history = nextToSweep();
+	if (!history) {
+		return;
+	}
+	_swept.emplace(history->peer->id);
+	Load(history);
+	_sweepTimer.callOnce((int(_swept.size()) < kSweepFastCount)
+		? kSweepFastInterval
+		: kSweepSlowInterval);
+}
+
+} // namespace
+
+void SetupPunctualScheduled(not_null<Main::Session*> session) {
+	session->lifetime().make_state<Punctual>(session);
+}
+
+} // namespace Tele
