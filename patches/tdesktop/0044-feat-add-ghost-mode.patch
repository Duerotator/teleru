+#include "tele/tele_options.h"
+#include "ui/widgets/buttons.h"
+#include "ui/widgets/popup_menu.h"
+#include "ui/wrap/vertical_layout.h"
+#include "styles/style_menu_icons.h"
+#include "styles/style_window.h"
+
+namespace Tele {
+namespace {
+
+template <typename Callback>
+void EnumerateSessions(Callback &&callback) {
+	if (!Core::IsAppLaunched()) {
+		return;
+	}
+	for (const auto &[index, account] : Core::App().domain().accounts()) {
+		if (const auto session = account->maybeSession()) {
+			callback(not_null<Main::Session*>(session));
+		}
+	}
+}
+
+struct State {
+	State();
+
+	rpl::lifetime lifetime;
+};
+
+State::State() {
+	GhostOnlineChanges(
+	) | rpl::on_next([] {
+		EnumerateSessions([](not_null<Main::Session*> session) {
+			session->updates().updateOnline();
+		});
+	}, lifetime);
+}
+
+State &Get() {
+	static State state;
+	return state;
+}
+
+void SendRead(
+		not_null<History*> history,
+		MsgId rootId,
+		PeerData *sublistPeer,
+		MsgId tillId) {
+	if (!IsServerMsgId(tillId)) {
+		return;
+	}
+	const auto peer = history->peer;
+	auto &api = peer->session().api();
+	if (rootId) {
+		api.request(MTPmessages_ReadDiscussion(
+			peer->input(),
+			MTP_int(rootId),
+			MTP_int(tillId)
+		)).send();
+	} else if (sublistPeer) {
+		api.request(MTPmessages_ReadSavedHistory(
+			peer->input(),
+			sublistPeer->input(),
+			MTP_int(tillId)
+		)).send();
+	} else if (const auto channel = peer->asChannel()) {
+		api.request(MTPchannels_ReadHistory(
+			channel->inputChannel(),
+			MTP_int(tillId)
+		)).send();
+	} else {
+		api.request(MTPmessages_ReadHistory(
+			peer->input(),
+			MTP_int(tillId)
+		)).done([=](const MTPmessages_AffectedMessages &result) {
+			peer->session().api().applyAffectedMessages(peer, result);
+		}).send();
+	}
+}
+
+void MarkReadTill(not_null<HistoryItem*> item) {
+	const auto history = item->history();
+	if (history->isForum()) {
+		SendRead(history, item->topicRootId(), nullptr, item->id);
+	} else if (history->amMonoforumAdmin()) {
+		if (const auto sublistPeerId = item->sublistPeerId()) {
+			SendRead(
+				history,
+				0,
+				history->owner().peer(sublistPeerId),
+				item->id);
+		}
+	} else {
+		SendRead(history, 0, nullptr, item->id);
+	}
+}
+
+[[nodiscard]] MsgId LastServerId(not_null<History*> history) {
+	if (history->lastServerMessageKnown()) {
+		const auto last = history->lastServerMessage();
+		return last ? last->id : MsgId();
+	}
+	return history->maxMsgId();
+}
+
+} // namespace
+
+bool HideRead(not_null<PeerData*> peer) {
+	return Ghost() && GhostRead();
+}
+
+bool HideTyping(not_null<PeerData*> peer) {
+	return Ghost() && GhostTyping();
+}
+
+bool HideOnline() {
+	Get();
+	return Ghost() && GhostOnline();
+}
+
+bool SkipReadInbox(not_null<History*> history, MsgId tillId) {
+	if (!HideRead(history->peer)) {
+		return false;
+	}
+	crl::on_main(&history->session(), [=] {
+		history->inboxRead(tillId);
+	});
+	return true;
+}
+
+void ReadOnSend(const Api::SendAction &action) {
+	const auto history = action.history;
+	const auto peer = history->peer;
+	if (!GhostReadOnReply() || !HideRead(peer)) {
+		return;
+	}
+	const auto topicRootId = action.replyTo.topicRootId;
+	const auto monoforumPeerId = action.replyTo.monoforumPeerId;
+	const auto topic = topicRootId
+		? peer->forumTopicFor(topicRootId)
+		: nullptr;
+	const auto sublist = monoforumPeerId
+		? peer->monoforumSublistFor(monoforumPeerId)
+		: nullptr;
+	if (topic) {
+		SendRead(
+			history,
+			topicRootId,
+			nullptr,
+			topic->lastKnownServerMessageId());
+	} else if (sublist) {
+		SendRead(
+			history,
+			0,
+			sublist->sublistPeer(),
+			sublist->lastKnownServerMessageId());
+	} else {
+		SendRead(history, 0, nullptr, LastServerId(history));
+	}
+}
+
+void AddMarkReadAction(not_null<Ui::PopupMenu*> menu, HistoryItem *item) {
+	if (!item
+		|| !item->isRegular()
+		|| !IsServerMsgId(item->id)
+		|| item->history()->peer->isSelf()
+		|| !HideRead(item->history()->peer)) {
+		return;
+	}
+	const auto session = &item->history()->session();
+	const auto itemId = item->fullId();
+	menu->addAction(u"Mark as read up to here"_q, [=] {
+		if (const auto item = session->data().message(itemId)) {
+			MarkReadTill(item);
+		}
+	}, &st::menuIconMarkRead);
+}
+
+void AddGhostMenuToggle(not_null<Ui::VerticalLayout*> container) {
+	const auto button = Settings::AddButtonWithIcon(
+		container,
+		rpl::single(u"Ghost mode"_q),
+		st::mainMenuButton,
+		{ &st::menuIconStealth });
+	button->toggleOn(GhostValue());
+	button->toggledChanges(
+	) | rpl::filter([](bool enabled) {
+		return (enabled != Ghost());
+	}) | rpl::on_next([](bool enabled) {
+		SetGhost(enabled);
+	}, button->lifetime());
+}
+
+} // namespace Tele
