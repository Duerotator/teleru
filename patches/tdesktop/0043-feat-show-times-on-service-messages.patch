From: nitreojs <hello@starkow.dev>
Date: Sun, 27 Sep 2026 18:36:15 +0300
Subject: [PATCH] feat: show times on service messages

---
 .../history/view/history_view_element.cpp         |  3 ++-
 Telegram/SourceFiles/tele/tele_ignored.cpp        |  6 +++++-
 Telegram/SourceFiles/tele/tele_options.cpp        |  1 +
 Telegram/SourceFiles/tele/tele_time.cpp           | 15 +++++++++++++++
 Telegram/SourceFiles/tele/tele_time.h             |  7 +++++++
 5 files changed, 30 insertions(+), 2 deletions(-)

diff --git a/Telegram/SourceFiles/history/view/history_view_element.cpp b/Telegram/SourceFiles/history/view/history_view_element.cpp
index db89b14648c4554a3442977437b4e89b95f969c3..983de4130638789badb286ee08bf0ea34408fa00 100644
--- a/Telegram/SourceFiles/history/view/history_view_element.cpp
+++ b/Telegram/SourceFiles/history/view/history_view_element.cpp
@@ -69,6 +69,7 @@ https://github.com/telegramdesktop/tdesktop/blob/master/LEGAL
 #include "data/data_user.h"
 #include "lang/lang_keys.h"
 #include "tele/tele_ignored.h"
+#include "tele/tele_time.h"
 #include "styles/style_chat.h"
 #include "styles/style_chat_style.h"
 #include "styles/style_dialogs.h"
@@ -2133,7 +2134,7 @@ void Element::validateText() {
 		const auto &customLinks = contextDependentText.text.empty()
 			? _textItem->customTextLinks()
 			: contextDependentText.links;
-		setTextWithLinks(markedText, customLinks);
+		setTextWithLinks(Tele::WithServiceTime(item, markedText), customLinks);
 
 		if (const auto done = item->Get<HistoryServiceTodoCompletions>()) {
 			if (!done->completed.empty() && !done->incompleted.empty()) {
diff --git a/Telegram/SourceFiles/tele/tele_ignored.cpp b/Telegram/SourceFiles/tele/tele_ignored.cpp
index 10890d4482fcf8cacbd3467ad459ae8a2d56d0b0..5f4eabe36455090cb9fb87984f946ec35322ea62 100644
--- a/Telegram/SourceFiles/tele/tele_ignored.cpp
+++ b/Telegram/SourceFiles/tele/tele_ignored.cpp
@@ -101,7 +101,11 @@ void RefreshData(const State &state) {
 		items.emplace(view->data());
 	}
 	for (const auto &item : items) {
-		item->history()->owner().notifyItemDataChange(item);
+		const auto owner = &item->history()->owner();
+		if (item->isService()) {
+			owner->requestItemTextRefresh(item);
+		}
+		owner->notifyItemDataChange(item);
 	}
 }
 
diff --git a/Telegram/SourceFiles/tele/tele_options.cpp b/Telegram/SourceFiles/tele/tele_options.cpp
index 331f11c0c8b5667e463018dff5c8f0ee422ff75f..81552d22fe7b5be5846c5c0800dff953a11a0d00 100644
--- a/Telegram/SourceFiles/tele/tele_options.cpp
+++ b/Telegram/SourceFiles/tele/tele_options.cpp
@@ -255,6 +255,7 @@ base::options::option<QString> IgnoredUsersOption({
 base::options::toggle MessageSecondsOption({
 	.id = kOptionMessageSeconds,
 	.name = "Show seconds in message times",
+	.description = "Service messages like joins and pins also show their time.",
 });
 
 base::options::toggle EditHistoryOption({
diff --git a/Telegram/SourceFiles/tele/tele_time.cpp b/Telegram/SourceFiles/tele/tele_time.cpp
index 528af5cfd66ea7988c0596d0f1fa07377e6316bb..fa7cd6b5d35f0acb19bf9996e9e25995186bd479 100644
--- a/Telegram/SourceFiles/tele/tele_time.cpp
+++ b/Telegram/SourceFiles/tele/tele_time.cpp
@@ -1,6 +1,7 @@
 #include "tele/tele_time.h"
 
 #include "base/unixtime.h"
+#include "history/history_item.h"
 #include "lang/lang_keys.h"
 #include "tele/tele_options.h"
 #include "ui/text/format_values.h"
@@ -93,4 +94,18 @@ QString FormatMessageSavedFromDate(const QDateTime &dateTime) {
 		time);
 }
 
+TextWithEntities WithServiceTime(
+		not_null<const HistoryItem*> item,
+		const TextWithEntities &text) {
+	if (!MessageSeconds() || text.empty() || item->date() <= 0) {
+		return text;
+	}
+	auto result = text;
+	result.text.append(u" "_q
+		+ QChar(0x00B7)
+		+ u" "_q
+		+ FormatMessageTime(base::unixtime::parse(item->date()).time()));
+	return result;
+}
+
 } // namespace Tele
diff --git a/Telegram/SourceFiles/tele/tele_time.h b/Telegram/SourceFiles/tele/tele_time.h
index c584a9a5d03de038c0d9ccda78cf395711cafb03..cf8992ae1cca65940fbb73d089fb7c71c87c39e2 100644
--- a/Telegram/SourceFiles/tele/tele_time.h
+++ b/Telegram/SourceFiles/tele/tele_time.h
@@ -1,8 +1,15 @@
 #pragma once
 
+#include "ui/text/text_entity.h"
+
+class HistoryItem;
+
 namespace Tele {
 
 [[nodiscard]] QString FormatMessageTime(const QTime &time);
 [[nodiscard]] QString FormatMessageSavedFromDate(const QDateTime &dateTime);
+[[nodiscard]] TextWithEntities WithServiceTime(
+	not_null<const HistoryItem*> item,
+	const TextWithEntities &text);
 
 } // namespace Tele
