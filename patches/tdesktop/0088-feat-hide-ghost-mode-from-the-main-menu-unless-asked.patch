From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: nitreojs <hello@starkow.dev>
Date: Sun, 27 Sep 2026 22:20:55 +0300
Subject: [PATCH] feat: hide ghost mode from the main menu unless asked

---
 Telegram/SourceFiles/settings/settings_tele.cpp |  1 +
 Telegram/SourceFiles/tele/tele_ghost.cpp        |  3 +++
 Telegram/SourceFiles/tele/tele_options.cpp      | 14 ++++++++++++--
 Telegram/SourceFiles/tele/tele_options.h        |  2 ++
 4 files changed, 18 insertions(+), 2 deletions(-)

diff --git a/Telegram/SourceFiles/settings/settings_tele.cpp b/Telegram/SourceFiles/settings/settings_tele.cpp
index e2e4da9b3a392cb356d72c4810d15bd67e12bd13..757dc5fdcd3cb77f486e57487f08c583378d4e27 100644
--- a/Telegram/SourceFiles/settings/settings_tele.cpp
+++ b/Telegram/SourceFiles/settings/settings_tele.cpp
@@ -1106,6 +1106,7 @@ void FillPrivacy(SectionBuilder &builder) {
 	builder.addSkip();
 	AddGroupTitle(builder, u"Ghost mode"_q);
 	AddOptionToggle(builder, ::Tele::kOptionGhost);
+	AddOptionToggle(builder, ::Tele::kOptionGhostInMenu);
 	AddOptionToggle(builder, ::Tele::kOptionGhostRead);
 	AddOptionToggle(builder, ::Tele::kOptionGhostReadOnReply);
 	AddOptionToggle(builder, ::Tele::kOptionGhostTyping);
diff --git a/Telegram/SourceFiles/tele/tele_ghost.cpp b/Telegram/SourceFiles/tele/tele_ghost.cpp
index 7772d51fd1d7c2deb381822953e1682822cd60ad..d9fc40c0b8825fb52ecbf4ff665234bc9d443624 100644
--- a/Telegram/SourceFiles/tele/tele_ghost.cpp
+++ b/Telegram/SourceFiles/tele/tele_ghost.cpp
@@ -378,6 +378,9 @@ void AddMarkReadAction(not_null<Ui::PopupMenu*> menu, HistoryItem *item) {
 }
 
 void AddGhostMenuToggle(not_null<Ui::VerticalLayout*> container) {
+	if (!GhostInMenu()) {
+		return;
+	}
 	const auto button = Settings::AddButtonWithIcon(
 		container,
 		rpl::single(Lower(u"Ghost mode"_q)),
diff --git a/Telegram/SourceFiles/tele/tele_options.cpp b/Telegram/SourceFiles/tele/tele_options.cpp
index e0bfb12629b6c1537e3a7c1a0b58edd8a965565b..1cf171c1e5c1c34f7644da91eb5d8135bea52498 100644
--- a/Telegram/SourceFiles/tele/tele_options.cpp
+++ b/Telegram/SourceFiles/tele/tele_options.cpp
@@ -7,6 +7,7 @@ namespace Tele {
 const char kOptionHideStories[] = "tele-hide-stories";
 const char kOptionInvisibleStories[] = "tele-invisible-stories";
 const char kOptionGhost[] = "tele-ghost";
+const char kOptionGhostInMenu[] = "tele-ghost-in-menu";
 const char kOptionGhostRead[] = "tele-ghost-read";
 const char kOptionGhostReadOnReply[] = "tele-ghost-read-on-reply";
 const char kOptionGhostTyping[] = "tele-ghost-typing";
@@ -80,8 +81,13 @@ base::options::toggle InvisibleStoriesOption({
 base::options::toggle GhostOption({
 	.id = kOptionGhost,
 	.name = "Ghost mode",
-	.description = "Applies the switches below, also toggled from the main "
-		"menu.",
+	.description = "Applies the switches below.",
+});
+
+base::options::toggle GhostInMenuOption({
+	.id = kOptionGhostInMenu,
+	.name = "Ghost mode in the main menu",
+	.description = "A quick switch for ghost mode in the left menu.",
 });
 
 base::options::toggle GhostReadOption({
@@ -621,6 +627,10 @@ bool JumpToFirst() {
 	return JumpToFirstOption.value();
 }
 
+bool GhostInMenu() {
+	return GhostInMenuOption.value();
+}
+
 bool StaticUserpicsList() {
 	return StaticUserpicsListOption.value();
 }
diff --git a/Telegram/SourceFiles/tele/tele_options.h b/Telegram/SourceFiles/tele/tele_options.h
index 282b50bf463ee13a9bb3a495f19914124483b776..cd88b5a00b1a7b26af7e6fc703ec6f79f4643bb9 100644
--- a/Telegram/SourceFiles/tele/tele_options.h
+++ b/Telegram/SourceFiles/tele/tele_options.h
@@ -30,6 +30,7 @@ extern const char kOptionCleanSentLinks[];
 extern const char kOptionHideAllChats[];
 extern const char kOptionJumpToFirst[];
 extern const char kOptionStaticUserpicsList[];
+extern const char kOptionGhostInMenu[];
 extern const char kOptionStaticUserpicsChats[];
 extern const char kOptionShowGiftIds[];
 extern const char kOptionSeeTgButton[];
@@ -96,6 +97,7 @@ void SetGroupCallButton(const QString &value);
 [[nodiscard]] bool HideAllChats();
 [[nodiscard]] rpl::producer<> HideAllChatsChanges();
 [[nodiscard]] bool JumpToFirst();
+[[nodiscard]] bool GhostInMenu();
 [[nodiscard]] bool StaticUserpicsList();
 [[nodiscard]] rpl::producer<> StaticUserpicsListChanges();
 [[nodiscard]] bool StaticUserpicsChats();
