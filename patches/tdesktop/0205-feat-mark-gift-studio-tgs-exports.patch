+constexpr auto kMarkTagBits = 32;
+constexpr auto kMarkVersionBits = 4;
+constexpr auto kMarkBits = kMarkTagBits + kMarkVersionBits;
+constexpr auto kMarkCopies = 3;
+constexpr auto kMarkVertices = (kMarkBits * kMarkCopies) / 6;
+
+[[nodiscard]] const std::vector<int> &MarkBits() {
+	static const auto result = [] {
+		const auto hash = QCryptographicHash::hash(
+			QByteArrayLiteral("tele-gift-studio"),
+			QCryptographicHash::Sha256);
+		auto tag = quint32(0);
+		for (auto i = 0; i != 4; ++i) {
+			tag = (tag << 8) | uchar(hash[i]);
+		}
+		const auto version = quint32(1);
+		auto bits = std::vector<int>();
+		bits.reserve(kMarkBits);
+		for (auto i = kMarkTagBits - 1; i >= 0; --i) {
+			bits.push_back(int((tag >> i) & 1));
+		}
+		for (auto i = kMarkVersionBits - 1; i >= 0; --i) {
+			bits.push_back(int((version >> i) & 1));
+		}
+		return bits;
+	}();
+	return result;
+}
+
+[[nodiscard]] Json MarkPath() {
+	const auto &bits = MarkBits();
+	const auto coord = [&](int block, int local) {
+		const auto n = block * kMarkBits + local;
+		return JsonNumber(double(2 * n + bits[n % kMarkBits]));
+	};
+	auto i = std::vector<Json>();
+	auto o = std::vector<Json>();
+	auto v = std::vector<Json>();
+	i.reserve(kMarkVertices);
+	o.reserve(kMarkVertices);
+	v.reserve(kMarkVertices);
+	for (auto p = 0; p != kMarkVertices; ++p) {
+		i.push_back(JsonArray({ coord(0, 2 * p), coord(0, 2 * p + 1) }));
+		o.push_back(JsonArray({ coord(1, 2 * p), coord(1, 2 * p + 1) }));
+		v.push_back(JsonArray({ coord(2, 2 * p), coord(2, 2 * p + 1) }));
+	}
+	return JsonObject({
+		{ "ty", JsonString("sh") },
+		{ "ks", JsonStatic(JsonObject({
+			{ "i", JsonArray(std::move(i)) },
+			{ "o", JsonArray(std::move(o)) },
+			{ "v", JsonArray(std::move(v)) },
+			{ "c", JsonBool(true) },
+		})) },
+	});
+}
+
+[[nodiscard]] Json MarkLayer(int index, double out) {
+	return ShapeLayer(
+		index,
+		"shape",
+		{ ShapeGroup({ MarkPath() }) },
+		0.,
+		out);
+}
