@@ -41,6 +49,82 @@ namespace {
 		nullptr);
 }
 
+[[nodiscard]] QByteArray Serialize(const MTPMessage &message) {
+	auto buffer = mtpBuffer();
+	message.write(buffer);
+	return QByteArray(
+		reinterpret_cast<const char*>(buffer.constData()),
+		buffer.size() * sizeof(buffer.front()));
+}
+
+void OpenTl(const QByteArray &bytes) {
+	const auto data = bytes.toBase64(
+		QByteArray::Base64UrlEncoding | QByteArray::OmitTrailingEquals);
+	UrlClickHandler::Open(
+		u"https://schema.jppgr.am/embed#layer=%1&theme=%2&data=%3"_q
+			.arg(int(MTP::details::kCurrentLayer))
+			.arg(Window::Theme::IsNightMode() ? u"dark"_q : u"light"_q)
+			.arg(QString::fromLatin1(data)));
+}
+
+void RequestTl(
+		std::shared_ptr<Main::SessionShow> show,
+		not_null<PeerData*> peer,
+		MsgId id) {
+	const auto ids = MTP_vector<MTPInputMessage>(
+		1,
+		MTP_inputMessageID(MTP_int(id)));
+	const auto done = [=](const MTPmessages_Messages &result) {
+		const auto list = result.match([](
+				const MTPDmessages_messagesNotModified &) {
+			return QVector<MTPMessage>();
+		}, [](const auto &data) {
+			return data.vmessages().v;
+		});
+		for (const auto &message : list) {
+			if (message.type() != mtpc_messageEmpty
+				&& IdFromMessage(message) == id) {
+				OpenTl(Serialize(message));
+				return;
+			}
+		}
+		show->showToast(u"The server didn't return this message."_q);
+	};
+	const auto fail = [=](const MTP::Error &error) {
+		show->showToast(error.type());
+	};
+	auto &api = peer->session().api();
+	if (const auto channel = peer->asChannel()) {
+		api.request(MTPchannels_GetMessages(
+			channel->inputChannel(),
+			ids
+		)).done(done).fail(fail).send();
+	} else {
+		api.request(MTPmessages_GetMessages(
+			ids
+		)).done(done).fail(fail).send();
+	}
+}
+
+[[nodiscard]] base::unique_qptr<Ui::Menu::ItemBase> MakeTlAction(
+		not_null<Ui::PopupMenu*> menu,
+		std::shared_ptr<Main::SessionShow> show,
+		not_null<HistoryItem*> item) {
+	const auto peer = item->history()->peer;
+	const auto id = item->id;
+	const auto parent = menu->menu();
+	const auto action = Ui::Menu::CreateAction(
+		parent,
+		u"View as TL"_q,
+		[=] { RequestTl(show, peer, id); });
+	return base::make_unique_q<Ui::Menu::Action>(
+		parent,
+		menu->st().menu,
+		action,
+		&st::menuIconInfo,
+		&st::menuIconInfo);
+}
+
 } // namespace
 
