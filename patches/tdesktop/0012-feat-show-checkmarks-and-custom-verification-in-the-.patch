diff --git a/Telegram/SourceFiles/tele/tele_account_badges.cpp b/Telegram/SourceFiles/tele/tele_account_badges.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..e39dc9e95dce5dcd173c7e662a44b7980038e609
--- /dev/null
+++ b/Telegram/SourceFiles/tele/tele_account_badges.cpp
@@ -0,0 +1,55 @@
+#include "tele/tele_account_badges.h"
+
+#include "data/data_user.h"
+#include "data/stickers/data_custom_emoji.h"
+#include "info/profile/info_profile_badge.h"
+#include "main/main_session.h"
+#include "ui/widgets/buttons.h"
+#include "styles/style_settings.h"
+#include "styles/style_window.h"
+
+namespace Tele {
+
+const style::SettingsButton &AccountButtonStyle(not_null<UserData*> user) {
+	if (!user->botVerifyDetails()) {
+		return st::mainMenuAddAccountButton;
+	}
+	static const auto result = [] {
+		auto copy = st::mainMenuAddAccountButton;
+		const auto emoji = Data::FrameSizeFromTag(
+			Data::CustomEmojiSizeTag::Normal) / style::DevicePixelRatio();
+		copy.padding.setLeft(copy.padding.left()
+			+ emoji
+			+ copy.style.font->spacew);
+		return copy;
+	}();
+	return result;
+}
+
+void AddAccountBotVerify(
+		not_null<Ui::SettingsButton*> button,
+		not_null<UserData*> user,
+		Fn<bool()> paused) {
+	if (!user->botVerifyDetails()) {
+		return;
+	}
+	const auto badge = button->lifetime().make_state<Info::Profile::Badge>(
+		button,
+		st::settingsInfoPeerBadge,
+		&user->session(),
+		Info::Profile::BotVerifyBadgeForPeer(user),
+		nullptr,
+		std::move(paused),
+		0,
+		Info::Profile::BadgeType::BotVerified);
+	button->heightValue(
+	) | rpl::on_next([=](int height) {
+		const auto &st = st::mainMenuAddAccountButton;
+		badge->move(
+			st.padding.left(),
+			st.padding.top(),
+			height - st.padding.top());
+	}, button->lifetime());
+}
+
+} // namespace Tele
