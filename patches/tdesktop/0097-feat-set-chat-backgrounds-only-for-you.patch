+bool SaveCustom(
+		not_null<Window::SessionController*> controller,
+		not_null<PeerData*> peer,
+		const Data::WallPaper &paper,
+		const QImage &full) {
+	auto file = QString();
+	if (paper.isPattern() || paper.backgroundColors().empty()) {
+		auto image = full;
+		if (image.isNull()) {
+			if (const auto thumbnail = paper.localThumbnail()) {
+				image = thumbnail->original();
+			}
+		}
+		if (image.isNull()) {
+			controller->showToast(
+				Lower(u"The background is still loading."_q));
+			return false;
+		}
+		const auto pattern = paper.isPattern();
+		file = BotApiId(peer->id)
+			+ (peer->session().isTestMode() ? u"_test_"_q : u"_"_q)
+			+ QString::number(QDateTime::currentMSecsSinceEpoch(), 16)
+			+ (pattern ? u".png"_q : u".jpg"_q);
+		const auto folder = Folder();
+		QDir().mkpath(folder);
+		image = Ui::PreprocessBackgroundImage(std::move(image));
+		if (!image.save(
+				folder + file,
+				pattern ? "PNG" : "JPG",
+				pattern ? -1 : kJpegQuality)) {
+			controller->showToast(
