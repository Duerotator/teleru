+
+[[nodiscard]] QString MakeSpec(
+		const Data::WallPaper &paper,
+		const QString &file) {
+	const auto encoded = QString::fromLatin1(paper.serialize().toBase64(
+		QByteArray::Base64UrlEncoding | QByteArray::OmitTrailingEquals));
+	return file.isEmpty() ? encoded : (encoded + '@' + file);
+}
