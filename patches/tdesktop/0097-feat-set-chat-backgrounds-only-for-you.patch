+rpl::producer<> ChatBackgroundsChanges() {
+	return Get().changes.events();
+}
+
+rpl::producer<int> ChatBackgroundsCountValue(
+		not_null<Main::Session*> session) {
+	return rpl::single(
+		rpl::empty
+	) | rpl::then(
+		ChatBackgroundsChanges()
+	) | rpl::map([=] {
+		return int(ChatBackgrounds(session).size());
+	});
+}
+
+void ResetChatBackground(not_null<PeerData*> peer) {
+	SetPeerSpec(peer, QString());
+}
