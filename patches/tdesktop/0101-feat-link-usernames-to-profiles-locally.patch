+		Lower(u"Mentions of this alias will open this profile. Only you "
+			"see it."_q),
+		st::boxDividerLabel));
+	const auto save = [=] {
+		const auto alias = NormalizeAlias(field->getLastText());
+		if (!IsValidAlias(alias)) {
+			field->showError();
+			box->showToast(Lower(
+				u"Use 1-32 latin letters, digits or underscores."_q));
+			return;
+		}
+		auto map = SessionMap(session);
+		if (const auto i = map.find(alias); i != end(map)) {
+			if (i->second != peer->id) {
+				const auto other = session->data().peerLoaded(i->second);
+				field->showError();
+				box->showToast('@'
+					+ alias
+					+ Lower(u" already links to "_q)
+					+ ((other && other->isMinimalLoaded())
+						? other->name()
+						: Lower(u"another chat"_q)));
+				return;
+			}
+		} else {
+			map.emplace(alias, peer->id);
+			Save(session, std::move(map));
+		}
+		box->closeBox();
+	};
+	QObject::connect(field, &Ui::UsernameInput::submitted, save);
+	box->setFocusCallback([=] {
+		field->setFocusFast();
+	});
+	box->addButton(rpl::single(Lower(u"Add"_q)), save);
+	box->addButton(tr::lng_cancel(), [=] {
+		box->closeBox();
+	});
+}
+
+} // namespace
+
+std::vector<UsernameAlias> UsernameAliases(
+		not_null<Main::Session*> session) {
+	auto result = std::vector<UsernameAlias>();
+	const auto &map = SessionMap(session);
+	result.reserve(map.size());
+	for (const auto &[alias, id] : map) {
+		result.push_back({ alias, id });
+	}
+	return result;
+}
+
+rpl::producer<> UsernameAliasesChanges() {
+	return Get().changes.events();
+}
+
+rpl::producer<QStringList> PeerAliasesValue(not_null<PeerData*> peer) {
+	const auto session = &peer->session();
+	const auto id = peer->id;
+	return rpl::single(
+		rpl::empty
+	) | rpl::then(
+		UsernameAliasesChanges()
+	) | rpl::map([=] {
+		auto list = QStringList();
+		for (const auto &[alias, peerId] : SessionMap(session)) {
+			if (peerId == id) {
+				list.push_back('@' + alias);
+			}
+		}
+		return list;
+	});
+}
+
+rpl::producer<TextWithEntities> PeerAliasesTextValue(
+		not_null<PeerData*> peer) {
+	return PeerAliasesValue(peer) | rpl::map([](const QStringList &list) {
+		auto result = TextWithEntities();
+		for (auto i = 0; i != int(list.size()); ++i) {
+			if (i) {
+				result.append(u", "_q);
+			}
+			result.append(Ui::Text::Link(list[i], i + 1));
+		}
+		return result;
+	});
+}
+
+void SetupPeerAliasesLabel(
+		not_null<Ui::FlatLabel*> label,
+		not_null<PeerData*> peer,
+		not_null<Window::SessionController*> controller) {
+	const auto weak = base::make_weak(controller);
+	PeerAliasesValue(peer) | rpl::on_next([=](const QStringList &list) {
+		for (auto i = 0; i != int(list.size()); ++i) {
+			const auto alias = list[i];
+			label->setLink(i + 1, std::make_shared<LambdaClickHandler>([=] {
+				TextUtilities::SetClipboardText({ alias });
+				if (const auto strong = weak.get()) {
+					strong->showToast({
+						.text = { Lower(u"Alias copied to clipboard."_q) },
+						.iconLottie = u"toast/copy"_q,
+						.iconLottieSize = st::toastLottieIconSize,
+					});
+				}
+			}));
+		}
+	}, label->lifetime());
+}
+
+rpl::producer<int> UsernameAliasesCountValue(
+		not_null<Main::Session*> session) {
+	return rpl::single(
+		rpl::empty
+	) | rpl::then(
+		UsernameAliasesChanges()
+	) | rpl::map([=] {
+		return int(SessionMap(session).size());
+	});
+}
+
+void RemoveUsernameAlias(
+		not_null<Main::Session*> session,
+		const QString &alias) {
+	auto map = SessionMap(session);
+	if (map.remove(alias)) {
+		Save(session, std::move(map));
+	}
+}
+
+void AddUsernameAliasAction(
+		not_null<Window::SessionController*> controller,
+		PeerData *peer,
+		const Ui::Menu::MenuCallback &addAction) {
+	if (!peer) {
+		return;
+	}
+	const auto weak = base::make_weak(controller);
+	addAction(Lower(u"Add alias"_q) + QChar(0x2026), [=] {
+		if (const auto strong = weak.get()) {
+			strong->show(Box(AliasBox, not_null(peer)));
+		}
+	}, &st::menuIconUsername);
+}
+
+bool ResolveUsernameAlias(
+		not_null<Window::SessionNavigation*> navigation,
+		const QString &username,
+		const Fn<void(not_null<PeerData*>)> &done) {
+	if (SkipAliases) {
+		return false;
+	}
+	const auto session = &navigation->session();
+	const auto id = AliasPeerId(session, username);
+	if (!id) {
+		return false;
+	} else if (const auto peer = LoadedPeer(session, id)) {
+		done(peer);
+	} else {
+		navigation->showToast('@'
+			+ username.toLower()
+			+ Lower(u" links to a chat that isn't loaded yet."_q));
+	}
+	return true;
+}
+
+void AddOpenRealUsernameAction(
+		not_null<Ui::PopupMenu*> menu,
+		const std::shared_ptr<Main::SessionShow> &show,
+		const std::shared_ptr<ClickHandler> &link) {
+	if (!link || !show) {
+		return;
+	}
+	const auto session = &show->session();
+	const auto username = LinkUsername(link);
+	if (username.isEmpty() || !AliasPeerId(session, username)) {
+		return;
+	}
+	const auto weak = base::make_weak(session->tryResolveWindow());
+	menu->addAction(Lower(u"Open the real "_q) + '@' + username, [=] {
+		SkipAliases = true;
+		link->onClick({
+			Qt::LeftButton,
+			QVariant::fromValue(ClickHandlerContext{
+				.sessionWindow = weak,
+			}),
+		});
+		SkipAliases = false;
+	}, &st::menuIconUsername);
+}
+
+std::vector<UsernameAliasMention> UsernameAliasMentions(
+		not_null<Main::Session*> session,
+		const QString &filter) {
+	auto result = std::vector<UsernameAliasMention>();
+	if (filter.isEmpty()) {
+		return result;
+	}
+	for (const auto &[alias, id] : SessionMap(session)) {
+		if (alias.size() <= filter.size() || !alias.startsWith(filter)) {
+			continue;
+		}
+		const auto peer = LoadedPeer(session, id);
+		if (const auto user = peer ? peer->asUser() : nullptr) {
+			result.push_back({ alias, not_null(user) });
+		}
+	}
+	return result;
+}
+
+} // namespace Tele
