From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: nitreojs <hello@starkow.dev>
Date: Sun, 27 Sep 2026 02:08:44 +0300
Subject: [PATCH] feat: format peer ids without spaces or bot api style

---
 .../SourceFiles/settings/settings_tele.cpp    |  9 ++++++
 Telegram/SourceFiles/tele/tele_options.cpp    | 31 +++++++++++++++++++
 Telegram/SourceFiles/tele/tele_options.h      |  5 +++
 Telegram/SourceFiles/tele/tele_peer_id.cpp    | 23 ++++++++++++--
 4 files changed, 65 insertions(+), 3 deletions(-)

diff --git a/Telegram/SourceFiles/settings/settings_tele.cpp b/Telegram/SourceFiles/settings/settings_tele.cpp
index ebb93d4bb8699b6fd0f2a56697f37157f92baeb2..d6e87da8a35a3c983c39174b251d03231d7a3090 100644
--- a/Telegram/SourceFiles/settings/settings_tele.cpp
+++ b/Telegram/SourceFiles/settings/settings_tele.cpp
@@ -348,6 +348,15 @@ void TeleSection::setupContent() {
 	Ui::AddSkip(content);
 	Ui::AddDivider(content);
 	Ui::AddSkip(content);
+	Ui::AddSubsectionTitle(content, rpl::single(u"IDs"_q));
+	AddOptionToggle(
+		content,
+		controller(),
+		::Tele::kOptionPeerIdsWithoutSpaces);
+	AddOptionToggle(content, controller(), ::Tele::kOptionBotApiPeerIds);
+	Ui::AddSkip(content);
+	Ui::AddDivider(content);
+	Ui::AddSkip(content);
 	Ui::AddSubsectionTitle(content, rpl::single(u"Server"_q));
 	AddServer(content, controller());
 	Ui::AddSkip(content);
diff --git a/Telegram/SourceFiles/tele/tele_options.cpp b/Telegram/SourceFiles/tele/tele_options.cpp
index 292f053600b34a2fb1495571271a756071e0ad73..b34c5a7d33ad1aef8b9672299c843a7afe766281 100644
--- a/Telegram/SourceFiles/tele/tele_options.cpp
+++ b/Telegram/SourceFiles/tele/tele_options.cpp
@@ -11,6 +11,8 @@ const char kOptionAutoUpdate[] = "tele-auto-update";
 const char kOptionGroupQuickReplies[] = "tele-group-quick-replies";
 const char kOptionBubbleBadges[] = "tele-bubble-badges";
 const char kOptionShowGiftIds[] = "tele-show-gift-ids";
+const char kOptionPeerIdsWithoutSpaces[] = "tele-peer-ids-without-spaces";
+const char kOptionBotApiPeerIds[] = "tele-bot-api-peer-ids";
 const char kOptionServerUrl[] = "tele-server-url";
 const char kOptionTitleTemplate[] = "tele-title";
 
@@ -72,6 +74,21 @@ base::options::toggle ShowGiftIdsOption({
 		"Click it to copy.",
 });
 
+base::options::toggle PeerIdsWithoutSpacesOption({
+	.id = kOptionPeerIdsWithoutSpaces,
+	.name = "IDs without spaces",
+	.description = "Show peer IDs in profiles as plain digits, without "
+		"grouping them. Copying gives the same text.",
+});
+
+base::options::toggle BotApiPeerIdsOption({
+	.id = kOptionBotApiPeerIds,
+	.name = "Bot API style IDs",
+	.description = "Show peer IDs in profiles the way the Bot API does: "
+		"basic groups get a minus in front, channels and supergroups "
+		"get -100 in front.",
+});
+
 base::options::option<QString> ServerUrlOption({
 	.id = kOptionServerUrl,
 	.name = "tele server",
@@ -129,6 +146,20 @@ bool ShowGiftIds() {
 	return ShowGiftIdsOption.value();
 }
 
+bool PeerIdsWithoutSpaces() {
+	return PeerIdsWithoutSpacesOption.value();
+}
+
+bool BotApiPeerIds() {
+	return BotApiPeerIdsOption.value();
+}
+
+rpl::producer<> PeerIdFormatChanges() {
+	return rpl::merge(
+		PeerIdsWithoutSpacesOption.changes(),
+		BotApiPeerIdsOption.changes());
+}
+
 QString ServerUrl() {
 	return ServerUrlOption.value();
 }
diff --git a/Telegram/SourceFiles/tele/tele_options.h b/Telegram/SourceFiles/tele/tele_options.h
index 72c4d78b20b936509f551cd43b68be865e9d5424..d1bebdec494e8825ae4e325ff3eb1060651c091f 100644
--- a/Telegram/SourceFiles/tele/tele_options.h
+++ b/Telegram/SourceFiles/tele/tele_options.h
@@ -9,6 +9,8 @@ extern const char kOptionAutoUpdate[];
 extern const char kOptionGroupQuickReplies[];
 extern const char kOptionBubbleBadges[];
 extern const char kOptionShowGiftIds[];
+extern const char kOptionPeerIdsWithoutSpaces[];
+extern const char kOptionBotApiPeerIds[];
 extern const char kOptionServerUrl[];
 extern const char kOptionTitleTemplate[];
 
@@ -20,6 +22,9 @@ extern const char kOptionTitleTemplate[];
 [[nodiscard]] bool GroupQuickReplies();
 [[nodiscard]] bool BubbleBadges();
 [[nodiscard]] bool ShowGiftIds();
+[[nodiscard]] bool PeerIdsWithoutSpaces();
+[[nodiscard]] bool BotApiPeerIds();
+[[nodiscard]] rpl::producer<> PeerIdFormatChanges();
 [[nodiscard]] QString ServerUrl();
 void SetServerUrl(const QString &url);
 [[nodiscard]] rpl::producer<QString> ServerUrlValue();
diff --git a/Telegram/SourceFiles/tele/tele_peer_id.cpp b/Telegram/SourceFiles/tele/tele_peer_id.cpp
index ae8c1c25086c809408cf3bbaf2515e89fc43670f..bceff86574c906665766197febbcc10019224135 100644
--- a/Telegram/SourceFiles/tele/tele_peer_id.cpp
+++ b/Telegram/SourceFiles/tele/tele_peer_id.cpp
@@ -2,6 +2,7 @@
 
 #include "data/data_peer.h"
 #include "lang/lang_tag.h"
+#include "tele/tele_options.h"
 #include "ui/text/text_utilities.h"
 #include "ui/toast/toast.h"
 #include "ui/widgets/labels.h"
@@ -13,6 +14,7 @@ namespace Tele {
 namespace {
 
 constexpr auto kLinkIndex = uint16(1);
+constexpr auto kChannelShift = int64(1000000000000LL);
 
 class PeerIdClickHandler final : public ClickHandler {
 public:
@@ -37,14 +39,29 @@ private:
 };
 
 [[nodiscard]] rpl::producer<QString> PeerIdValue(not_null<PeerData*> peer) {
-	return rpl::single(FormatPeerId(peer));
+	return rpl::single(
+		rpl::empty
+	) | rpl::then(
+		PeerIdFormatChanges()
+	) | rpl::map([=] {
+		return FormatPeerId(peer);
+	});
 }
 
 } // namespace
 
 QString FormatPeerId(not_null<PeerData*> peer) {
-	return Lang::FormatCountDecimal(
-		int64(peer->id.value & PeerId::kChatTypeMask));
+	const auto bare = int64(peer->id.value & PeerId::kChatTypeMask);
+	const auto id = !BotApiPeerIds()
+		? bare
+		: peer->isChat()
+		? -bare
+		: peer->isChannel()
+		? -(kChannelShift + bare)
+		: bare;
+	return PeerIdsWithoutSpaces()
+		? QString::number(id)
+		: Lang::FormatCountDecimal(id);
 }
 
 rpl::producer<TextWithEntities> PeerIdTextValue(not_null<PeerData*> peer) {
