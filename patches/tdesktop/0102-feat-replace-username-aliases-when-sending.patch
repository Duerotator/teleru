+[[nodiscard]] QString PublicUsername(not_null<PeerData*> peer) {
+	const auto &usernames = peer->usernames();
+	return usernames.empty() ? peer->username() : usernames.front();
+}
+
+[[nodiscard]] bool IsUsernameChar(QChar ch) {
+	return (ch >= 'a' && ch <= 'z')
+		|| (ch >= 'A' && ch <= 'Z')
+		|| (ch >= '0' && ch <= '9')
+		|| (ch == '_');
+}
+
+[[nodiscard]] bool KeepsText(EntityType type) {
+	return (type == EntityType::Code)
+		|| (type == EntityType::Pre)
+		|| (type == EntityType::Url)
+		|| (type == EntityType::CustomUrl)
+		|| (type == EntityType::Email)
+		|| (type == EntityType::MentionName)
+		|| (type == EntityType::Hashtag)
+		|| (type == EntityType::Cashtag)
+		|| (type == EntityType::BotCommand)
+		|| (type == EntityType::CustomEmoji);
+}
+
+[[nodiscard]] std::optional<int> ReplaceableMention(
+		const EntitiesInText &entities,
+		int from,
+		int till) {
+	auto result = -1;
+	for (auto i = 0, count = int(entities.size()); i != count; ++i) {
+		const auto &entity = entities[i];
+		const auto start = entity.offset();
+		const auto end = start + entity.length();
+		if (end <= from || start >= till) {
+			continue;
+		} else if (KeepsText(entity.type())) {
+			return std::nullopt;
+		} else if (entity.type() == EntityType::Mention) {
+			if (start != from || end != till) {
+				return std::nullopt;
+			}
+			result = i;
+		} else if (start > from || end < till) {
+			return std::nullopt;
+		}
+	}
+	return result;
+}
+
+void ReplaceToken(
+		TextWithEntities &text,
+		int from,
+		int till,
+		const QString &value,
+		int mention,
+		const QString &mentionName) {
+	const auto delta = int(value.size()) - (till - from);
+	text.text.replace(from, till - from, value);
+	auto &entities = text.entities;
+	for (auto &entity : entities) {
+		const auto start = entity.offset();
+		const auto length = entity.length();
+		if (start >= till) {
+			entity = EntityInText(
+				entity.type(),
+				start + delta,
+				length,
+				entity.data());
+		} else if (start <= from && start + length >= till) {
+			entity = EntityInText(
+				entity.type(),
+				start,
+				length + delta,
+				entity.data());
+		}
+	}
+	if (mentionName.isEmpty()) {
+		return;
+	} else if (mention >= 0) {
+		entities.erase(entities.begin() + mention);
+	}
+	const auto position = ranges::find_if(entities, [&](
+			const EntityInText &entity) {
+		return entity.offset() > from;
+	});
+	entities.insert(position, EntityInText(
+		EntityType::MentionName,
+		from,
+		int(value.size()),
+		mentionName));
+}
+
+void ShowReplacedToast(
+		not_null<History*> history,
+		const std::vector<std::pair<QString, QString>> &replaced) {
+	auto done = QStringList();
+	auto skipped = QStringList();
+	for (const auto &[alias, value] : replaced) {
+		if (value.isEmpty()) {
+			skipped.push_back('@' + alias);
+		} else {
+			done.push_back('@' + alias + ' ' + QChar(0x2192) + ' ' + value);
+		}
+	}
+	auto message = done.join(u", "_q);
+	if (!skipped.isEmpty()) {
+		if (!message.isEmpty()) {
+			message += u"; "_q;
+		}
+		message += Lower(u"Not replaced: "_q) + skipped.join(u", "_q);
+	}
+	const auto session = &history->session();
+	if (const auto window = session->tryResolveWindow(history->peer)) {
+		window->showToast(message);
+	}
+}
+
 void AliasBox(not_null<Ui::GenericBox*> box, not_null<PeerData*> peer) {
 	const auto session = &peer->session();
 	box->setTitle(rpl::single(Lower(u"Alias for "_q) + peer->name()));
@@ -416,4 +535,77 @@ std::vector<UsernameAliasMention> UsernameAliasMentions(
 	return result;
 }
 
+void ReplaceUsernameAliases(
+		not_null<History*> history,
+		TextWithEntities &text) {
+	const auto session = &history->session();
+	const auto &map = SessionMap(session);
+	if (map.empty()) {
+		return;
+	}
+	auto replaced = std::vector<std::pair<QString, QString>>();
+	auto position = 0;
+	while (true) {
+		const auto from = int(text.text.indexOf('@', position));
+		if (from < 0) {
+			break;
+		}
+		auto till = from + 1;
+		while (till < text.text.size() && IsUsernameChar(text.text[till])) {
+			++till;
+		}
+		position = till;
+		const auto length = till - from - 1;
+		if (!length || length > kMaxAliasLength) {
+			continue;
+		} else if (from > 0) {
+			const auto previous = text.text.at(from - 1);
+			if (previous.isLetterOrNumber()
+				|| previous == '_'
+				|| previous == '@') {
+				continue;
+			}
+		}
+		const auto alias = text.text.mid(from + 1, length).toLower();
+		const auto i = map.find(alias);
+		if (i == end(map)) {
+			continue;
+		}
+		const auto mention = ReplaceableMention(text.entities, from, till);
+		if (!mention) {
+			continue;
+		}
+		const auto peer = LoadedPeer(session, i->second);
+		const auto username = peer ? PublicUsername(peer) : QString();
+		const auto user = peer ? peer->asUser() : nullptr;
+		auto value = QString();
+		auto mentionName = QString();
+		if (!username.isEmpty()) {
+			value = '@' + username;
+		} else if (user) {
+			value = user->firstName.isEmpty()
+				? user->name()
+				: user->firstName;
+			mentionName = TextUtilities::MentionNameDataFromFields({
+				.selfId = session->userId().bare,
+				.userId = peerToUser(user->id).bare,
+				.accessHash = user->accessHash(),
+			});
+		}
+		if (!value.isEmpty()) {
+			ReplaceToken(text, from, till, value, *mention, mentionName);
+			position = from + int(value.size());
+		}
+		if (!ranges::contains(
+				replaced,
+				alias,
+				&std::pair<QString, QString>::first)) {
+			replaced.emplace_back(alias, value);
+		}
+	}
+	if (!replaced.empty()) {
+		ShowReplacedToast(history, replaced);
+	}
+}
