+void Changelog::activated(not_null<Main::Session*> session) {
+	const auto key = SessionKey(session);
+	if (_pending.remove(key)) {
+		request(session);
+		return;
+	} else if (!_started.emplace(key).second) {
+		return;
+	}
+	const auto accounts = ParseAccounts(ChangelogAccounts());
+	const auto i = accounts.find(key);
+	const auto existed = _existing.contains(&session->account());
+	const auto stored = (i != end(accounts))
+		? i->second
+		: existed
+		? ChangelogShown()
+		: BuildNumber();
+	if (stored >= BuildNumber()) {
+		if (i == end(accounts)) {
+			Store(key);
 		}
+	} else if (!ShowChangelog()) {
+		Store(key);
+	} else {
+		request(session);
+	}
+}
+
+void Changelog::request(not_null<Main::Session*> session) {
+	_waiting.push_back(base::make_weak(session));
+	if (_notes) {
+		flush();
+	} else if (!_fetching && !_failed) {
+		fetch();
 	}
-	return result;
 }
 
