+void Changelog::start() {
+	const auto build = BuildNumber();
+	const auto show = ShowChangelog();
+	const auto old = ChangelogShown();
+	auto accounts = ParseAccounts(ChangelogAccounts());
+	auto changed = false;
+	for (const auto &[index, account] : Core::App().domain().accounts()) {
+		_existing.emplace(account.get());
+		const auto session = account->maybeSession();
+		if (!session) {
+			continue;
+		}
+		const auto key = SessionKey(session);
+		_started.emplace(key);
+		const auto i = accounts.find(key);
+		const auto stored = (i != end(accounts)) ? i->second : old;
+		if (stored >= build) {
+			continue;
+		} else if (show) {
+			_pending.emplace(key);
 		} else {
-			fetch();
+			accounts[key] = build;
+			changed = true;
+		}
+	}
+	if (changed) {
+		SetChangelogAccounts(SerializeAccounts(accounts));
+	}
+	Core::App().domain().activeSessionValue(
+	) | rpl::on_next([=](Main::Session *session) {
+		if (session) {
+			activated(session);
 		}
 	}, _lifetime);
 }
 
