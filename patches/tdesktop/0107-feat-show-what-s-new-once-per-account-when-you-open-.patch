-	const auto notes = Parse(data);
+	_fetching = false;
+	auto notes = Parse(data);
 	if (!notes) {
 		fail(u"malformed changelog"_q);
 		return;
 	}
-	show(*notes);
+	_notes = std::move(notes);
+	flush();
 }
 
-void Changelog::show(const Notes &notes) {
-	const auto build = BuildNumber();
-	const auto sessions = this->sessions();
-	if (sessions.empty()) {
-		SetChangelogShown(build);
-	}
-	const auto left = std::make_shared<int>(int(sessions.size()));
-	for (const auto &session : sessions) {
-		const auto data = &session->data();
-		const auto messages = Messages(session, notes);
-		const auto add = [=] {
-			PostChangelog(session, messages);
-			if (!--*left) {
-				SetChangelogShown(build);
-			}
-		};
-		if (data->chatsListLoaded()) {
-			add();
-		} else {
-			data->chatsListLoadedEvents(
-			) | rpl::filter([](Data::Folder *folder) {
-				return !folder;
-			}) | rpl::take(1) | rpl::on_next(add, session->lifetime());
+void Changelog::fail(const QString &error) {
+	LOG(("Tele Changelog Error: %1").arg(error));
+	_fetching = false;
+	_failed = true;
+	_waiting.clear();
+}
+
+void Changelog::flush() {
+	for (const auto &weak : base::take(_waiting)) {
+		if (const auto session = weak.get()) {
+			post(session);
 		}
 	}
-	deleteLater();
 }
 
-void Changelog::fail(const QString &error) {
-	LOG(("Tele Changelog Error: %1").arg(error));
-	deleteLater();
+void Changelog::post(not_null<Main::Session*> session) {
+	const auto data = &session->data();
+	const auto key = SessionKey(session);
+	const auto messages = Messages(session, *_notes);
+	const auto add = [=] {
+		PostChangelog(session, messages);
+		Store(key);
+	};
+	if (data->chatsListLoaded()) {
+		add();
+	} else {
+		data->chatsListLoadedEvents(
+		) | rpl::filter([](Data::Folder *folder) {
+			return !folder;
+		}) | rpl::take(1) | rpl::on_next(add, session->lifetime());
+	}
 }
 
