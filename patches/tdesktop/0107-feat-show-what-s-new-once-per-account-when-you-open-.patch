+[[nodiscard]] Key SessionKey(not_null<Main::Session*> session) {
+	return session->userId().bare
+		| (session->isTestMode() ? kTestBit : Key());
+}
+
+[[nodiscard]] base::flat_map<Key, int> ParseAccounts(const QString &value) {
+	auto result = base::flat_map<Key, int>();
+	for (const auto &part : value.split(QChar(','), Qt::SkipEmptyParts)) {
+		auto entry = part.trimmed();
+		const auto test = entry.startsWith(u"test:"_q);
+		if (test) {
+			entry = entry.mid(5);
+		}
+		const auto pair = entry.split(QChar('='));
+		if (pair.size() != 2) {
+			continue;
+		}
+		auto idOk = false;
+		auto buildOk = false;
+		const auto id = pair[0].trimmed().toULongLong(&idOk);
+		const auto build = pair[1].trimmed().toInt(&buildOk);
+		if (idOk && buildOk && id && !(id & kTestBit) && build > 0) {
+			result[id | (test ? kTestBit : Key())] = build;
+		}
+	}
+	return result;
+}
+
+[[nodiscard]] QString SerializeAccounts(
+		const base::flat_map<Key, int> &accounts) {
+	auto list = QStringList();
+	list.reserve(int(accounts.size()));
+	for (const auto &[key, build] : accounts) {
+		list.push_back(((key & kTestBit) ? u"test:"_q : QString())
+			+ QString::number(key & ~kTestBit)
+			+ '='
+			+ QString::number(build));
+	}
+	return list.join(QChar(','));
+}
+
+void Store(Key key) {
+	auto accounts = ParseAccounts(ChangelogAccounts());
+	accounts[key] = BuildNumber();
+	SetChangelogAccounts(SerializeAccounts(accounts));
+}
+
