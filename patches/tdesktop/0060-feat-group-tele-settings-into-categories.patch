+CategorySection::CategorySection(
+	QWidget *parent,
+	not_null<Window::SessionController*> controller,
+	int index)
+: AbstractSection(parent, controller)
+, _index(index) {
+	const auto content = Ui::CreateChild<Ui::VerticalLayout>(this);
+	build(content, Categories()[_index].helper->build);
+	Ui::ResizeFitChild(this, content);
+}
+
+Type CategorySection::id() const {
+	return Categories()[_index].id;
+}
+
+rpl::producer<QString> CategorySection::title() {
+	return rpl::single(::Tele::Lower(Categories()[_index].title));
 }
 
