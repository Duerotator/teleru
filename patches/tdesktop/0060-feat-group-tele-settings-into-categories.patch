+[[nodiscard]] std::vector<Category> MakeCategories() {
+	auto result = std::vector<Category>();
+	const auto add = [&](
+			QString path,
+			QString title,
+			const style::icon &icon,
+			QStringList keywords,
+			void (*fill)(SectionBuilder&)) {
+		const auto id = Type(std::make_shared<CategoryFactory>(
+			int(result.size())));
+		auto meta = SectionMeta{
+			.id = id,
+			.parentId = TeleSection::Id(),
+			.icon = &icon,
+			.titleText = [=] { return ::Tele::Lower(title); },
+		};
+		result.push_back({
+			.path = std::move(path),
+			.title = std::move(title),
+			.icon = &icon,
+			.keywords = std::move(keywords),
+			.id = id,
+			.helper = std::make_unique<BuildHelper>(std::move(meta), fill),
+		});
+	};
+	add(
+		u"interface"_q,
+		u"Interface"_q,
+		st::menuIconPalette,
+		{ u"title"_q, u"lowercase"_q, u"badges"_q, u"userpics"_q },
+		FillInterface);
+	add(
+		u"chats"_q,
+		u"Chats and messages"_q,
+		st::menuIconChatBubble,
+		{ u"deleted"_q, u"edited"_q, u"links"_q, u"sponsored"_q },
+		FillChats);
+	add(
+		u"privacy"_q,
+		u"Privacy"_q,
+		st::menuIconStealth,
+		{ u"ghost"_q, u"stories"_q, u"ignore"_q, u"online"_q },
+		FillPrivacy);
+	add(
+		u"profiles"_q,
+		u"Profiles and IDs"_q,
+		st::menuIconProfile,
+		{ u"id"_q, u"dc"_q, u"gifts"_q },
+		FillProfiles);
+	add(
+		u"bots"_q,
+		u"Bots"_q,
+		st::menuIconBot,
+		{ u"buttons"_q, u"callback"_q },
+		FillBots);
+	add(
+		u"server"_q,
+		u"Server"_q,
+		st::menuIconNetwork,
+		{ u"verification"_q, u"checkmarks"_q },
+		FillServer);
+	add(
+		u"updates"_q,
+		u"Updates"_q,
+		st::menuIconDownload,
+		{ u"version"_q, u"github"_q },
+		FillUpdates);
+	return result;
+}
+
+const std::vector<Category> &Categories() {
+	static const auto result = MakeCategories();
+	return result;
+}
+
+[[nodiscard]] Type CategoryOf(
+		not_null<::Main::Session*> session,
+		const QString &id) {
+	if (id.isEmpty()) {
+		return nullptr;
+	}
+	for (const auto &category : Categories()) {
+		for (const auto &entry : category.helper->index(session)) {
+			if (entry.id == id) {
+				return category.id;
+			}
+		}
+	}
+	return nullptr;
+}
+
+const auto kMeta = BuildHelper({
+	.id = TeleSection::Id(),
+	.parentId = MainId(),
+	.icon = &st::menuIconCustomize,
+	.titleText = [] { return u"tele"_q; },
+}, FillRoot);
+
+[[maybe_unused]] const auto kCategoriesCount = Categories().size();
