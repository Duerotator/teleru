@@ -272,6 +298,29 @@ void AddGroupDivider(SectionBuilder &builder) {
 	builder.addSkip();
 }
 
+[[nodiscard]] not_null<Button*> AddResultButton(
+		not_null<Ui::VerticalLayout*> list,
+		const QString &title,
+		const QString &subtitle,
+		const style::icon *icon) {
+	const auto &st = st::settingsSearchResult;
+	const auto button = list->add(CreateButtonWithIcon(
+		list,
+		rpl::single(title),
+		st,
+		{ icon }));
+	const auto details = Ui::CreateChild<Ui::FlatLabel>(
+		button,
+		subtitle,
+		st::settingsSearchResultDetails);
+	details->show();
+	details->moveToLeft(
+		st.padding.left(),
+		st.padding.top() + st.height - details->height());
+	details->setAttribute(Qt::WA_TransparentForMouseEvents);
+	return button;
+}
+
 [[nodiscard]] QString BuildText() {
 	return ::Tele::Lower(u"Telegram Desktop %1 with tele patches, build %2."_q.arg(
 		QString::fromLatin1(AppVersionStr),
@@ -1129,12 +1178,141 @@ void TeleSection::showFinished() {
 	}
 }
 
+void TeleSection::setInnerFocus() {
+	if (_searchField) {
+		_searchField->setFocus();
+	} else {
+		setFocus();
+	}
+}
+
+void TeleSection::sectionSaveState(std::any &state) {
+	const auto query = _searchController
+		? _searchController->query()
+		: _pendingQuery;
+	if (!query.isEmpty()) {
+		state = TeleSearchState{ query };
+	}
+}
+
+void TeleSection::sectionRestoreState(const std::any &state) {
+	const auto saved = std::any_cast<TeleSearchState>(&state);
+	if (!saved || saved->query.isEmpty()) {
+		return;
+	} else if (_searchField) {
+		_searchField->setText(saved->query);
+	} else {
+		_pendingQuery = saved->query;
+	}
+}
+
+base::weak_qptr<Ui::RpWidget> TeleSection::createPinnedToTop(
+		not_null<QWidget*> parent) {
+	auto search = CreateSectionSearchRow(parent, base::take(_pendingQuery));
+	_searchController = std::move(search.controller);
+	_searchField = search.field;
+	const auto row = search.row;
+	_searchController->queryValue(
+	) | rpl::on_next([=](const QString &query) {
+		applyQuery(query);
+	}, row->lifetime());
+	_searchField->submits(
+	) | rpl::on_next([=](Qt::KeyboardModifiers) {
+		if (const auto open = _openFirst) {
+			open();
+		}
+	}, row->lifetime());
+	return base::make_weak(row);
+}
+
 void TeleSection::setupContent() {
 	const auto content = Ui::CreateChild<Ui::VerticalLayout>(this);
-	build(content, kMeta.build);
+	_main = content->add(object_ptr<Ui::SlideWrap<Ui::VerticalLayout>>(
+		content,
+		object_ptr<Ui::VerticalLayout>(content)));
+	_results = content->add(object_ptr<Ui::SlideWrap<Ui::VerticalLayout>>(
+		content,
+		object_ptr<Ui::VerticalLayout>(content)));
+	_results->hide(anim::type::instant);
+	build(_main->entity(), kMeta.build);
 	Ui::ResizeFitChild(this, content);
 }
 
+void TeleSection::buildIndex() {
+	const auto session = &controller()->session();
+	for (const auto &category : Categories()) {
+		const auto add = [&](SearchEntry &&entry) {
+			auto text = entry.title;
+			for (const auto &keyword : entry.keywords) {
+				text += ' ' + keyword;
+			}
+			_index.push_back({
+				.entry = std::move(entry),
+				.terms = SearchWords(text),
+				.category = &category,
+			});
+		};
+		add({
+			.title = ::Tele::Lower(category.title),
+			.keywords = category.keywords,
+			.section = category.id,
+		});
+		for (auto &entry : category.helper->index(session)) {
+			add(std::move(entry));
+		}
+	}
+}
+
+void TeleSection::applyQuery(const QString &query) {
+	const auto words = SearchWords(query);
+	const auto searching = !words.isEmpty();
+	_main->toggle(!searching, anim::type::instant);
+	_results->toggle(searching, anim::type::instant);
+	const auto list = _results->entity();
+	list->clear();
+	_openFirst = nullptr;
+	if (!searching) {
+		return;
+	} else if (_index.empty()) {
+		buildIndex();
+	}
+	for (const auto &result : _index) {
+		if (!MatchesWords(result.terms, words)) {
+			continue;
+		}
+		const auto &entry = result.entry;
+		const auto button = AddResultButton(
+			list,
+			entry.title,
+			(entry.id.isEmpty()
+				? u"tele"_q
+				: ::Tele::Lower(result.category->title)),
+			result.category->icon);
+		const auto id = entry.id;
+		const auto section = entry.section;
+		const auto open = [=] {
+			if (!id.isEmpty()) {
+				controller()->setHighlightControlId(id);
+			}
+			showOther(section);
+		};
+		button->addClickHandler(open);
+		SetupCopyLink(button, section, id);
+		if (!_openFirst) {
+			_openFirst = open;
+		}
+	}
+	if (!_openFirst) {
+		list->add(
+			object_ptr<Ui::FlatLabel>(
+				list,
+				tr::lng_search_tab_no_results(),
+				st::settingsSearchNoResults),
+			st::settingsSearchNoResultsPadding);
+	}
+	list->resizeToWidth(list->width());
+}
+
 } // namespace
 
 std::vector<std::pair<QString, Type>> TeleSettingsPaths() {
