From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: nitreojs <hello@starkow.dev>
Date: Sun, 27 Sep 2026 00:49:02 +0300
Subject: [PATCH] feat: show checkmarks and custom verification in the main
 menu

---
 .../SourceFiles/tele/tele_account_badges.cpp  | 45 +++++++++++++++++++
 .../SourceFiles/tele/tele_account_badges.h    | 23 ++++++++++
 .../SourceFiles/window/window_main_menu.cpp   | 32 ++++++++-----
 .../SourceFiles/window/window_main_menu.h     |  5 +++
 4 files changed, 93 insertions(+), 12 deletions(-)

diff --git a/Telegram/SourceFiles/tele/tele_account_badges.cpp b/Telegram/SourceFiles/tele/tele_account_badges.cpp
index e39dc9e95dce5dcd173c7e662a44b7980038e609..7815b6566bec16a675a979aa157bfbed4c4c49cb 100644
--- a/Telegram/SourceFiles/tele/tele_account_badges.cpp
+++ b/Telegram/SourceFiles/tele/tele_account_badges.cpp
@@ -52,4 +52,49 @@ void AddAccountBotVerify(
 	}, button->lifetime());
 }
 
+CoverBadges::CoverBadges(
+	not_null<QWidget*> parent,
+	not_null<UserData*> user,
+	Fn<bool()> paused)
+: _botVerify(std::make_unique<Info::Profile::Badge>(
+	parent,
+	st::settingsInfoPeerBadge,
+	&user->session(),
+	Info::Profile::BotVerifyBadgeForPeer(user),
+	nullptr,
+	paused,
+	0,
+	Info::Profile::BadgeType::BotVerified))
+, _verified(std::make_unique<Info::Profile::Badge>(
+	parent,
+	st::settingsInfoPeerBadge,
+	&user->session(),
+	Info::Profile::VerifiedContentForPeer(user),
+	nullptr,
+	paused,
+	0,
+	Info::Profile::BadgeType::Verified)) {
+}
+
+CoverBadges::~CoverBadges() = default;
+
+rpl::producer<> CoverBadges::updated() const {
+	return rpl::merge(_botVerify->updated(), _verified->updated());
+}
+
+int CoverBadges::leftSkip() const {
+	const auto widget = _botVerify->widget();
+	return widget ? (widget->width() + st::semiboldFont->spacew) : 0;
+}
+
+int CoverBadges::rightWidth() const {
+	const auto widget = _verified->widget();
+	return widget ? widget->width() : 0;
+}
+
+void CoverBadges::move(int left, int right, int top, int bottom) {
+	_botVerify->move(left, top, bottom);
+	_verified->move(right, top, bottom);
+}
+
 } // namespace Tele
diff --git a/Telegram/SourceFiles/tele/tele_account_badges.h b/Telegram/SourceFiles/tele/tele_account_badges.h
index 1afb21066aca1f9af6256518d2fd72985840e2f9..d0e57833ab968a1e95a49395991a437e34034547 100644
--- a/Telegram/SourceFiles/tele/tele_account_badges.h
+++ b/Telegram/SourceFiles/tele/tele_account_badges.h
@@ -10,6 +10,10 @@ namespace Ui {
 class SettingsButton;
 } // namespace Ui
 
+namespace Info::Profile {
+class Badge;
+} // namespace Info::Profile
+
 namespace Tele {
 
 [[nodiscard]] const style::SettingsButton &AccountButtonStyle(
@@ -19,4 +23,23 @@ void AddAccountBotVerify(
 	not_null<UserData*> user,
 	Fn<bool()> paused);
 
+class CoverBadges final {
+public:
+	CoverBadges(
+		not_null<QWidget*> parent,
+		not_null<UserData*> user,
+		Fn<bool()> paused);
+	~CoverBadges();
+
+	[[nodiscard]] rpl::producer<> updated() const;
+	[[nodiscard]] int leftSkip() const;
+	[[nodiscard]] int rightWidth() const;
+	void move(int left, int right, int top, int bottom);
+
+private:
+	const std::unique_ptr<Info::Profile::Badge> _botVerify;
+	const std::unique_ptr<Info::Profile::Badge> _verified;
+
+};
+
 } // namespace Tele
diff --git a/Telegram/SourceFiles/window/window_main_menu.cpp b/Telegram/SourceFiles/window/window_main_menu.cpp
index 0782599d4394bd544b26f24c919537de53ca6d5d..f5d50a012e5ff47eb4a8a1feb14db5dc4e7cd30a 100644
--- a/Telegram/SourceFiles/window/window_main_menu.cpp
+++ b/Telegram/SourceFiles/window/window_main_menu.cpp
@@ -28,6 +28,7 @@ https://github.com/telegramdesktop/tdesktop/blob/master/LEGAL
 #include "data/data_user.h"
 #include "info/info_memento.h"
 #include "info/profile/info_profile_badge.h"
+#include "tele/tele_account_badges.h"
 #include "settings/settings_common.h"
 #include "info/profile/info_profile_emoji_status_panel.h"
 #include "info/profile/info_profile_icon.h"
@@ -324,6 +325,10 @@ MainMenu::MainMenu(
 	[=] { return controller->isGifPausedAtLeastFor(GifPauseReason::Layer); },
 	kPlayStatusLimit,
 	Info::Profile::BadgeType::Premium))
+, _teleBadges(std::make_unique<Tele::CoverBadges>(
+	this,
+	controller->session().user(),
+	[=] { return controller->isGifPausedAtLeastFor(GifPauseReason::Layer); }))
 , _scroll(this, st::defaultSolidScroll)
 , _inner(_scroll->setOwnedWidget(
 	object_ptr<Ui::VerticalLayout>(_scroll.data())))
@@ -412,7 +417,8 @@ MainMenu::MainMenu(
 
 	rpl::combine(
 		_toggleAccounts->rightSkipValue(),
-		rpl::single(rpl::empty) | rpl::then(_badge->updated())
+		rpl::single(rpl::empty) | rpl::then(
+			rpl::merge(_badge->updated(), _teleBadges->updated()))
 	) | rpl::on_next([=] {
 		moveBadge();
 	}, lifetime());
@@ -469,19 +475,19 @@ MainMenu::MainMenu(
 MainMenu::~MainMenu() = default;
 
 void MainMenu::moveBadge() {
-	if (!_badge->widget()) {
-		return;
-	}
+	const auto nameLeft = st::mainMenuCoverNameLeft + _teleBadges->leftSkip();
+	const auto badge = _badge->widget() ? _badge->widget()->width() : 0;
 	const auto available = width()
-		- st::mainMenuCoverNameLeft
+		- nameLeft
 		- _toggleAccounts->rightSkip()
-		- _badge->widget()->width();
-	const auto left = st::mainMenuCoverNameLeft
+		- badge
+		- _teleBadges->rightWidth();
+	const auto left = nameLeft
 		+ std::min(_name.maxWidth() + st::semiboldFont->spacew, available);
-	_badge->move(
-		left,
-		st::mainMenuCoverNameTop,
-		st::mainMenuCoverNameTop + st::semiboldFont->height);
+	const auto top = st::mainMenuCoverNameTop;
+	const auto bottom = top + st::semiboldFont->height;
+	_badge->move(left, top, bottom);
+	_teleBadges->move(st::mainMenuCoverNameLeft, left + badge, top, bottom);
 }
 
 void MainMenu::setupArchive() {
@@ -900,9 +906,11 @@ void MainMenu::drawName(Painter &p) {
 	p.setPen(st::windowBoldFg);
 	_name.drawLeftElided(
 		p,
-		st::mainMenuCoverNameLeft,
+		st::mainMenuCoverNameLeft + _teleBadges->leftSkip(),
 		st::mainMenuCoverNameTop,
 		(widthText
+			- _teleBadges->leftSkip()
+			- _teleBadges->rightWidth()
 			- (_badge->widget()
 				? (st::semiboldFont->spacew + _badge->widget()->width())
 				: 0)),
