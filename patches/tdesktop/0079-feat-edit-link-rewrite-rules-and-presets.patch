+void AddLinkRewrites(SectionBuilder &builder) {
+	const auto &option = base::options::lookup<QString>(
+		::Tele::kOptionLinkRewrites);
+	const auto controller = builder.controller();
+	const auto description = ::Tele::Lower(option.description());
+	const auto button = builder.addButton({
+		.id = option.id(),
+		.title = rpl::single(::Tele::Lower(option.name())),
+		.st = &st::settingsButtonNoIcon,
+		.label = ::Tele::LinkRewritesEnabledCountValue(
+		) | rpl::map([](int count) {
+			return count ? QString::number(count) : u"off"_q;
+		}),
+		.onClick = [=] {
+			controller->show(Box(::Tele::LinkRewritesBox));
+		},
+		.keywords = {
+			description,
+			u"paste"_q,
+			u"twitter"_q,
+			u"fixupx"_q,
+			u"embed"_q,
+		},
+	});
+	if (button) {
+		SetupLink(button, option.id());
+	}
+	AddAbout(builder, description);
+}
+
 void FillInterface(SectionBuilder &builder) {
 	builder.addSkip();
 	AddGroupTitle(builder, u"Title bar"_q);
@@ -1315,6 +1347,7 @@ void FillChats(SectionBuilder &builder) {
 	AddOptionToggle(builder, ::Tele::kOptionCleanOpenedLinks);
 	AddOptionToggle(builder, ::Tele::kOptionCleanSentLinks);
 	AddOptionToggle(builder, ::Tele::kOptionOpenLinksInApps);
