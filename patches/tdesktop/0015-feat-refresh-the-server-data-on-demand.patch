From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: nitreojs <hello@starkow.dev>
Date: Sun, 27 Sep 2026 00:32:07 +0300
Subject: [PATCH] feat: refresh the server data on demand

---
 .../SourceFiles/settings/settings_tele.cpp    |  9 ++++++
 Telegram/SourceFiles/tele/tele_badges.cpp     | 28 +++++++++++++++++++
 Telegram/SourceFiles/tele/tele_badges.h       |  1 +
 3 files changed, 38 insertions(+)

diff --git a/Telegram/SourceFiles/settings/settings_tele.cpp b/Telegram/SourceFiles/settings/settings_tele.cpp
index 12aa438260fb4686b606ab8debfd83c198d3bcef..32652a620bb4683b031b85dc5ef8a6235e00717a 100644
--- a/Telegram/SourceFiles/settings/settings_tele.cpp
+++ b/Telegram/SourceFiles/settings/settings_tele.cpp
@@ -210,6 +210,15 @@ void AddServer(
 	)->setClickedCallback([=] {
 		controller->show(Box(ServerBox));
 	});
+	container->add(object_ptr<Button>(
+		container,
+		rpl::single(u"Refresh now"_q),
+		st::settingsButtonNoIcon
+	))->setClickedCallback([=] {
+		::Tele::RefreshBadges(crl::guard(controller, [=](QString text) {
+			controller->showToast(text);
+		}));
+	});
 	container->add(
 		object_ptr<Ui::FlatLabel>(
 			container,
diff --git a/Telegram/SourceFiles/tele/tele_badges.cpp b/Telegram/SourceFiles/tele/tele_badges.cpp
index ad7967cb7f62aad174c95fc9fefc0b288e13d53f..53c84885c2ba0c7b1baad626edc12a73ab80966a 100644
--- a/Telegram/SourceFiles/tele/tele_badges.cpp
+++ b/Telegram/SourceFiles/tele/tele_badges.cpp
@@ -324,8 +324,10 @@ public:
 	[[nodiscard]] bool active() const;
 	[[nodiscard]] bool verified(PeerKey key);
 	[[nodiscard]] const Entry *applied(PeerKey key) const;
+	void refreshNow(Fn<void(QString)> done);
 
 private:
+	void answer(const QString &text);
 	void loadCache();
 	void writeCache(const QJsonObject &feed) const;
 	void fetch();
@@ -359,6 +361,7 @@ private:
 	std::unordered_set<PeerKey> _failed;
 	std::deque<PeerKey> _queue;
 	std::vector<PeerKey> _inFlight;
+	std::vector<Fn<void(QString)>> _waiting;
 	uint64 _generation = 0;
 	bool _hashing = false;
 	bool _batchScheduled = false;
@@ -379,6 +382,17 @@ Badges::Badges()
 	}, _lifetime);
 }
 
+void Badges::refreshNow(Fn<void(QString)> done) {
+	_waiting.push_back(std::move(done));
+	fetch();
+}
+
+void Badges::answer(const QString &text) {
+	for (const auto &callback : base::take(_waiting)) {
+		callback(text);
+	}
+}
+
 bool Badges::active() const {
 	return _feed && !_feed->entries.empty();
 }
@@ -451,6 +465,9 @@ void Badges::fetch() {
 		_url = _etag = QString();
 		setFeed(std::nullopt);
 		QFile::remove(CachePath());
+		answer(url
+			? u"the tele server is off"_q
+			: u"the tele server url is invalid"_q);
 		return;
 	} else if (*url != _url) {
 		_url = *url;
@@ -506,6 +523,7 @@ void Badges::fetched(
 		return;
 	} else if (code == 304) {
 		_timer.callOnce(kFetchInterval);
+		answer(u"server data is up to date"_q);
 		return;
 	} else if (code != 200) {
 		fail(u"unexpected http status %1"_q.arg(code));
@@ -529,11 +547,13 @@ void Badges::fetched(
 	writeCache(document.object());
 	setFeed(std::move(feed));
 	_timer.callOnce(kFetchInterval);
+	answer(u"server data updated"_q);
 }
 
 void Badges::fail(const QString &error) {
 	LOG(("Tele Badges Error: %1").arg(error));
 	_timer.callOnce(kFetchInterval);
+	answer(u"couldn't refresh the server data: %1"_q.arg(error));
 }
 
 void Badges::setFeed(std::optional<Feed> feed) {
@@ -722,6 +742,14 @@ void StartBadges() {
 	}
 }
 
+void RefreshBadges(Fn<void(QString)> done) {
+	if (Instance) {
+		Instance->refreshNow(std::move(done));
+	} else {
+		done(u"the tele server isn't running yet"_q);
+	}
+}
+
 bool Verified(not_null<PeerData*> peer) {
 	if (!Instance || !Instance->active()) {
 		return false;
