From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: nitreojs <hello@starkow.dev>
Date: Sun, 27 Sep 2026 01:31:05 +0300
Subject: [PATCH] feat: animate custom verification icons

---
 .../info/profile/info_profile_badge.cpp       |  6 +--
 Telegram/SourceFiles/ui/unread_badge.cpp      | 43 ++++++++-----------
 2 files changed, 21 insertions(+), 28 deletions(-)

diff --git a/Telegram/SourceFiles/info/profile/info_profile_badge.cpp b/Telegram/SourceFiles/info/profile/info_profile_badge.cpp
index 1b058ae69f4a956c8b6d48a10771c7fb039e4676..78acde4d2b78d1c3c331598082513585d944af96 100644
--- a/Telegram/SourceFiles/info/profile/info_profile_badge.cpp
+++ b/Telegram/SourceFiles/info/profile/info_profile_badge.cpp
@@ -126,10 +126,8 @@ void Badge::setContent(Content content) {
 				Data::EmojiStatusCustomId(id),
 				[raw = _view.data()] { raw->update(); },
 				sizeTag());
-			if (_content.badge == BadgeType::BotVerified) {
-				_emojiStatus = MakeWrappedEmoji<Ui::Text::FirstFrameEmoji>(
-					std::move(_emojiStatus));
-			} else if (_customStatusLoopsLimit > 0) {
+			if (_content.badge != BadgeType::BotVerified
+				&& _customStatusLoopsLimit > 0) {
 				_emojiStatus = MakeWrappedEmoji<Ui::Text::LimitedLoopsEmoji>(
 					std::move(_emojiStatus),
 					_customStatusLoopsLimit);
diff --git a/Telegram/SourceFiles/ui/unread_badge.cpp b/Telegram/SourceFiles/ui/unread_badge.cpp
index 4c417cb2ebceed208d2f05ee17033566721ac9d4..37bb050311647243b88629f3b9e10ad4adf55ad8 100644
--- a/Telegram/SourceFiles/ui/unread_badge.cpp
+++ b/Telegram/SourceFiles/ui/unread_badge.cpp
@@ -46,7 +46,6 @@ private:
 	const int _innerSize = 0;
 	const int _outerSize = 0;
 	QImage _frame;
-	QColor _frameColor;
 
 };
 
@@ -68,35 +67,30 @@ QString ScaledBotVerifiedEmoji::entityData() {
 }
 
 void ScaledBotVerifiedEmoji::paint(QPainter &p, const Context &context) {
-	if (_frame.isNull() || _frameColor != context.textColor) {
-		if (!_wrapped->ready()) {
-			return;
-		}
-		const auto ratio = style::DevicePixelRatio();
-		const auto sourcePx = Data::FrameSizeFromTag(
-			Data::CustomEmojiSizeTag::Isolated);
+	if (!_wrapped->ready()) {
+		return;
+	}
+	const auto ratio = style::DevicePixelRatio();
+	const auto sourcePx = Data::FrameSizeFromTag(
+		Data::CustomEmojiSizeTag::Isolated);
+	if (_frame.width() != sourcePx) {
 		_frame = QImage(
 			QSize(sourcePx, sourcePx),
 			QImage::Format_ARGB32_Premultiplied);
 		_frame.setDevicePixelRatio(ratio);
-		_frame.fill(Qt::transparent);
-
-		auto painter = QPainter(&_frame);
-		painter.translate(-context.position);
-		const auto was = context.internal.forceFirstFrame;
-		context.internal.forceFirstFrame = true;
-		_wrapped->paint(painter, context);
-		context.internal.forceFirstFrame = was;
-		painter.end();
-
-		_frame = _frame.scaled(
-			QSize(_innerSize, _innerSize) * ratio,
-			Qt::IgnoreAspectRatio,
-			Qt::SmoothTransformation);
-		_frameColor = context.textColor;
 	}
+	_frame.fill(Qt::transparent);
+
+	auto painter = QPainter(&_frame);
+	painter.translate(-context.position);
+	_wrapped->paint(painter, context);
+	painter.end();
+
 	const auto skip = (_outerSize - _innerSize) / 2;
-	p.drawImage(context.position + QPoint(skip, skip), _frame);
+	auto hq = PainterHighQualityEnabler(p);
+	p.drawImage(
+		QRect(context.position + QPoint(skip, skip), Size(_innerSize)),
+		_frame);
 }
 
 void ScaledBotVerifiedEmoji::unload() {
@@ -482,6 +476,7 @@ int PeerBadge::drawVerified(
 			.textColor = st.color->c,
 			.now = crl::now(),
 			.position = position + st.position,
+			.paused = On(PowerSaving::kEmojiStatus),
 		});
 		return icon->width();
 	}
