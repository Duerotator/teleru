From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: nitreojs <hello@starkow.dev>
Date: Mon, 28 Sep 2026 02:43:11 +0300
Subject: [PATCH] feat: clear the tele server's cached data

---
 .../SourceFiles/settings/settings_tele.cpp    | 14 +++++++
 Telegram/SourceFiles/tele/tele_badges.cpp     | 41 ++++++++++++++++---
 Telegram/SourceFiles/tele/tele_badges.h       |  1 +
 3 files changed, 50 insertions(+), 6 deletions(-)

diff --git a/Telegram/SourceFiles/settings/settings_tele.cpp b/Telegram/SourceFiles/settings/settings_tele.cpp
index 4f4183002d45b92e0950971396e174b84243ded7..6084d6709179fd96df5ca2a0ec4b662744897574 100644
--- a/Telegram/SourceFiles/settings/settings_tele.cpp
+++ b/Telegram/SourceFiles/settings/settings_tele.cpp
@@ -469,6 +469,20 @@ void AddServer(SectionBuilder &builder) {
 	if (refresh) {
 		SetupLink(refresh, u"tele-refresh-badges"_q);
 	}
+	const auto clear = builder.addButton({
+		.id = u"tele-clear-badges"_q,
+		.title = rpl::single(::Tele::Lower(u"Clear cached data"_q)),
+		.st = &st::settingsButtonNoIcon,
+		.onClick = [=] {
+			::Tele::ClearBadgesCache(crl::guard(controller, [=](QString text) {
+				controller->showToast(text);
+			}));
+		},
+		.keywords = { u"cache"_q, u"badges"_q, u"verification"_q },
+	});
+	if (clear) {
+		SetupLink(clear, u"tele-clear-badges"_q);
+	}
 	AddAbout(builder, description);
 }
 
diff --git a/Telegram/SourceFiles/tele/tele_badges.cpp b/Telegram/SourceFiles/tele/tele_badges.cpp
index b48e0922fabe4e78809400b4eb9de9acc69f07c7..2b58444ffef2a77cf6cca5cc9c06b493a1f3f26a 100644
--- a/Telegram/SourceFiles/tele/tele_badges.cpp
+++ b/Telegram/SourceFiles/tele/tele_badges.cpp
@@ -362,8 +362,10 @@ public:
 	[[nodiscard]] const Entry *lookup(PeerKey key);
 	[[nodiscard]] const Entry *applied(PeerKey key) const;
 	void refreshNow(Fn<void(QString)> done);
+	void clearCache(Fn<void(QString)> done);
 
 private:
+	void cancel();
 	void answer(const QString &text);
 	void loadCache();
 	void writeCache(const QJsonObject &feed) const;
@@ -424,6 +426,29 @@ void Badges::refreshNow(Fn<void(QString)> done) {
 	fetch();
 }
 
+void Badges::clearCache(Fn<void(QString)> done) {
+	cancel();
+	QFile::remove(CachePath());
+	_etag = QString();
+	setFeed(std::nullopt);
+	const auto url = NormalizeServerUrl(ServerUrl());
+	if (!url || url->isEmpty() || ServerOffForLaunch()) {
+		done(u"cached server data cleared"_q);
+		return;
+	}
+	_waiting.push_back(std::move(done));
+	fetch();
+}
+
+void Badges::cancel() {
+	_timer.cancel();
+	if (const auto reply = base::take(_reply).data()) {
+		reply->disconnect(this);
+		reply->abort();
+		reply->deleteLater();
+	}
+}
+
 void Badges::answer(const QString &text) {
 	for (const auto &callback : base::take(_waiting)) {
 		callback(text);
@@ -488,12 +513,7 @@ void Badges::writeCache(const QJsonObject &feed) const {
 }
 
 void Badges::fetch() {
-	_timer.cancel();
-	if (const auto reply = base::take(_reply).data()) {
-		reply->disconnect(this);
-		reply->abort();
-		reply->deleteLater();
-	}
+	cancel();
 	const auto url = NormalizeServerUrl(ServerUrl());
 	if (!url || url->isEmpty()) {
 		if (!url) {
@@ -815,6 +835,15 @@ void RefreshBadges(Fn<void(QString)> done) {
 	}
 }
 
+void ClearBadgesCache(Fn<void(QString)> done) {
+	if (Instance) {
+		Instance->clearCache(std::move(done));
+	} else {
+		QFile::remove(CachePath());
+		done(u"cached server data cleared"_q);
+	}
+}
+
 bool Verified(not_null<PeerData*> peer) {
 	const auto entry = Lookup(peer);
 	return entry && entry->checkmark;
diff --git a/Telegram/SourceFiles/tele/tele_badges.h b/Telegram/SourceFiles/tele/tele_badges.h
index fb9fd198c80850ccbeb1b3640558f647d902016a..3df560f1c0697e81a731b6e46c0330c689e22fe4 100644
--- a/Telegram/SourceFiles/tele/tele_badges.h
+++ b/Telegram/SourceFiles/tele/tele_badges.h
@@ -11,6 +11,7 @@ namespace Tele {
 
 void StartBadges();
 void RefreshBadges(Fn<void(QString)> done);
+void ClearBadgesCache(Fn<void(QString)> done);
 
 [[nodiscard]] bool Verified(not_null<PeerData*> peer);
 [[nodiscard]] bool Scam(not_null<PeerData*> peer);
