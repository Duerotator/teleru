+[[nodiscard]] int PillWidth(
+		const style::IconEmoji &icon,
+		const QString &text) {
+	return PillPaddingLeft()
+		+ icon.icon.width()
+		+ PillIconSkip()
+		+ st::normalFont->width(text)
