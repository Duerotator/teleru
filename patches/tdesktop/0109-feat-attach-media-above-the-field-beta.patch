+
+void DraftsStore::readDocked() {
+	auto file = FileReadDescriptor();
+	const auto key = _session->local().peekLegacyLocalKey();
+	if (!key || !ReadEncryptedFile(file, u"docked"_q, folder(), key)) {
+		return;
+	}
+	auto magic = quint32();
+	auto version = qint32();
+	auto owner = quint64();
+	auto count = quint32();
+	file.stream >> magic >> version >> owner >> count;
+	if (!CheckStreamStatus(file.stream)
+		|| magic != kDockedMagic
+		|| version < 1
+		|| version > kDockedVersion
+		|| owner != _session->uniqueId()) {
+		return;
+	}
+	for (auto i = quint32(); i != count; ++i) {
+		auto peer = quint64();
+		auto topicRootId = qint64();
+		auto monoforumPeerId = quint64();
+		auto flags = qint32();
+		auto way = qint32();
+		auto filesCount = quint32();
+		file.stream
+			>> peer
+			>> topicRootId
+			>> monoforumPeerId
+			>> flags
+			>> way
+			>> filesCount;
+		if (!CheckStreamStatus(file.stream) || filesCount > 1024) {
+			return;
+		}
+		auto docked = SavedDocked{
+			.way = way,
+			.collapsed = (flags & 2) != 0,
+		};
+		for (auto j = quint32(); j != filesCount; ++j) {
+			auto entry = SavedDockedFile();
+			auto size = qint64();
+			auto spoiler = qint32();
+			auto type = qint32();
+			file.stream
+				>> entry.file.name
+				>> entry.file.stored
+				>> size
+				>> entry.file.thumbnail
+				>> spoiler
+				>> entry.path
+				>> type;
+			if (version >= 2) {
+				auto coverSize = qint64();
+				file.stream
+					>> entry.cover.name
+					>> entry.cover.stored
+					>> coverSize
+					>> entry.cover.thumbnail
+					>> entry.modifications;
+				entry.cover.size = coverSize;
+			}
+			if (!CheckStreamStatus(file.stream)) {
+				return;
+			}
+			entry.file.size = size;
+			entry.file.spoiler = (spoiler != 0);
+			entry.type = type;
+			docked.files.push_back(std::move(entry));
+		}
+		const auto dockedKey = DockedKey{
+			.thread = {
+				.peer = DeserializePeerId(peer),
+				.topicRootId = MsgId(topicRootId),
+				.monoforumPeerId = DeserializePeerId(monoforumPeerId),
+			},
+			.scheduled = (flags & 1) != 0,
+			.stashed = (flags & 4) != 0,
+		};
+		if (dockedKey && !docked.files.empty()) {
+			_docked[dockedKey] = std::move(docked);
+		}
+	}
+}
+
+void DraftsStore::writeDocked() {
+	const auto key = _session->local().peekLegacyLocalKey();
+	if (!key) {
+		return;
+	}
+	auto size = sizeof(quint32) * 3 + sizeof(quint64);
+	for (const auto &[dockedKey, docked] : _docked) {
+		size += 64;
+		for (const auto &entry : docked.files) {
+			size += 192
+				+ (entry.file.name.size() + entry.path.size()) * sizeof(QChar)
+				+ entry.file.thumbnail.size()
+				+ entry.cover.name.size() * sizeof(QChar)
+				+ entry.cover.thumbnail.size()
+				+ entry.modifications.size();
+		}
+	}
+	auto data = EncryptedDescriptor(size);
+	data.stream
+		<< kDockedMagic
+		<< kDockedVersion
+		<< quint64(_session->uniqueId())
+		<< quint32(_docked.size());
+	for (const auto &[dockedKey, docked] : _docked) {
+		data.stream
+			<< SerializePeerId(dockedKey.thread.peer)
+			<< qint64(dockedKey.thread.topicRootId.bare)
+			<< SerializePeerId(dockedKey.thread.monoforumPeerId)
+			<< qint32((dockedKey.scheduled ? 1 : 0)
+				| (docked.collapsed ? 2 : 0)
+				| (dockedKey.stashed ? 4 : 0))
+			<< qint32(docked.way)
+			<< quint32(docked.files.size());
+		for (const auto &entry : docked.files) {
+			data.stream
+				<< entry.file.name
+				<< entry.file.stored
+				<< qint64(entry.file.size)
+				<< entry.file.thumbnail
+				<< qint32(entry.file.spoiler ? 1 : 0)
+				<< entry.path
+				<< qint32(entry.type)
+				<< entry.cover.name
+				<< entry.cover.stored
+				<< qint64(entry.cover.size)
+				<< entry.cover.thumbnail
+				<< entry.modifications;
+		}
+	}
+	auto file = FileWriteDescriptor(u"docked"_q, folder());
+	file.writeEncrypted(data, key);
+}
