+	result.spoiler = file.spoiler;
+	result.sendLargePhotos = file.sendLargePhotos;
+	result.animationJob = file.animationJob;
+	result.archive = file.archive;
+	return result;
+}
+
+[[nodiscard]] bool Consumed(const Ui::PreparedBundle &bundle) {
+	return ranges::any_of(bundle.groups, [](const Ui::PreparedGroup &group) {
+		return group.list.files.empty()
+			|| ranges::any_of(
+				group.list.files,
+				[](const Ui::PreparedFile &file) { return !file.information; });
+	});
+}
+
+[[nodiscard]] std::shared_ptr<Ui::PreparedBundle> WatchBundle(
+		std::shared_ptr<Ui::PreparedBundle> bundle,
+		Fn<void(bool)> done) {
+	return std::shared_ptr<Ui::PreparedBundle>(
+		new Ui::PreparedBundle(std::move(*bundle)),
+		[=](Ui::PreparedBundle *raw) {
+			const auto consumed = Consumed(*raw);
+			delete raw;
+			done(consumed);
+		});
+}
+
+[[nodiscard]] bool Prepared(const Ui::PreparedList &list) {
+	return ranges::all_of(list.files, [](const Ui::PreparedFile &file) {
+		return (file.information != nullptr);
+	});
+}
+
+[[nodiscard]] bool Slowmode(PeerData *peer) {
+	return peer && bool(DefaultLimitsForPeer(peer) & SendFilesAllow::OnlyOne);
+}
+
+[[nodiscard]] ImageInfo *LookupImage(const Ui::PreparedFile &file) {
+	return file.information
+		? std::get_if<ImageInfo>(&file.information->media)
+		: nullptr;
+}
+
+[[nodiscard]] VideoInfo *LookupVideo(const Ui::PreparedFile &file) {
+	return file.information
+		? std::get_if<VideoInfo>(&file.information->media)
+		: nullptr;
+}
+
+[[nodiscard]] EditKind KindOf(const Ui::PreparedFile &file, bool compress) {
+	if (!compress || !file.information) {
+		return EditKind::None;
+	} else if (file.type == FileType::Photo && LookupImage(file)) {
+		return EditKind::Photo;
+	} else if (file.canEditVideo()) {
+		return EditKind::Video;
+	}
+	return EditKind::None;
+}
+
+[[nodiscard]] QByteArray SerializeVideoModifications(
+		const Ui::PreparedFile &file) {
+	const auto video = LookupVideo(file);
+	if (!video) {
+		return QByteArray();
+	}
+	const auto &mods = video->modifications;
+	const auto &geometry = mods.geometry;
+	if (!mods.from
+		&& !mods.till
+		&& !mods.cover
+		&& !mods.quality
+		&& !mods.gif
+		&& !geometry.angle
+		&& !geometry.flipped
+		&& geometry.crop.isEmpty()) {
+		return QByteArray();
+	}
+	auto result = QByteArray();
+	{
+		QDataStream stream(&result, QIODevice::WriteOnly);
+		stream.setVersion(QDataStream::Qt_5_1);
+		stream
+			<< qint64(mods.from)
+			<< qint64(mods.till)
+			<< qint64(mods.cover)
+			<< qint32(mods.quality)
+			<< qint32(mods.gif ? 1 : 0)
+			<< qint32(geometry.angle)
+			<< qint32(geometry.flipped ? 1 : 0)
+			<< geometry.crop;
+	}
+	return result;
+}
+
+void ApplySavedVideo(
+		Ui::PreparedFile &file,
+		const QByteArray &serialized,
+		int sideLimit) {
+	const auto video = LookupVideo(file);
+	if (!video || serialized.isEmpty()) {
+		return;
+	}
+	QDataStream stream(serialized);
+	stream.setVersion(QDataStream::Qt_5_1);
+	auto from = qint64();
+	auto till = qint64();
+	auto cover = qint64();
+	auto quality = qint32();
+	auto gif = qint32();
+	auto angle = qint32();
+	auto flipped = qint32();
+	auto crop = QRect();
+	stream
+		>> from
+		>> till
+		>> cover
+		>> quality
+		>> gif
+		>> angle
+		>> flipped
+		>> crop;
+	if (stream.status() != QDataStream::Ok) {
+		return;
+	}
+	auto &mods = video->modifications;
+	mods.from = from;
+	mods.till = till;
+	mods.cover = cover;
+	mods.quality = quality;
+	mods.gif = (gif != 0);
+	mods.geometry.angle = angle;
+	mods.geometry.flipped = (flipped != 0);
+	mods.geometry.crop = crop;
+	if (cover) {
+		auto frame = Media::Video::ExtractFrame(
+			file.path,
+			file.content,
+			cover,
+			video->thumbnail.size());
+		if (!frame.isNull()) {
+			video->thumbnail = std::move(frame);
+		}
+	}
+	Storage::UpdateVideoDetails(file, st::sendMediaPreviewSize, sideLimit);
+}
+
+void AttachSavedCover(
+		Ui::PreparedFile &file,
+		const QString &path,
+		int sideLimit) {
+	if (path.isEmpty() || !LookupVideo(file)) {
+		return;
+	}
+	auto cover = std::make_unique<Ui::PreparedFile>(path);
+	cover->size = QFileInfo(path).size();
+	Storage::PrepareDetails(*cover, st::sendMediaPreviewSize, sideLimit);
+	if (LookupImage(*cover)) {
+		file.videoCover = std::move(cover);
+	}
+}
+
+[[nodiscard]] QString BakedName(const Ui::PreparedFile &file) {
+	const auto base = QFileInfo(!file.displayName.isEmpty()
+		? file.displayName
+		: file.path).completeBaseName();
+	return (base.isEmpty() ? u"image"_q : base) + u".png"_q;
+}
+
+[[nodiscard]] std::optional<DraftFileSource> BakedSource(
+		const Ui::PreparedFile &file,
+		const QString &name) {
+	const auto image = LookupImage(file);
+	if (!image || image->data.isNull()) {
+		return std::nullopt;
+	}
+	auto baked = image->modifications
+		? Editor::ImageModified(image->data, image->modifications)
+		: image->data;
+	if (baked.isNull()) {
+		return std::nullopt;
+	}
+	return DraftFileSource{
+		.image = baked,
+		.name = name,
+		.thumbnail = file.preview.isNull() ? baked : file.preview,
+		.spoiler = file.spoiler,
+	};
+}
+
+[[nodiscard]] Ui::PreparedFile Placeholder(const SavedDockedFile &saved) {
+	auto result = Ui::PreparedFile(QString());
+	result.displayName = saved.file.name;
+	result.size = saved.file.size;
+	result.type = TypeFromInt(saved.type);
+	result.spoiler = saved.file.spoiler;
+	if (!saved.file.thumbnail.isEmpty()) {
+		result.preview = QImage::fromData(saved.file.thumbnail);
+	}
+	return result;
+}
+
+[[nodiscard]] Ui::PreparedFile PendingPlaceholder(
+		const Ui::PreparedFile &file) {
+	auto result = Ui::PreparedFile(file.path);
+	result.displayName = file.displayName;
+	result.size = file.size;
+	result.type = file.type;
+	result.spoiler = file.spoiler;
+	result.preview = file.preview;
+	return result;
+}
+
+[[nodiscard]] bool CanSpoiler(const Ui::PreparedFile &file, bool compress) {
+	return compress
+		&& (file.type == FileType::Photo || file.type == FileType::Video);
+}
+
+[[nodiscard]] QString CountText(int count, const QString &one, QString many) {
+	return (count == 1) ? one : many.arg(count);
+}
+
+[[nodiscard]] QString TitleText(const Ui::PreparedList &list) {
+	auto photos = 0;
+	auto videos = 0;
+	auto files = 0;
+	for (const auto &file : list.files) {
+		if (file.type == FileType::Photo) {
+			++photos;
+		} else if (file.type == FileType::Video) {
+			++videos;
+		} else {
+			++files;
+		}
+	}
+	auto parts = QStringList();
+	if (photos) {
+		parts.push_back(CountText(photos, u"1 photo"_q, u"%1 photos"_q));
+	}
+	if (videos) {
+		parts.push_back(CountText(videos, u"1 video"_q, u"%1 videos"_q));
+	}
+	if (files) {
+		parts.push_back(CountText(files, u"1 file"_q, u"%1 files"_q));
+	}
+	return Lower(parts.join(u", "_q));
+}
+
+[[nodiscard]] QImage PreviewImage(const Ui::PreparedFile &file) {
+	if (!file.preview.isNull()) {
+		return file.preview;
+	} else if (file.information) {
+		using Image = Ui::PreparedFileInformation::Image;
+		using Video = Ui::PreparedFileInformation::Video;
+		if (const auto image = std::get_if<Image>(&file.information->media)) {
+			return image->data;
+		} else if (const auto video = std::get_if<Video>(
+				&file.information->media)) {
+			return video->thumbnail;
+		}
+	}
+	return QImage();
+}
+
