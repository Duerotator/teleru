+DockedTray::DockedTray(QWidget *parent, DockedCallbacks callbacks)
+: RpWidget(parent)
+, _callbacks(std::move(callbacks)) {
+	setMouseTracking(true);
+	layoutRow();
+	resize(width(), desiredHeight());
+}
+
+bool DockedTray::grid() const {
+	return _content.grid && _content.gridAvailable;
+}
+
+int DockedTray::gridCap() const {
+	const auto limit = std::min(
+		st::sendMediaPreviewSize * 2 / 3,
+		window()->height() / 3);
+	return std::max(limit, 2 * ThumbSide());
+}
+
+int DockedTray::desiredHeight() {
+	if (grid() && _cap != gridCap()) {
+		layoutRow();
+		setScroll(_scroll);
+		update();
+	}
+	return HandleHeight()
+		+ HeaderHeight()
+		+ (_content.collapsed ? 0 : (RowSkip() + _rowHeight))
+		+ RowSkip();
+}
+
+QString DockedTray::tooltipText() const {
+	return (_over.part != Part::Grid)
+		? QString()
+		: grid()
+		? Lower(u"Show as a strip"_q)
+		: Lower(u"Show as the album will look"_q);
+}
