+[[nodiscard]] QSize TileDimensions(const DockedTile &tile) {
+	const auto size = !tile.dimensions.isEmpty()
+		? tile.dimensions
+		: !tile.image.isNull()
+		? tile.image.size()
+		: QSize(ThumbSide(), ThumbSide());
+	return QSize(std::max(size.width(), 1), std::max(size.height(), 1));
+}
+
+[[nodiscard]] QPainterPath TilePath(QRect rect, RectParts corners) {
+	const auto radius = st::roundRadiusLarge;
+	auto result = QPainterPath();
+	result.addRoundedRect(rect, radius, radius);
+	const auto square = [&](RectPart corner, QPoint origin) {
+		if (!(corners & corner)) {
+			auto patch = QPainterPath();
+			patch.addRect(QRect(origin, QSize(radius, radius)));
+			result = result.united(patch);
+		}
+	};
+	const auto right = rect.x() + rect.width() - radius;
+	const auto bottom = rect.y() + rect.height() - radius;
+	square(RectPart::TopLeft, rect.topLeft());
+	square(RectPart::TopRight, QPoint(right, rect.y()));
+	square(RectPart::BottomLeft, QPoint(rect.x(), bottom));
+	square(RectPart::BottomRight, QPoint(right, bottom));
+	return result;
+}
