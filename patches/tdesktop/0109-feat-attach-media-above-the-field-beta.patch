+
+DockedStore::DockedStore(not_null<Main::Session*> session)
+: _session(session) {
+	for (const auto &[key, docked] : Drafts(session).docked()) {
+		auto &tray = _trays[key];
+		tray.way = Ui::SendFilesWay::FromSerialized(
+			docked.way
+		).value_or(DefaultSendFilesWay());
+		tray.collapsed = docked.collapsed;
+		for (const auto &entry : docked.files) {
+			tray.list.files.push_back(Placeholder(entry));
+			tray.items.push_back({
+				.id = ++_autoId,
+				.stage = Stage::Restored,
+				.saved = entry,
+			});
+		}
+		refreshListDraft(key);
+	}
+	DockedAttachmentsChanges(
+	) | rpl::on_next([=] {
+		for (const auto &[key, draft] : _listDrafts) {
+			repaintListRow(key);
+		}
+	}, _lifetime);
+	Drafts(session).editingChanges(
+	) | rpl::on_next([=] {
+		reconcileDrafting();
+	}, _lifetime);
+	crl::on_main(this, [=] {
+		reconcileDrafting();
+	});
+}
+
+std::pair<DockedKey, Tray*> DockedStore::locate(
+		uint64 id,
+		DockedKey fallback) {
+	for (auto &[key, tray] : _trays) {
+		if (IndexOf(tray, id) >= 0) {
+			return { key, &tray };
+		}
+	}
+	return { fallback, lookup(fallback) };
+}
+
+void DockedStore::moveTray(DockedKey from, DockedKey to) {
+	_trays.erase(to);
+	const auto i = _trays.find(from);
+	if (i != end(_trays)) {
+		auto tray = std::move(i->second);
+		_trays.erase(i);
+		_trays.emplace(to, std::move(tray));
+	}
+	persist(from);
+	persist(to);
+}
+
+void DockedStore::dropTray(DockedKey key) {
+	_afterSend.remove(key);
+	if (_trays.erase(key)) {
+		persist(key);
+		notify(key);
+	}
+}
+
+void DockedStore::beginDraft(DraftsThread thread, uint64 id) {
+	const auto key = DockedKey{ .thread = thread };
+	const auto stash = DockedKey{ .thread = thread, .stashed = true };
+	_drafting[thread] = id;
+	if (_trays.contains(key) && !_trays.contains(stash)) {
+		moveTray(key, stash);
+	}
+	notify(key);
+	notify(stash);
+}
+
+void DockedStore::endDraft(DraftsThread thread) {
+	const auto key = DockedKey{ .thread = thread };
+	const auto stash = DockedKey{ .thread = thread, .stashed = true };
+	_drafting.remove(thread);
+	_afterSend.remove(key);
+	moveTray(stash, key);
+	notify(key);
+	notify(stash);
+}
+
+void DockedStore::reconcileDrafting() {
+	const auto now = Drafts(_session).editingList();
+	const auto editingId = [&](DraftsThread thread) {
+		for (const auto &[editing, id] : now) {
+			if (editing == thread) {
+				return id;
+			}
+		}
+		return uint64();
+	};
+	const auto was = _drafting;
+	for (const auto &[thread, id] : was) {
+		const auto current = editingId(thread);
+		if (!current) {
+			endDraft(thread);
+		} else if (current != id) {
+			_drafting[thread] = current;
+			dropTray({ .thread = thread });
+		}
+	}
+	auto stale = std::vector<DraftsThread>();
+	for (const auto &[key, tray] : _trays) {
+		if (key.stashed && !_drafting.contains(key.thread)) {
+			stale.push_back(key.thread);
+		}
+	}
+	for (const auto thread : stale) {
+		endDraft(thread);
+	}
+	for (const auto &[thread, id] : now) {
+		if (!_drafting.contains(thread)) {
+			beginDraft(thread, id);
+		}
+	}
+}
+
+void DockedStore::appendSaved(
+		Tray &tray,
+		const std::vector<SavedDraftFile> &files) {
+	auto &store = Drafts(_session);
+	for (const auto &file : files) {
+		if (store.fileMissing(file)) {
+			continue;
+		}
+		const auto saved = SavedDockedFile{
+			.file = file,
+			.type = int32(file.thumbnail.isEmpty()
+				? FileType::File
+				: FileType::Photo),
+		};
+		tray.list.files.push_back(Placeholder(saved));
+		tray.items.push_back({
+			.id = ++_autoId,
+			.stage = Stage::Restored,
+			.saved = saved,
+		});
+	}
+}
+
+bool DockedStore::restoreDraft(const SavedDraft &draft) {
+	if (!ResolveDraftsThread(_session, draft.thread)) {
+		return false;
+	}
+	const auto key = DockedKey{ .thread = draft.thread };
+	auto &tray = _trays[key];
+	if (tray.items.empty()) {
+		tray.way = Ui::SendFilesWay::FromSerialized(
+			draft.filesWay
+		).value_or(DefaultSendFilesWay());
+	}
+	tray.collapsed = false;
+	appendSaved(tray, draft.files);
+	if (tray.items.empty()) {
+		_trays.erase(key);
+		return false;
+	}
+	persist(key);
+	notify(key);
+	return true;
+}
+
+void DockedStore::discard(DockedKey key) {
+	const auto tray = find(key);
+	if (!tray) {
+		return;
+	}
+	const auto editor = !key.scheduled && _drafting.contains(key.thread);
+	const auto show = tray->show;
+	auto media = (editor || key.stashed || !show)
+		? std::optional<DockedDraftMedia>()
+		: draftMedia(key);
+	if (media && !media->sources.empty()) {
+		ImportMediaDraft(show, std::move(media->sources), {
+			.thread = key.thread,
+			.reply = NormalizeDraftReply(FullReplyTo(), key.thread),
+			.way = media->way,
+			.toast = false,
+			.discarded = true,
+		});
+		show->showToast(
+			Lower(u"Files moved to recently discarded drafts."_q));
+	}
+	clear(key);
+}
+
+bool DockedStore::loadDraft(const SavedDraft &draft) {
+	reconcileDrafting();
+	const auto i = _drafting.find(draft.thread);
+	if (i == end(_drafting) || i->second != draft.id) {
+		return false;
+	}
+	const auto key = DockedKey{ .thread = draft.thread };
+	auto tray = Tray();
+	tray.way = Ui::SendFilesWay::FromSerialized(
+		draft.filesWay
+	).value_or(DefaultSendFilesWay());
+	appendSaved(tray, draft.files);
+	_afterSend.remove(key);
+	_trays.erase(key);
+	if (!tray.items.empty()) {
+		_trays.emplace(key, std::move(tray));
+	}
+	persist(key);
+	notify(key);
+	return true;
+}
+
+void DockedStore::setAfterSend(DockedKey key, Fn<void()> callback) {
+	_afterSend[key] = std::move(callback);
+}
+
+Fn<void()> DockedStore::takeAfterSend(DockedKey key) {
+	const auto i = _afterSend.find(key);
+	if (i == end(_afterSend)) {
+		return nullptr;
+	}
+	auto result = std::move(i->second);
+	_afterSend.erase(i);
+	return result;
+}
+
+std::optional<DockedDraftMedia> DockedStore::draftMedia(
+		DockedKey key) const {
+	const auto tray = find(key);
+	if (!tray || tray->items.empty()) {
+		return std::nullopt;
+	}
+	auto &store = Drafts(_session);
+	const auto compress = tray->way.sendImagesAsPhotos();
+	auto result = DockedDraftMedia{ .way = tray->way.serialize() };
+	for (auto i = 0; i != int(tray->items.size()); ++i) {
+		const auto &item = tray->items[i];
+		const auto &file = tray->list.files[i];
+		auto thumbnail = PreviewImage(file);
+		if (thumbnail.isNull() && !item.saved.file.thumbnail.isEmpty()) {
+			thumbnail = QImage::fromData(item.saved.file.thumbnail);
+		}
+		auto source = std::optional<DraftFileSource>();
+		if (!item.stale && !item.saved.file.stored.isEmpty()) {
+			source = DraftFileSource{
+				.path = item.saved.path,
+				.name = item.saved.file.name,
+				.reuse = item.saved.file.stored,
+				.size = item.saved.file.size,
+				.thumbnail = thumbnail,
+			};
+		} else if (item.baked && LookupImage(file)) {
+			source = BakedSource(file, BakedName(file));
+		} else if (!item.saved.path.isEmpty()) {
+			source = DraftFileSource{
+				.path = item.saved.path,
+				.name = item.saved.file.name,
+				.size = item.saved.file.size,
+				.thumbnail = thumbnail,
+			};
+		} else {
+			source = DraftSourceFromFile(file, store);
+		}
+		if (!source) {
+			result.failed = true;
+			continue;
+		}
+		source->spoiler = file.spoiler && CanSpoiler(file, compress);
+		result.ids.push_back(item.id);
+		result.sources.push_back(std::move(*source));
+	}
+	return result;
+}
