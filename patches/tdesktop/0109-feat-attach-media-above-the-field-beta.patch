+void DockedStore::startPending(Tray &tray, int index, const QString &path) {
+	auto &placeholder = tray.list.files[index];
+	auto file = Ui::PreparedFile(path);
+	file.size = QFileInfo(path).size();
+	if (!placeholder.displayName.isEmpty()) {
+		file.displayName = placeholder.displayName;
+	}
+	file.type = placeholder.type;
+	file.spoiler = placeholder.spoiler;
+	file.preview = placeholder.preview;
+	placeholder = std::move(file);
+	tray.items[index].stage = Stage::Pending;
+}
+
+void DockedStore::materialize(DockedKey key) {
+	const auto tray = lookup(key);
+	if (!tray || tray->exporting) {
+		return;
+	}
+	auto &store = Drafts(_session);
+	auto entries = std::vector<TransferEntry>();
+	auto files = std::vector<SavedDraftFile>();
+	auto removed = false;
+	for (auto i = 0; i < int(tray->items.size());) {
+		const auto &item = tray->items[i];
+		if (item.stage != Stage::Restored) {
+			++i;
+			continue;
+		}
+		const auto stored = !item.saved.file.stored.isEmpty()
+			&& !store.fileMissing(item.saved.file);
+		const auto referenced = !stored
+			&& !item.saved.path.isEmpty()
+			&& QFileInfo(item.saved.path).isFile();
+		if (!stored && !referenced) {
+			RemoveIndex(*tray, i);
+			removed = true;
+			continue;
+		}
+		const auto cover = !item.saved.cover.stored.isEmpty()
+			&& !store.fileMissing(item.saved.cover);
+		if (stored) {
+			entries.push_back({ .id = item.id });
+			files.push_back(item.saved.file);
+		}
+		if (cover) {
+			entries.push_back({ .id = item.id, .cover = true });
+			files.push_back(item.saved.cover);
+		}
+		if (!stored && !cover) {
+			startPending(*tray, i, item.saved.path);
+		}
+		++i;
+	}
+	if (tray->items.empty()) {
+		_trays.erase(key);
+		persist(key);
+		notify(key);
+		return;
+	}
+	if (!files.empty()) {
+		tray->exporting = true;
+		const auto weak = base::make_weak(this);
+		store.exportFiles(std::move(files), [=](QStringList paths) {
+			if (const auto strong = weak.get()) {
+				strong->exported(key, entries, paths);
+			}
+		});
+	}
+	if (removed) {
+		persist(key);
+	}
+	processNext(key);
+	notify(key);
+}
+
+void DockedStore::exported(
+		DockedKey fallback,
+		std::vector<TransferEntry> entries,
+		QStringList paths) {
+	const auto located = entries.empty()
+		? std::make_pair(fallback, lookup(fallback))
+		: locate(entries.front().id, fallback);
+	const auto key = located.first;
+	const auto tray = located.second;
+	if (!tray) {
+		return;
+	}
+	tray->exporting = false;
+	const auto failed = (paths.size() != int(entries.size()));
+	auto mains = base::flat_map<uint64, QString>();
+	for (auto i = 0; i != int(entries.size()); ++i) {
+		const auto &entry = entries[i];
+		const auto index = IndexOf(*tray, entry.id);
+		if (index < 0
+			|| tray->items[index].stage != Stage::Restored
+			|| failed) {
+			continue;
+		} else if (entry.cover) {
+			tray->items[index].coverPath = paths[i];
+		} else {
+			mains[entry.id] = paths[i];
+		}
+	}
+	for (const auto &entry : entries) {
+		const auto index = IndexOf(*tray, entry.id);
+		if (index < 0 || tray->items[index].stage != Stage::Restored) {
+			continue;
+		} else if (failed) {
+			RemoveIndex(*tray, index);
+			continue;
+		}
+		const auto i = mains.find(entry.id);
+		startPending(
+			*tray,
+			index,
+			(i != end(mains)) ? i->second : tray->items[index].saved.path);
+	}
+	if (failed && tray->show) {
+		tray->show->showToast(
+			Lower(u"Couldn't restore the attached files."_q));
+	}
+	if (tray->items.empty()) {
+		_trays.erase(key);
+	} else {
+		processNext(key);
+	}
+	persist(key);
+	notify(key);
+}
+
+void DockedStore::processNext(DockedKey key) {
+	const auto tray = lookup(key);
+	if (!tray || tray->processing) {
+		return;
+	}
+	const auto i = ranges::find(tray->items, Stage::Pending, &Item::stage);
+	if (i == end(tray->items)) {
+		finish(key);
+		return;
+	}
+	const auto index = int(i - begin(tray->items));
+	auto file = std::move(tray->list.files[index]);
+	tray->list.files[index] = PendingPlaceholder(file);
+	i->stage = Stage::Processing;
+	tray->processing = true;
+	const auto id = i->id;
+	const auto modifications = i->saved.modifications;
+	const auto coverPath = i->coverPath;
+	const auto sideLimit = PhotoSideLimit(tray->way.sendLargePhotos());
+	const auto weak = base::make_weak(this);
+	crl::async([=, file = std::move(file)]() mutable {
+		Storage::PrepareDetails(file, st::sendMediaPreviewSize, sideLimit);
+		ApplySavedVideo(file, modifications, sideLimit);
+		AttachSavedCover(file, coverPath, sideLimit);
+		crl::on_main([=, file = std::move(file)]() mutable {
+			if (const auto strong = weak.get()) {
+				strong->processed(key, id, std::move(file));
+			}
+		});
+	});
+}
+
+void DockedStore::processed(
+		DockedKey fallback,
+		uint64 id,
+		Ui::PreparedFile &&file) {
+	const auto located = locate(id, fallback);
+	const auto key = located.first;
+	const auto tray = located.second;
+	if (!tray) {
+		return;
+	}
+	tray->processing = false;
+	const auto index = IndexOf(*tray, id);
+	if (index >= 0) {
+		const auto &saved = tray->items[index].saved;
+		if (TypeFromInt(saved.type) == FileType::Video
+			&& file.type != FileType::Video
+			&& LookupImage(file)
+			&& tray->show) {
+			ToggleSendAsGif(file, tray->show);
+		}
+		file.spoiler = tray->list.files[index].spoiler;
+		tray->list.files[index] = std::move(file);
+		tray->items[index].stage = Stage::Ready;
+		if (!validate(key, *tray, index, false)) {
+			RemoveIndex(*tray, index);
+		}
+		refreshPrepared(key, *tray);
+	}
+	if (tray->items.empty()) {
+		_trays.erase(key);
+		persist(key);
+		notify(key);
+		return;
+	}
+	importItems(key);
+	persist(key);
+	notify(key);
+	processNext(key);
+}
+
+void DockedStore::importItems(DockedKey key) {
+	const auto tray = lookup(key);
+	if (!tray) {
+		return;
+	}
+	auto &store = Drafts(_session);
+	auto entries = std::vector<TransferEntry>();
+	auto sources = std::vector<DraftFileSource>();
+	for (auto i = 0; i != int(tray->items.size()); ++i) {
+		auto &item = tray->items[i];
+		if (item.stage != Stage::Ready
+			|| item.importing
+			|| item.importFailed) {
+			continue;
+		}
+		const auto &file = tray->list.files[i];
+		const auto main = item.stale
+			|| (item.saved.file.stored.isEmpty()
+				&& item.saved.path.isEmpty());
+		const auto cover = item.coverDirty
+			&& item.saved.cover.stored.isEmpty()
+			&& file.videoCover;
+		if (main
+			&& !item.baked
+			&& !file.path.isEmpty()
+			&& file.size > kCopyLimit) {
+			item.saved.path = file.path;
+			item.saved.file.name = file.displayName;
+			item.saved.file.size = file.size;
+		} else if (main) {
+			auto source = item.baked
+				? BakedSource(file, BakedName(file))
+				: DraftSourceFromFile(file, store);
+			if (!source) {
+				item.importFailed = true;
+				continue;
+			}
+			item.importing = true;
+			entries.push_back({ .id = item.id, .revision = item.revision });
+			sources.push_back(std::move(*source));
+		}
+		if (cover) {
+			if (auto source = BakedSource(*file.videoCover, u"cover.png"_q)) {
+				item.importing = true;
+				entries.push_back({
+					.id = item.id,
+					.revision = item.coverRevision,
+					.cover = true,
+				});
+				sources.push_back(std::move(*source));
+			} else {
+				item.coverDirty = false;
+			}
+		}
+	}
+	if (sources.empty()) {
+		return;
+	}
+	const auto weak = base::make_weak(this);
+	store.importFiles(std::move(sources), [=](
+			std::optional<std::vector<SavedDraftFile>> files) {
+		if (const auto strong = weak.get()) {
+			strong->imported(key, entries, std::move(files));
+		}
+	});
+}
+
+void DockedStore::imported(
+		DockedKey fallback,
+		std::vector<TransferEntry> entries,
+		std::optional<std::vector<SavedDraftFile>> files) {
+	const auto located = entries.empty()
+		? std::make_pair(fallback, lookup(fallback))
+		: locate(entries.front().id, fallback);
+	const auto key = located.first;
+	if (const auto tray = located.second) {
+		for (auto i = 0; i != int(entries.size()); ++i) {
+			const auto &entry = entries[i];
+			const auto index = IndexOf(*tray, entry.id);
+			if (index < 0) {
+				continue;
+			}
+			auto &item = tray->items[index];
+			item.importing = false;
+			const auto current = entry.cover
+				? (entry.revision == item.coverRevision)
+				: (entry.revision == item.revision);
+			if (!current) {
+				continue;
+			} else if (!files || i >= int(files->size())) {
+				item.importFailed = true;
+			} else if (entry.cover) {
+				item.saved.cover = (*files)[i];
+				item.coverDirty = false;
+			} else {
+				item.saved.file = (*files)[i];
+				item.saved.path = QString();
+				item.stale = false;
+			}
+		}
+	}
+	persist(key);
+	importItems(key);
+}
+
+void DockedStore::finish(DockedKey key) {
+	if (!ready(key)) {
+		return;
+	}
+	const auto tray = lookup(key);
+	for (const auto &callback : base::take(tray->whenReady)) {
+		callback();
+	}
+}
+
+void DockedStore::whenReady(DockedKey key, Fn<void()> callback) {
+	const auto tray = lookup(key);
+	if (!tray) {
+		return;
+	} else if (ready(key)) {
+		callback();
+		return;
+	}
+	tray->whenReady.clear();
+	tray->whenReady.push_back(std::move(callback));
+	materialize(key);
+	processNext(key);
+}
+
+void DockedStore::persist(DockedKey key) {
+	auto docked = SavedDocked();
+	if (const auto tray = lookup(key)) {
+		docked.way = tray->way.serialize();
+		docked.collapsed = tray->collapsed;
+		for (auto i = 0; i != int(tray->items.size()); ++i) {
+			const auto &item = tray->items[i];
+			if (item.saved.file.stored.isEmpty() && item.saved.path.isEmpty()) {
+				continue;
+			}
+			const auto &file = tray->list.files[i];
+			auto entry = item.saved;
+			entry.file.spoiler = file.spoiler;
+			entry.type = int32(file.type);
+			if (item.stage == Stage::Ready) {
+				entry.modifications = SerializeVideoModifications(file);
+			}
+			docked.files.push_back(std::move(entry));
+		}
+	}
+	Drafts(_session).setDocked(key, std::move(docked));
+}
+
+void DockedStore::notify(DockedKey key) {
+	if (const auto tray = lookup(key)) {
+		refreshPrepared(key, *tray);
+	}
+	if (refreshListDraft(key)) {
+		repaintListRow(key);
+	}
+	_changes.fire_copy(key);
+}
+
+std::shared_ptr<Ui::PreparedBundle> DockedStore::prepareBundle(
+		DockedKey key,
+		std::shared_ptr<ChatHelpers::Show> show,
+		TextWithTags caption) const {
+	const auto tray = find(key);
+	const auto to = peer(key);
+	if (!tray || !to || tray->items.empty() || !Prepared(tray->list)) {
+		return nullptr;
+	}
+	auto way = tray->way;
+	const auto limits = DefaultLimitsForPeer(to);
+	const auto onlyOne = bool(limits & SendFilesAllow::OnlyOne);
+	auto list = Ui::PreparedList();
+	for (const auto &file : tray->list.files) {
+		list.files.push_back(Clone(file));
+	}
+	if (onlyOne && list.files.size() > 1) {
+		way.setGroupFiles(true);
+		if (!list.canBeSentInSlowmode()) {
+			Data::ShowSendErrorToast(
+				show,
+				to,
+				tr::lng_slowmode_no_many(tr::now));
+			return nullptr;
+		}
+	}
+	const auto compress = way.sendImagesAsPhotos();
+	for (auto &file : list.files) {
+		file.sendLargePhotos = way.sendLargePhotos();
+		if (!CanSpoiler(file, compress)) {
+			file.spoiler = false;
+		}
+		file.caption = TextWithTags();
+		if (!compress) {
+			file.ttlSeconds = 0;
+		}
+	}
+	const auto animated = bool(limits & SendFilesAllow::Gifs)
+		|| bool(limits & SendFilesAllow::Videos);
+	Storage::ApplyModifications(list, animated);
+	auto groups = Ui::DivideByGroups(std::move(list), way, onlyOne);
+	auto bundle = Ui::PrepareFilesBundle(std::move(groups), way, false);
+	if (!bundle->groups.empty()) {
+		auto &group = bundle->groups.back();
+		auto &files = group.list.files;
+		if (!files.empty()) {
+			auto &captioned = (group.type == Ui::AlbumType::PhotoVideo)
+				? files.front()
+				: files.back();
+			if (!captioned.isSticker() || compress) {
+				captioned.caption = std::move(caption);
+			}
+		}
+	}
+	return bundle;
+}
+
+[[nodiscard]] DockedStore &Docked(not_null<Main::Session*> session) {
+	static auto stores = std::map<
+		not_null<Main::Session*>,
+		std::unique_ptr<DockedStore>>();
+	const auto i = stores.find(session);
+	if (i != end(stores)) {
+		return *i->second;
+	}
+	session->lifetime().add([=] {
+		stores.erase(session);
+	});
+	return *stores.emplace(
+		session,
+		std::make_unique<DockedStore>(session)).first->second;
+}
+
+struct DockedTile {
+	uint64 id = 0;
+	FileType type = FileType::File;
+	QString name;
+	QImage image;
+	QSize dimensions;
+	bool spoiler = false;
+	bool spoilerAllowed = false;
+	bool loading = false;
+	bool editable = false;
+};
+
+struct DockedSegment {
+	int from = 0;
+	int till = 0;
+	bool album = false;
+};
+
+struct DockedContent {
+	std::vector<DockedTile> tiles;
+	std::vector<DockedSegment> segments;
+	bool grid = false;
+	bool gridAvailable = false;
+	QString title;
+	QString size;
+	bool group = false;
+	bool groupShown = false;
+	bool asFile = false;
+	bool asFileShown = false;
+	bool collapsed = false;
+};
+
+struct DockedCallbacks {
+	Fn<void(uint64)> remove;
+	Fn<void(uint64)> spoiler;
+	Fn<void(int, int)> move;
+	Fn<void()> add;
+	Fn<void()> clear;
+	Fn<void()> collapse;
+	Fn<void()> group;
+	Fn<void()> asFile;
+	Fn<void()> grid;
+	Fn<void(uint64)> edit;
+	Fn<void(uint64, QPoint)> menu;
+};
+
+[[nodiscard]] std::vector<DockedSegment> Segments(
+		const Tray &tray,
+		bool slowmode) {
+	auto probes = Ui::PreparedList();
+	for (auto i = 0; i != int(tray.list.files.size()); ++i) {
+		const auto &file = tray.list.files[i];
+		auto probe = Ui::PreparedFile(QString());
+		probe.id = i;
+		probe.type = file.type;
+		probe.animationJob = file.animationJob;
+		if (const auto video = LookupVideo(file)) {
+			auto info = VideoInfo();
+			info.hasAudio = video->hasAudio;
+			info.modifications.gif = video->modifications.gif;
+			probe.information = std::make_unique<Ui::PreparedFileInformation>();
+			probe.information->media = std::move(info);
+		}
+		probes.files.push_back(std::move(probe));
+	}
+	auto result = std::vector<DockedSegment>();
+	auto groups = Ui::DivideByGroups(std::move(probes), tray.way, slowmode);
+	for (const auto &group : groups) {
+		const auto &files = group.list.files;
+		if (files.empty()) {
+			continue;
+		}
+		result.push_back({
+			.from = int(files.front().id),
+			.till = int(files.back().id) + 1,
+			.album = (group.type == Ui::AlbumType::PhotoVideo)
+				&& (files.size() > 1),
+		});
+	}
+	return result;
+}
+
+[[nodiscard]] DockedContent BuildContent(
+		const Tray &tray,
+		bool slowmode) {
+	auto result = DockedContent();
+	const auto compress = tray.way.sendImagesAsPhotos();
+	auto size = int64();
+	for (auto i = 0; i != int(tray.items.size()); ++i) {
+		const auto &file = tray.list.files[i];
+		const auto &item = tray.items[i];
+		size += file.size ? file.size : int64(file.content.size());
+		result.tiles.push_back({
+			.id = item.id,
+			.type = file.type,
+			.name = (!file.displayName.isEmpty()
+				? file.displayName
+				: QFileInfo(file.path).fileName()),
+			.image = PreviewImage(file),
+			.dimensions = file.shownDimensions,
+			.spoiler = file.spoiler && CanSpoiler(file, compress),
+			.spoilerAllowed = CanSpoiler(file, compress),
+			.loading = (item.stage == Stage::Pending
+				|| item.stage == Stage::Processing),
+			.editable = (item.stage == Stage::Ready
+				&& KindOf(file, compress) != EditKind::None),
+		});
+	}
+	result.title = TitleText(tray.list);
+	result.size = (size > 0) ? Ui::FormatSizeText(size) : QString();
+	result.group = tray.way.groupFiles();
+	if (Prepared(tray.list)) {
+		result.groupShown = tray.list.hasGroupOption(slowmode);
+		result.asFileShown = tray.list.hasSendImagesAsPhotosOption(slowmode);
+	} else if (tray.optionsKnown) {
+		result.groupShown = tray.groupShown;
+		result.asFileShown = tray.asFileShown;
+	} else {
+		const auto media = int(ranges::count_if(
+			tray.list.files,
+			[](const Ui::PreparedFile &file) {
+				return (file.type == FileType::Photo)
+					|| (file.type == FileType::Video);
+			}));
+		result.groupShown = !slowmode && (tray.items.size() > 1);
+		result.asFileShown = (media > 0);
+	}
+	result.asFile = !compress;
+	result.collapsed = tray.collapsed;
+	result.segments = Segments(tray, slowmode);
+	result.grid = DockedGrid();
+	result.gridAvailable = ranges::any_of(
+		result.segments,
+		&DockedSegment::album);
+	return result;
+}
