+
+DockedVideoPreview DockedVideoView(
+		const QString &path,
+		const QString &coverPath,
+		const QByteArray &state,
+		int sideLimit) {
+	auto file = Ui::PreparedFile(path);
+	file.size = QFileInfo(path).size();
+	Storage::PrepareDetails(file, st::sendMediaPreviewSize, sideLimit);
+	const auto video = LookupVideo(file);
+	if (!video) {
+		return {};
+	}
+	ApplySavedVideo(file, state, sideLimit);
+	if (video->thumbnail.isNull()) {
+		return {};
+	}
+	const auto &mods = video->modifications;
+	const auto source = Editor::ComposeVideoSource(path, mods, {}, false);
+	const auto full = std::max(video->duration, crl::time());
+	auto frame = Editor::ImageModified(
+		base::duplicate(video->thumbnail),
+		mods.geometry);
+	auto size = Media::Encode::TranscodedSize(
+		source,
+		video->thumbnail.size());
+	if (size.isEmpty()) {
+		size = frame.size();
+	}
+	auto result = DockedVideoPreview{
+		.dimensions = size,
+		.duration = std::max(
+			Media::Encode::TranscodedDuration(source, full),
+			crl::time()),
+	};
+	if (!coverPath.isEmpty()) {
+		if (auto cover = QImage(coverPath); !cover.isNull()) {
+			frame = std::move(cover);
+		}
+	}
+	const auto side = st::maxMediaSize * style::DevicePixelRatio();
+	auto target = size;
+	if (target.width() > side || target.height() > side) {
+		target = target.scaled(side, side, Qt::KeepAspectRatio);
+	}
+	target = QSize(std::max(target.width(), 1), std::max(target.height(), 1));
+	frame = frame.scaled(
+		target,
+		Qt::KeepAspectRatioByExpanding,
+		Qt::SmoothTransformation);
+	frame = frame.copy(
+		(frame.width() - target.width()) / 2,
+		(frame.height() - target.height()) / 2,
+		target.width(),
+		target.height()
+	).convertToFormat(QImage::Format_RGB32);
+	frame.setDevicePixelRatio(1.);
+	result.preview = std::move(frame);
+	return result;
+}
