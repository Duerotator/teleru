+void ComposeDocked::changePrice() {
+	const auto key = currentKey();
+	const auto session = _session;
+	const auto now = Docked(session).price(key);
+	const auto limit = session->appConfig().get<int>(
+		u"stars_paid_post_amount_max"_q,
+		10'000);
+	_show->showBox(Box([=](not_null<Ui::GenericBox*> box) {
+		box->setTitle(tr::lng_paid_title());
+		const auto wrap = box->addRow(object_ptr<Ui::FixedHeightWidget>(
+			box,
+			st::editTagField.heightMin));
+		const auto field = Ui::CreateChild<Ui::NumberInput>(
+			wrap,
+			st::editTagField,
+			tr::lng_paid_cost_placeholder(),
+			now ? QString::number(now) : QString(),
+			limit);
+		wrap->widthValue() | rpl::on_next([=](int width) {
+			field->move(0, 0);
+			field->resize(width, field->height());
+			wrap->resize(width, field->height());
+		}, wrap->lifetime());
+		field->paintRequest() | rpl::on_next([=] {
+			auto p = QPainter(field);
+			st::paidStarIcon.paint(p, 0, st::paidStarIconTop, field->width());
+		}, field->lifetime());
+		field->selectAll();
+		box->setFocusCallback([=] {
