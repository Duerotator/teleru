+std::optional<TextWithTags> DockedStore::caption(
+		DockedKey key,
+		uint64 id) const {
+	const auto tray = find(key);
+	const auto index = tray ? IndexOf(*tray, id) : -1;
+	return (index >= 0)
+		? std::make_optional(tray->list.files[index].caption)
+		: std::nullopt;
+}
+
+void DockedStore::setCaption(
+		DockedKey key,
+		uint64 id,
+		TextWithTags caption) {
+	const auto tray = lookup(key);
+	const auto index = tray ? IndexOf(*tray, id) : -1;
+	if (index < 0) {
+		return;
+	}
+	tray->list.files[index].caption = std::move(caption);
+	persist(key);
+	notify(key);
+}
+
+uint64 DockedStore::firstId(DockedKey key) const {
+	const auto tray = find(key);
+	return (tray && !tray->items.empty()) ? tray->items.front().id : 0;
+}
+
+bool DockedStore::hasSpoilerMenu(DockedKey key) const {
+	const auto tray = find(key);
+	return tray
+		&& Prepared(tray->list)
+		&& !(canChangePrice(key) && tray->price > 0)
+		&& tray->list.hasSpoilerMenu(tray->way.sendImagesAsPhotos());
+}
+
+bool DockedStore::allSpoilers(DockedKey key) const {
+	const auto tray = find(key);
+	return tray && ranges::all_of(tray->list.files, &Ui::PreparedFile::spoiler);
+}
+
+void DockedStore::setAllSpoilers(DockedKey key, bool enabled) {
+	const auto tray = lookup(key);
+	if (!tray) {
+		return;
+	}
+	for (auto &file : tray->list.files) {
+		file.spoiler = enabled;
+	}
+	persist(key);
+	notify(key);
+}
+
+bool DockedStore::canMoveCaption(DockedKey key) const {
+	const auto tray = find(key);
+	if (!tray || !Prepared(tray->list)) {
+		return false;
+	}
+	const auto &way = tray->way;
+	if (!way.sendImagesAsPhotos() || !tray->list.canAddCaption(true)) {
+		return false;
+	}
+	const auto count = int(tray->list.files.size());
+	if (count < 1 || count > Ui::MaxAlbumItems()) {
+		return false;
+	}
+	return (count == 1 || way.groupFiles())
+		&& ranges::all_of(tray->list.files, [](const Ui::PreparedFile &f) {
+			return (f.type == FileType::Photo)
+				|| (f.type == FileType::Video);
+		});
+}
+
+bool DockedStore::invert(DockedKey key) const {
+	const auto tray = find(key);
+	return tray && tray->invert;
+}
+
+void DockedStore::setInvert(DockedKey key, bool invert) {
+	if (const auto tray = lookup(key); tray && tray->invert != invert) {
+		tray->invert = invert;
+		persist(key);
+		notify(key);
+	}
+}
+
+bool DockedStore::hasLargePhotosOption(DockedKey key) const {
+	const auto tray = find(key);
+	return tray
+		&& Prepared(tray->list)
+		&& tray->list.hasSendLargePhotosOption(
+			tray->way.sendImagesAsPhotos());
+}
+
+bool DockedStore::largePhotos(DockedKey key) const {
+	const auto tray = find(key);
+	return tray && tray->way.sendLargePhotos();
+}
+
+void DockedStore::setLargePhotos(DockedKey key, bool enabled) {
+	const auto tray = lookup(key);
+	if (!tray || tray->way.sendLargePhotos() == enabled) {
+		return;
+	}
+	tray->way.setSendLargePhotos(enabled);
+	persist(key);
+	notify(key);
+}
+
+bool DockedStore::canChangePrice(DockedKey key) const {
+	const auto tray = find(key);
+	const auto to = peer(key);
+	const auto broadcast = to ? to->asBroadcast() : nullptr;
+	if (!tray || !broadcast || !Prepared(tray->list)) {
+		return false;
+	}
+	const auto &way = tray->way;
+	return broadcast->canPostPaidMedia()
+		&& tray->list.canChangePrice(
+			way.groupFiles() && way.sendImagesAsPhotos(),
+			way.sendImagesAsPhotos());
+}
+
+uint64 DockedStore::price(DockedKey key) const {
+	const auto tray = find(key);
+	return (tray && canChangePrice(key)) ? tray->price : 0;
+}
+
+void DockedStore::setPrice(DockedKey key, uint64 price) {
+	const auto tray = lookup(key);
+	if (!tray || tray->price == price) {
+		return;
+	}
+	tray->price = price;
+	if (price > 0) {
+		for (auto &file : tray->list.files) {
+			file.spoiler = false;
+		}
+	}
+	persist(key);
+	notify(key);
+}
+
+bool DockedStore::hasTtl(DockedKey key) const {
+	const auto tray = find(key);
+	return tray
+		&& tray->way.sendImagesAsPhotos()
+		&& ranges::any_of(tray->list.files, &Ui::PreparedFile::ttlSeconds);
+}
+
+bool DockedStore::canSetTtl(DockedKey key, uint64 id) const {
+	const auto tray = find(key);
+	const auto index = tray ? IndexOf(*tray, id) : -1;
+	const auto to = peer(key);
+	const auto user = to ? to->asUser() : nullptr;
+	if (index < 0 || key.scheduled || !user || user->isSelf() || user->isBot()) {
+		return false;
+	}
+	const auto &file = tray->list.files[index];
+	return (price(key) == 0)
+		&& tray->way.sendImagesAsPhotos()
+		&& (file.type == FileType::Photo || file.type == FileType::Video);
+}
+
+void DockedStore::setTtl(DockedKey key, uint64 id, crl::time ttl) {
+	const auto tray = lookup(key);
+	const auto index = tray ? IndexOf(*tray, id) : -1;
+	if (index < 0) {
+		return;
+	}
+	tray->list.files[index].ttlSeconds = ttl;
+	persist(key);
+	notify(key);
+}
+
+bool DockedStore::canRename(DockedKey key, uint64 id) const {
+	const auto tray = find(key);
+	const auto index = tray ? IndexOf(*tray, id) : -1;
+	if (index < 0 || tray->items[index].stage != Stage::Ready) {
+		return false;
+	}
+	const auto &file = tray->list.files[index];
+	return tray->way.sendImagesAsPhotos()
+		? !(file.type == FileType::Photo || file.type == FileType::Video)
+		: !file.isSticker();
+}
+
+void DockedStore::rename(DockedKey key, uint64 id, QString name) {
+	const auto tray = lookup(key);
+	const auto index = tray ? IndexOf(*tray, id) : -1;
+	if (index < 0 || name.isEmpty()) {
+		return;
+	}
+	tray->list.files[index].displayName = name;
+	tray->items[index].saved.file.name = name;
+	persist(key);
+	notify(key);
+}
+
+void DockedStore::replace(
+		DockedKey key,
+		uint64 id,
+		Ui::PreparedList &&list) {
+	const auto tray = lookup(key);
+	const auto index = tray ? IndexOf(*tray, id) : -1;
+	if (index < 0) {
+		return;
+	}
+	auto file = std::optional<Ui::PreparedFile>();
+	if (!list.files.empty()) {
+		file.emplace(std::move(list.files.front()));
+	} else if (!list.filesToProcess.empty()) {
+		file.emplace(std::move(list.filesToProcess.front()));
+	}
+	if (!file) {
+		return;
+	}
+	auto &current = tray->list.files[index];
+	file->caption = current.caption;
+	auto previous = std::move(current);
+	current = std::move(*file);
+	auto &item = tray->items[index];
+	const auto wasItem = item;
+	item.stage = current.information ? Stage::Ready : Stage::Pending;
+	if (item.stage == Stage::Ready && !validate(key, *tray, index, false)) {
+		current = std::move(previous);
+		item = wasItem;
+		return;
+	}
+	item.saved = SavedDockedFile();
+	item.coverPath = QString();
+	item.baked = item.stale = item.coverDirty = false;
+	item.importFailed = false;
+	++item.revision;
+	++item.coverRevision;
+	refreshPrepared(key, *tray);
+	importItems(key);
+	persist(key);
+	processNext(key);
+	notify(key);
+}
+
+int DockedStore::captionOverflow(DockedKey key) const {
+	const auto tray = find(key);
+	if (!tray) {
+		return 0;
+	}
+	const auto limit = Data::PremiumLimits(_session).captionLengthCurrent();
+	auto result = 0;
+	for (const auto &file : tray->list.files) {
+		result = std::max(result, int(file.caption.text.size()) - limit);
+	}
+	return result;
+}
